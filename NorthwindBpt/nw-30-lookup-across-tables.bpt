{
  "version": "1.0",
  "metadata": {
    "name": "Lookup Across Tables",
    "description": "Two lookup datasets that each join several tables, with no AS on the table columns",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT OrderID, {bp:DateText(OrderDate)} AS OrderDate, CAST(Freight AS REAL) AS Freight\nFROM Orders\nWHERE OrderID BETWEEN 10248 AND 10255\nORDER BY OrderID",
    "columns": [
      {
        "name": "OrderID",
        "dbType": "int64"
      },
      {
        "name": "OrderDate",
        "dbType": "string"
      },
      {
        "name": "Freight",
        "dbType": "double"
      }
    ]
  },
  "lookupDataSources": [
    {
      "name": "OrderParties",
      "dataSourceType": "dbsql",
      "sql": "SELECT o.OrderID, c.CompanyName, c.City, c.Country, e.FirstName, e.LastName,\n       s.CompanyName AS ShipperName\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN Shippers  s ON s.ShipperID  = o.ShipVia\nWHERE o.OrderID BETWEEN 10248 AND 10255",
      "columns": [
        {
          "name": "OrderID",
          "dbType": "int64"
        },
        {
          "name": "CompanyName",
          "dbType": "string"
        },
        {
          "name": "City",
          "dbType": "string"
        },
        {
          "name": "Country",
          "dbType": "string"
        },
        {
          "name": "FirstName",
          "dbType": "string"
        },
        {
          "name": "LastName",
          "dbType": "string"
        },
        {
          "name": "ShipperName",
          "dbType": "string"
        }
      ]
    },
    {
      "name": "OrderLines",
      "dataSourceType": "dbsql",
      "sql": "SELECT od.OrderID, p.ProductName, c.CategoryName, od.Quantity,\n       CAST(od.UnitPrice * od.Quantity * (1 - od.Discount) AS REAL) AS LineTotal\nFROM {bp:Name(Order Details)} od\nJOIN Products   p ON p.ProductID  = od.ProductID\nJOIN Categories c ON c.CategoryID = p.CategoryID\nWHERE od.OrderID BETWEEN 10248 AND 10255\nORDER BY od.OrderID, p.ProductName",
      "columns": [
        {
          "name": "OrderID",
          "dbType": "int64"
        },
        {
          "name": "ProductName",
          "dbType": "string"
        },
        {
          "name": "CategoryName",
          "dbType": "string"
        },
        {
          "name": "Quantity",
          "dbType": "int64"
        },
        {
          "name": "LineTotal",
          "dbType": "double"
        }
      ]
    }
  ],
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Lookup Across Tables"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "italic": true,
            "foreColor": "#505050",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Customer, salesperson, shipper and lines come from two lookup queries that join four and three tables."
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": []
    },
    {
      "type": "detail",
      "height": 3.75,
      "autoHeight": true,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "OrderNo",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 2.4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "OrderID"
        },
        {
          "name": "Customer",
          "type": "computed",
          "bounds": {
            "x": 2.4,
            "y": 0.3,
            "w": 9.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Lookup(\"OrderParties\", OrderID, \"OrderID\", \"CompanyName\")"
        },
        {
          "name": "ODate",
          "type": "field",
          "bounds": {
            "x": 14,
            "y": 0.3,
            "w": 4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "OrderDate"
        },
        {
          "name": "Place",
          "type": "computed",
          "bounds": {
            "x": 2.4,
            "y": 1,
            "w": 9.6,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Lookup(\"OrderParties\", OrderID, \"OrderID\", \"City\") + \", \" + Lookup(\"OrderParties\", OrderID, \"OrderID\", \"Country\")"
        },
        {
          "name": "SalesRep",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 1,
            "w": 6,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Sales: \" + Lookup(\"OrderParties\", OrderID, \"OrderID\", \"FirstName\") + \" \" + Lookup(\"OrderParties\", OrderID, \"OrderID\", \"LastName\")"
        },
        {
          "name": "Shipper",
          "type": "computed",
          "bounds": {
            "x": 2.4,
            "y": 1.5,
            "w": 7.6,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Ship via: \" + Lookup(\"OrderParties\", OrderID, \"OrderID\", \"ShipperName\")"
        },
        {
          "name": "HdrProduct",
          "type": "label",
          "bounds": {
            "x": 0.6,
            "y": 2.15,
            "w": 7.4,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 8,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Product"
        },
        {
          "name": "HdrCategory",
          "type": "label",
          "bounds": {
            "x": 8,
            "y": 2.15,
            "w": 4,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 8,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Category"
        },
        {
          "name": "HdrQty",
          "type": "label",
          "bounds": {
            "x": 12,
            "y": 2.15,
            "w": 2,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 8,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Qty"
        },
        {
          "name": "HdrAmount",
          "type": "label",
          "bounds": {
            "x": 14,
            "y": 2.15,
            "w": 4,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 8,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Amount"
        },
        {
          "name": "Lines",
          "type": "subBand",
          "bounds": {
            "x": 0,
            "y": 2.65,
            "w": 18,
            "h": 1
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "autoHeight": true,
          "subBand": {
            "dataset": "OrderLines",
            "linkKey": "OrderID",
            "linkColumn": "OrderID",
            "rowHeight": 0.5,
            "autoRowHeight": false,
            "rowSeparator": true,
            "elements": [
              {
                "name": "L_Product",
                "type": "computed",
                "bounds": {
                  "x": 0.6,
                  "y": 0,
                  "w": 7.4,
                  "h": 0.5
                },
                "style": {
                  "fontFamily": "Tahoma",
                  "fontSize": 9,
                  "foreColor": "#000000",
                  "backColor": "Transparent",
                  "hAlign": "left",
                  "vAlign": "top",
                  "paddingLeft": 0.1,
                  "paddingRight": 0.05
                },
                "expression": "ProductName"
              },
              {
                "name": "L_Category",
                "type": "computed",
                "bounds": {
                  "x": 8,
                  "y": 0,
                  "w": 4,
                  "h": 0.5
                },
                "style": {
                  "fontFamily": "Tahoma",
                  "fontSize": 9,
                  "foreColor": "#000000",
                  "backColor": "Transparent",
                  "hAlign": "left",
                  "vAlign": "top",
                  "paddingLeft": 0.1,
                  "paddingRight": 0.05
                },
                "expression": "CategoryName"
              },
              {
                "name": "L_Qty",
                "type": "computed",
                "bounds": {
                  "x": 12,
                  "y": 0,
                  "w": 2,
                  "h": 0.5
                },
                "style": {
                  "fontFamily": "Tahoma",
                  "fontSize": 9,
                  "foreColor": "#000000",
                  "backColor": "Transparent",
                  "hAlign": "right",
                  "vAlign": "top",
                  "paddingLeft": 0.1,
                  "paddingRight": 0.05
                },
                "expression": "Quantity",
                "format": "#,##0"
              },
              {
                "name": "L_Amount",
                "type": "computed",
                "bounds": {
                  "x": 14,
                  "y": 0,
                  "w": 4,
                  "h": 0.5
                },
                "style": {
                  "fontFamily": "Tahoma",
                  "fontSize": 9,
                  "foreColor": "#000000",
                  "backColor": "Transparent",
                  "hAlign": "right",
                  "vAlign": "top",
                  "paddingLeft": 0.1,
                  "paddingRight": 0.05
                },
                "expression": "LineTotal",
                "format": "#,##0.00"
              }
            ]
          }
        },
        {
          "name": "TotalLabel",
          "type": "label",
          "bounds": {
            "x": 10,
            "y": 1.5,
            "w": 4,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Order total"
        },
        {
          "name": "OrderTotal",
          "type": "computed",
          "bounds": {
            "x": 14,
            "y": 1.5,
            "w": 4,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Sum(LookupSet(\"OrderLines\", OrderID, \"OrderID\", \"LineTotal\"))",
          "format": "#,##0.00"
        },
        {
          "name": "Sep",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 18,
            "h": 0.02
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "x1": 0,
          "y1": 0.1,
          "x2": 18,
          "y2": 0.1,
          "penWidth": 1,
          "penColor": "#B0B0B0",
          "penStyle": "solid"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "OrderCount",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(OrderID for all) + \" orders\""
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
