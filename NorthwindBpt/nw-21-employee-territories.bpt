{
  "version": "1.0",
  "metadata": {
    "name": "Employee Territories",
    "description": "Sales staff by region, each with the territories they cover",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT e.EmployeeID,\n       {bp:Concat(e.LastName, ', ', e.FirstName)} AS EmployeeName,\n       e.Title, e.City, e.Country,\n       (SELECT MIN(TRIM(r.RegionDescription))\n          FROM EmployeeTerritories et\n          JOIN Territories t ON t.TerritoryID = et.TerritoryID\n          JOIN Region r ON r.RegionID = t.RegionID\n         WHERE et.EmployeeID = e.EmployeeID) AS RegionName,\n       COUNT(DISTINCT o.OrderID) AS OrderCount,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS Sales\nFROM Employees e\nJOIN Orders o ON o.EmployeeID = e.EmployeeID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nGROUP BY e.EmployeeID, e.LastName, e.FirstName, e.Title, e.City, e.Country\nORDER BY RegionName, EmployeeName",
    "columns": [
      {
        "name": "EmployeeID",
        "dbType": "int64"
      },
      {
        "name": "EmployeeName",
        "dbType": "string"
      },
      {
        "name": "Title",
        "dbType": "string"
      },
      {
        "name": "City",
        "dbType": "string"
      },
      {
        "name": "Country",
        "dbType": "string"
      },
      {
        "name": "RegionName",
        "dbType": "string"
      },
      {
        "name": "OrderCount",
        "dbType": "int64"
      },
      {
        "name": "Sales",
        "dbType": "double"
      }
    ]
  },
  "lookupDataSources": [
    {
      "name": "Territories",
      "dataSourceType": "dbsql",
      "sql": "SELECT et.EmployeeID, TRIM(t.TerritoryDescription) AS TerritoryName\nFROM EmployeeTerritories et\nJOIN Territories t ON t.TerritoryID = et.TerritoryID\nORDER BY et.EmployeeID, TerritoryName",
      "columns": [
        {
          "name": "EmployeeID",
          "dbType": "int64"
        },
        {
          "name": "TerritoryName",
          "dbType": "string"
        }
      ]
    }
  ],
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Employee Territories"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.95,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Each salesperson with the territories they cover, grouped by region"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Salesperson"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 6.7,
            "y": 0,
            "w": 4.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Based in"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 11.4,
            "y": 0,
            "w": 2.4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Orders"
        },
        {
          "name": "H4",
          "type": "label",
          "bounds": {
            "x": 14,
            "y": 0,
            "w": 4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Sales"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "RegionName"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "RegionHead",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.15,
            "w": 12,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 13,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "RegionName + \" region\""
        }
      ]
    },
    {
      "type": "detail",
      "height": 1.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Employee",
          "type": "field",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "EmployeeName"
        },
        {
          "name": "BasedIn",
          "type": "computed",
          "bounds": {
            "x": 6.7,
            "y": 0,
            "w": 4.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "TextJoin(\", \", City, Country)"
        },
        {
          "name": "Orders",
          "type": "field",
          "bounds": {
            "x": 11.4,
            "y": 0,
            "w": 2.4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "OrderCount",
          "format": "#,##0"
        },
        {
          "name": "SalesValue",
          "type": "field",
          "bounds": {
            "x": 14,
            "y": 0,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "Sales",
          "format": "#,##0.00"
        },
        {
          "name": "TerritoryList",
          "type": "computed",
          "bounds": {
            "x": 0.9,
            "y": 0.6,
            "w": 17.1,
            "h": 1.2
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "wrapText": true,
          "expression": "Join(LookupSet(\"Territories\", EmployeeID, \"EmployeeID\", \"TerritoryName\"), \", \")"
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "RegionLabel",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.1,
            "w": 10.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Total for \" + RegionName + \" (\" + Count(EmployeeID for group 1) + \" people)\""
        },
        {
          "name": "RegionOrders",
          "type": "computed",
          "bounds": {
            "x": 11.4,
            "y": 0.1,
            "w": 2.4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(OrderCount for group 1)",
          "format": "#,##0"
        },
        {
          "name": "RegionSales",
          "type": "computed",
          "bounds": {
            "x": 14,
            "y": 0.1,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(Sales for group 1)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 2.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandLabel",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0.2,
            "w": 10.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "All regions"
        },
        {
          "name": "GrandSales",
          "type": "computed",
          "bounds": {
            "x": 14,
            "y": 0.2,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(Sales for all)",
          "format": "#,##0.00"
        },
        {
          "name": "Note",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0.9,
            "w": 17.5,
            "h": 1.2
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "wrapText": true,
          "text": "The territory list comes from a second query, read per row - joining it into the main query would have multiplied every sales figure."
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
