{
  "version": "1.0",
  "metadata": {
    "name": "Shipping Performance",
    "description": "Orders that missed their required date, or have not shipped at all, per shipper",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT sh.CompanyName AS ShipperName,\n       o.OrderID,\n       c.CompanyName AS CustomerName,\n       {bp:DateText(o.RequiredDate)} AS RequiredDate,\n       {bp:DateText(o.ShippedDate)} AS ShippedDate,\n       {bp:DiffDays(o.RequiredDate, o.ShippedDate)} AS DaysLate\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Shippers sh ON sh.ShipperID = o.ShipVia\nWHERE o.ShippedDate IS NULL\n   OR o.ShippedDate > o.RequiredDate\nORDER BY ShipperName, o.OrderID",
    "columns": [
      {
        "name": "ShipperName",
        "dbType": "string"
      },
      {
        "name": "OrderID",
        "dbType": "int64"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "RequiredDate",
        "dbType": "string"
      },
      {
        "name": "ShippedDate",
        "dbType": "string"
      },
      {
        "name": "DaysLate",
        "dbType": "int64"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Shipping Performance"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.95,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Orders shipped after the date they were required, and orders still waiting to ship"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 2.2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Order"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 2.7,
            "y": 0,
            "w": 6.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Customer"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 9.2,
            "y": 0,
            "w": 2.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Required"
        },
        {
          "name": "H4",
          "type": "label",
          "bounds": {
            "x": 11.8,
            "y": 0,
            "w": 2.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Shipped"
        },
        {
          "name": "H5",
          "type": "label",
          "bounds": {
            "x": 14.4,
            "y": 0,
            "w": 3.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Days late"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "ShipperName"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "ShipperHead",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.15,
            "w": 10,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 13,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "ShipperName"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "OrderNo",
          "type": "field",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 2.2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "OrderID"
        },
        {
          "name": "Customer",
          "type": "field",
          "bounds": {
            "x": 2.7,
            "y": 0,
            "w": 6.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "CustomerName"
        },
        {
          "name": "Required",
          "type": "field",
          "bounds": {
            "x": 9.2,
            "y": 0,
            "w": 2.6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "RequiredDate"
        },
        {
          "name": "Shipped",
          "type": "computed",
          "bounds": {
            "x": 11.8,
            "y": 0,
            "w": 2.6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "foreColorExpression": "Iif(IsNull(ShippedDate), \"#B00000\", \"#000000\")",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "Coalesce(ShippedDate, \"not shipped\")"
        },
        {
          "name": "DaysLate",
          "type": "computed",
          "bounds": {
            "x": 14.4,
            "y": 0,
            "w": 3.6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "foreColorExpression": "Iif(DaysLate > 7, \"#B00000\", \"#000000\")",
            "backColorExpression": "Iif(DaysLate > 7, \"#FFE0E0\", \"Transparent\")",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "DaysLate",
          "format": "#,##0"
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "ShipperLabel",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.1,
            "w": 8.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "ShipperName + \" - \" + Count(OrderID for group 1) + \" orders\""
        },
        {
          "name": "AvgDays",
          "type": "computed",
          "bounds": {
            "x": 14.4,
            "y": 0.1,
            "w": 3.6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Avg(DaysLate for group 1)",
          "format": "#,##0.0"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandLabel",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.2,
            "w": 13.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(OrderID for all) + \" orders on this report\""
        },
        {
          "name": "Note",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0.9,
            "w": 17.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "wrapText": true,
          "text": "Rows with no shipped date have no day count either - a missing value stays missing rather than counting as zero."
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
