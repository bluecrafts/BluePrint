            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "RelativeTime(Time(\"17:30:00\"), 3600)",
          "format": "HH:mm:ss"
        },
        {
          "name": "WorkSecs",
          "type": "computed",
