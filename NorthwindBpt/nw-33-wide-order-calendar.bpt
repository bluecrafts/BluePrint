{
  "version": "1.0",
  "metadata": {
    "name": "Order Calendar",
    "description": "Orders from December 1997 to February 1998 with every date and time function, three sheets wide",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID AS OrderNo,\n       c.CompanyName AS CustomerName,\n       {bp:Year(o.OrderDate)} AS OrderYear,\n       {bp:Month(o.OrderDate)} AS OrderMonth,\n       {bp:Day(o.OrderDate)} AS OrderDay,\n       CASE WHEN {bp:Month(o.OrderDate)} <= 3 THEN 1\n            WHEN {bp:Month(o.OrderDate)} <= 6 THEN 2\n            WHEN {bp:Month(o.OrderDate)} <= 9 THEN 3\n            ELSE 4 END AS OrderQuarter,\n       {bp:Year(o.RequiredDate)} AS RequiredYear,\n       {bp:Month(o.RequiredDate)} AS RequiredMonth,\n       {bp:Day(o.RequiredDate)} AS RequiredDay,\n       {bp:Year(o.ShippedDate)} AS ShippedYear,\n       {bp:Month(o.ShippedDate)} AS ShippedMonth,\n       {bp:Day(o.ShippedDate)} AS ShippedDay,\n       {bp:DiffDays(o.OrderDate, o.ShippedDate)} AS SqlLeadDays,\n       CAST(o.Freight AS REAL) AS FreightAmount\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID",
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "OrderYear",
        "dbType": "int64"
      },
      {
        "name": "OrderMonth",
        "dbType": "int64"
      },
      {
        "name": "OrderDay",
        "dbType": "int64"
      },
      {
        "name": "OrderQuarter",
        "dbType": "int64"
      },
      {
        "name": "RequiredYear",
        "dbType": "int64"
      },
      {
        "name": "RequiredMonth",
        "dbType": "int64"
      },
      {
        "name": "RequiredDay",
        "dbType": "int64"
      },
      {
        "name": "ShippedYear",
        "dbType": "int64"
      },
      {
        "name": "ShippedMonth",
        "dbType": "int64"
      },
      {
        "name": "ShippedDay",
        "dbType": "int64"
      },
      {
        "name": "SqlLeadDays",
        "dbType": "int64"
      },
      {
        "name": "FreightAmount",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [
    {
      "rules": [
        {
          "field": "OrderYear",
          "direction": "asc"
        },
        {
          "field": "OrderQuarter",
          "direction": "asc"
        },
        {
          "field": "OrderMonth",
          "direction": "asc"
        },
        {
          "field": "OrderDay",
          "direction": "asc"
        },
        {
          "field": "OrderNo",
          "direction": "asc"
        }
      ]
    }
  ],
  "culture": "en-US",
  "filters": "(OrderYear = 1997 && OrderMonth = 12) || (OrderYear = 1998 && OrderMonth <= 2)",
  "sections": [
    {
