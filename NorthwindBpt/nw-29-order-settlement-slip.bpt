        {
          "name": "Note",
          "type": "label",
          "bounds": {
            "x": 0.3,
            "y": 1.1,
            "w": 17.7,
            "h": 1.2
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "wrapText": true,
          "text": "Order 10248 has nothing on the right because none of its lines were discounted. Where one side is shorter, as on order 10250, the band still prints as many rows as the longer side needs and leaves the rest of the short side blank. Neither column knows how long the other one is."
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": [
    {
      "slotNo": 1,
      "expression": "Kind = \"C\""
    },
    {
      "slotNo": 2,
      "expression": "Kind = \"D\""
    }
  ]
}
