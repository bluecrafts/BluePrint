                "width": 1
              },
              "bottom": {
                "style": "double",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(Amount for group 1)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 2.6,
      "repeatOnNewPage": false,
      "backColor": "Transparent",
      "elements": [
