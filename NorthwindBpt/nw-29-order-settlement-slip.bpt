{
  "version": "1.0",
  "metadata": {
    "name": "Order Settlement Slip",
    "description": "One slip per order: goods charged on the left, discounts given on the right",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT * FROM (\nSELECT o.OrderID AS OrderID,\n       c.CompanyName AS CustomerName,\n       {bp:DateText(o.OrderDate)} AS OrderDate,\n       'C' AS Kind,\n       p.ProductName AS ProductName,\n       od.Quantity AS Quantity,\n       CAST(od.UnitPrice * od.Quantity AS REAL) AS Amount\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nWHERE o.OrderID BETWEEN 10248 AND 10254\nUNION ALL\nSELECT o.OrderID,\n       c.CompanyName,\n       {bp:DateText(o.OrderDate)},\n       'D',\n       p.ProductName,\n       od.Quantity,\n       CAST(-1 * od.UnitPrice * od.Quantity * od.Discount AS REAL)\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nWHERE o.OrderID BETWEEN 10248 AND 10254\n  AND od.Discount > 0\n) slip\nORDER BY OrderID, Kind, ProductName",
    "columns": [
      {
        "name": "OrderID",
        "dbType": "int64"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "OrderDate",
        "dbType": "string"
      },
      {
        "name": "Kind",
        "dbType": "string"
      },
      {
        "name": "ProductName",
        "dbType": "string"
      },
      {
        "name": "Quantity",
        "dbType": "int64"
      },
      {
        "name": "Amount",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.4,
      "repeatOnNewPage": false,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Order Settlement Slips"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.95,
            "w": 18,
            "h": 1.3
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "wrapText": true,
          "text": "Two lists of the same order, printed side by side: every line at its full price on the left, the discounts given on the right. Both columns come from one query - the report splits its rows into slots. Freight is not part of this slip."
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": []
    },
    {
