          "type": "computed",
          "bounds": {
            "x": 24.2,
            "y": 0.05,
            "w": 2,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Sum([Gross] for group 2)",
          "format": "#,##0.00"
        },
        {
          "name": "F2Share",
          "type": "computed",
          "bounds": {
            "x": 32.8,
            "y": 0.05,
            "w": 1.6,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Sum([Gross] for group 2) / Sum([Gross] for group 1) * 100",
          "format": "0.00"
        },
        {
          "name": "F2MinMax",
          "type": "computed",
          "bounds": {
            "x": 36,
            "y": 0.05,
            "w": 18,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
