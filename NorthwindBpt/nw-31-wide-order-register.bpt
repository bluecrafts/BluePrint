            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "CumulativePercent([Gross] for all)",
          "format": "0.0"
        },
        {
          "name": "ReportRun",
          "type": "computed",
          "bounds": {
            "x": 39.2,
            "y": 0,
            "w": 2.4,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "CumulativeSum([Gross] for all)",
          "format": "#,##0.00"
        },
        {
          "name": "Marker",
          "type": "computed",
          "bounds": {
            "x": 41.8,
            "y": 0,
            "w": 3.6,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "If(CumulativeSum(1 for group 1) = 1, \"first in country\", If(Row() = Last(Row() for group 1), \"last in country\", \"\"))"
        },
        {
          "name": "Extreme",
          "type": "computed",
          "bounds": {
            "x": 45.4,
            "y": 0,
            "w": 3,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "If([Gross] = Max([Gross] for group 1), \"largest in country\", If([Gross] = Min([Gross] for group 1), \"smallest in country\", \"\"))"
        },
        {
          "name": "RowOfCount",
          "type": "computed",
          "bounds": {
            "x": 48.4,
            "y": 0,
            "w": 2.6,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
