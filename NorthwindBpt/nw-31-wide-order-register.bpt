        },
        {
          "name": "F2Freight",
          "type": "computed",
          "bounds": {
            "x": 22.6,
            "y": 0.05,
            "w": 1.6,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
