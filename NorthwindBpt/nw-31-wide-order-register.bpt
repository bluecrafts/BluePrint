            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Switch([GrossBand] <= 1000, \"S\", [GrossBand] <= 5000, \"M\", \"L\")"
        },
        {
          "name": "CountryRun",
          "type": "computed",
