            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "[OrderAmount] + [Vat] + [FreightAmount]",
          "format": "#,##0.00"
        },
        {
          "name": "GrossBand",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 0.1,
            "h": 0.1
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
