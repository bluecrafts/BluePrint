            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "visible": false,
          "expression": "Ceiling([Gross] / 500) * 500"
        },
        {
          "name": "Weight",
          "type": "computed",
          "bounds": {
            "x": 26.2,
            "y": 0,
            "w": 0.8,
