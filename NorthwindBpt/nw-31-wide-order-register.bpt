{
  "version": "1.0",
  "metadata": {
    "name": "Wide Order Register",
    "description": "Orders of January to April 1997 by country and shipper, printed three sheets wide",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID AS OrderNo,\n       c.CompanyName AS CustomerName,\n       c.Country AS CustomerCountry,\n       {bp:Concat(e.FirstName, ' ', e.LastName)} AS EmployeeName,\n       s.CompanyName AS ShipperName,\n       {bp:Year(o.OrderDate)} AS OrderYear,\n       {bp:Month(o.OrderDate)} AS OrderMonth,\n       {bp:DateText(o.OrderDate)} AS OrderDateText,\n       ROUND(o.Freight * 100, 0) AS FreightCents,\n       t.AmountUnits AS AmountUnits,\n       t.LineCount AS LineCount\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN Shippers s ON s.ShipperID = o.ShipVia\nJOIN (SELECT od.OrderID AS OrderKey,\n             SUM(ROUND(od.UnitPrice * 100, 0) * od.Quantity * (100 - ROUND(od.Discount * 100, 0))) AS AmountUnits,\n             COUNT(*) AS LineCount\n      FROM {bp:Name(Order Details)} od\n      GROUP BY od.OrderID) t ON t.OrderKey = o.OrderID",
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "CustomerCountry",
        "dbType": "string"
      },
      {
        "name": "EmployeeName",
        "dbType": "string"
      },
      {
        "name": "ShipperName",
        "dbType": "string"
      },
      {
        "name": "OrderYear",
        "dbType": "int64"
      },
      {
        "name": "OrderMonth",
        "dbType": "int64"
      },
      {
        "name": "OrderDateText",
        "dbType": "string"
      },
      {
        "name": "FreightCents",
        "dbType": "int64"
      },
      {
        "name": "AmountUnits",
        "dbType": "int64"
      },
      {
        "name": "LineCount",
        "dbType": "int64"
      }
    ]
  },
  "sortColumns": [
    {
      "rules": [
        {
          "field": "CustomerCountry",
          "direction": "asc"
        },
        {
          "field": "ShipperName",
          "direction": "desc"
        },
        {
          "field": "OrderNo",
          "direction": "asc"
        }
      ]
    }
  ],
  "filters": "OrderYear = 1997 && OrderMonth <= 4",
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
