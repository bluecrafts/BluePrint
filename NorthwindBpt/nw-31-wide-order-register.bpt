            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "CumulativeSum([Gross] for page)",
          "format": "#,##0.00"
        },
        {
          "name": "CountryShare",
