            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Long(FreightCents) / 100",
          "format": "#,##0.00"
        },
        {
          "name": "Gross",
          "type": "computed",
          "bounds": {
            "x": 24.2,
            "y": 0,
            "w": 2,
