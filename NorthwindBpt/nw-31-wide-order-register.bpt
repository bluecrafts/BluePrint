            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "RunningTotal([Gross] for group 1)",
          "format": "#,##0.00"
        },
        {
          "name": "ShipperSeq",
