                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(Long(FreightCents) for group 1) / 100",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandCount",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 12.2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(OrderID for all) + \" orders to \" + Count(ShipCountry for all distinct) + \" countries\""
        },
        {
          "name": "GrandFreight",
          "type": "computed",
          "bounds": {
            "x": 14.4,
            "y": 0.3,
            "w": 3.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(Long(FreightCents) for all) / 100",
          "format": "#,##0.00"
        }
      ]
    },
