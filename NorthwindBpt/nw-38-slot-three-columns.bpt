{
  "version": "1.0",
  "metadata": {
    "name": "Orders in Three Columns",
    "description": "Slot Data with three slots: the orders of each country read left to right, three to a line, over several pages. RowOfGroup(1) restarts in every country",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID, {bp:DateText(o.OrderDate)} AS OrderDay, o.ShipCountry,\n       ROUND(o.Freight * 100, 0) AS FreightCents\nFROM Orders o\nORDER BY o.ShipCountry, o.OrderID",
    "columns": [
      {
        "name": "OrderID",
        "dbType": "int64"
      },
      {
        "name": "OrderDay",
        "dbType": "string"
      },
      {
        "name": "ShipCountry",
        "dbType": "string"
      },
      {
        "name": "FreightCents",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AccentBar",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.12
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 2,
            "foreColor": "#1F5FAD",
            "backColor": "#1F5FAD",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": ""
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Orders in Three Columns"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1.25,
            "w": 18,
            "h": 1.3
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "All 830 orders, grouped by the country they shipped to and read left to right, three to a line. Slot 1 is Mod(RowOfGroup(1), 3) = 1, slot 2 is = 2, slot 3 is = 0 - the count starts again in every country.",
          "wrapText": true
        }
      ]
    },
