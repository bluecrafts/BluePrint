            "paddingRight": 0.05
          },
          "text": "Sheet 2 of 3: page numbers used in arithmetic, comparisons and functions."
        },
        {
          "name": "T3",
          "type": "computed",
          "bounds": {
            "x": 36,
            "y": 0.3,
            "w": 18,
