{
  "version": "1.0",
  "metadata": {
    "name": "Page and System Functions",
    "description": "Every page and system function, alone and inside calculations: two employees each starting a new page, four rows of pages, three sheets wide",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID AS OrderNo,\n       o.EmployeeID AS EmpNo,\n       e.LastName AS EmpLast,\n       {bp:DateText(o.OrderDate)} AS OrderedOn,\n       o.ShipCountry AS ShipTo,\n       CAST(o.Freight AS REAL) AS FreightCost\nFROM Orders o\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nWHERE o.EmployeeID IN (6, 7)\nORDER BY o.EmployeeID, o.OrderID",
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "EmpNo",
        "dbType": "int64"
      },
      {
        "name": "EmpLast",
        "dbType": "string"
      },
      {
        "name": "OrderedOn",
        "dbType": "string"
      },
      {
        "name": "ShipTo",
        "dbType": "string"
      },
      {
        "name": "FreightCost",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [
    {
      "rules": [
        {
          "field": "EmpNo",
          "direction": "asc"
        },
        {
          "field": "OrderNo",
          "direction": "asc"
        }
      ]
    }
  ],
  "culture": "en-US",
  "sections": [
    {
