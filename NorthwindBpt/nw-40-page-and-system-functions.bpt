    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "EmpNo"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.7,
      "newPageBefore": true,
      "repeatOnNewPage": true,
      "backColor": "#DCE6F0",
      "elements": [
        {
          "name": "G1",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 18,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "\"Employee \" + EmpNo + \" - \" + EmpLast"
        },
        {
          "name": "G2",
          "type": "computed",
          "bounds": {
            "x": 18,
            "y": 0.1,
            "w": 18,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "\"Employee \" + EmpNo + \" - page \" + Page() + \" of \" + GroupTotalPages()"
        },
        {
          "name": "G3",
          "type": "computed",
          "bounds": {
            "x": 36,
            "y": 0.1,
            "w": 18,
            "h": 0.5
          },
