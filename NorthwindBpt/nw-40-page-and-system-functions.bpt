            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "If(Mod(Row(), 2) = 0, \"even\", \"odd\")"
        },
        {
          "name": "D1h",
          "type": "computed",
          "bounds": {
            "x": 13,
