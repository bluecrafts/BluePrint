            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "\"GroupNumber() = \" + GroupNumber() + \"  |  sheet \" + VPage() + \"-\" + HPage()"
        }
      ]
    },
