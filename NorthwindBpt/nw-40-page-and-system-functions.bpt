            "paddingRight": 0.05
          },
          "text": "Every page and system function, alone and in calculations. Each employee starts on a new page."
        },
        {
          "name": "T2",
          "type": "computed",
          "bounds": {
            "x": 18,
            "y": 0.3,
            "w": 18,
            "h": 0.8
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 12.5,
            "bold": true,
