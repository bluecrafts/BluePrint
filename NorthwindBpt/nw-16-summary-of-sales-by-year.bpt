        },
        {
          "name": "Orders",
          "type": "field",
          "bounds": {
            "x": 4.2,
            "y": 0,
            "w": 2.3,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "OrderCount",
          "format": "#,##0"
        },
        {
          "name": "QuarterSales",
          "type": "field",
          "bounds": {
            "x": 6.8,
            "y": 0,
            "w": 3.6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "Sales",
          "format": "#,##0.00"
        },
        {
          "name": "Cumulative",
          "type": "computed",
          "bounds": {
            "x": 10.6,
            "y": 0,
            "w": 3.8,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "RunningTotal(Sales for all)",
          "format": "#,##0.00"
        },
        {
          "name": "Share",
          "type": "computed",
          "bounds": {
            "x": 14.6,
            "y": 0,
            "w": 3.4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "Sales / Sum(Sales for all) * 100",
          "format": "#,##0.0\"%\""
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "YearLabel",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.1,
            "w": 3.6,
            "h": 0.6
