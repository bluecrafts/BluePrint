          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Total for \" + SalesYear"
        },
        {
          "name": "YearOrders",
          "type": "computed",
          "bounds": {
            "x": 4.2,
            "y": 0.1,
            "w": 2.3,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(OrderCount for group 1)",
          "format": "#,##0"
        },
        {
          "name": "YearSales",
          "type": "computed",
          "bounds": {
            "x": 6.8,
            "y": 0.1,
            "w": 3.6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(Sales for group 1)",
          "format": "#,##0.00"
        },
        {
          "name": "YearShare",
          "type": "computed",
          "bounds": {
            "x": 14.6,
            "y": 0.1,
            "w": 3.4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(Sales for group 1) / Sum(Sales for all) * 100",
          "format": "#,##0.0\"%\""
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
