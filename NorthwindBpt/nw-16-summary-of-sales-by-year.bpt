{
  "version": "1.0",
  "metadata": {
    "name": "Summary of Sales by Year",
    "description": "Sales per quarter within each year, with a running total and a share of the whole",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT {bp:ToText(Year(o.ShippedDate), 4)} AS SalesYear,\n       CASE WHEN {bp:Month(o.ShippedDate)} <= 3 THEN 'Q1'\n            WHEN {bp:Month(o.ShippedDate)} <= 6 THEN 'Q2'\n            WHEN {bp:Month(o.ShippedDate)} <= 9 THEN 'Q3'\n            ELSE 'Q4' END AS Quarter,\n       COUNT(DISTINCT o.OrderID) AS OrderCount,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS Sales\nFROM Orders o\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nWHERE o.ShippedDate IS NOT NULL\nGROUP BY {bp:ToText(Year(o.ShippedDate), 4)},\n         CASE WHEN {bp:Month(o.ShippedDate)} <= 3 THEN 'Q1'\n              WHEN {bp:Month(o.ShippedDate)} <= 6 THEN 'Q2'\n              WHEN {bp:Month(o.ShippedDate)} <= 9 THEN 'Q3'\n              ELSE 'Q4' END\nORDER BY SalesYear, Quarter",
    "columns": [
      {
        "name": "SalesYear",
        "dbType": "string"
      },
      {
        "name": "Quarter",
        "dbType": "string"
      },
      {
        "name": "OrderCount",
        "dbType": "int64"
      },
      {
        "name": "Sales",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Summary of Sales by Year"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.95,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Shipped orders only - the running total carries on across years"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
