{
  "version": "1.0",
  "metadata": {
    "name": "Sales and Orders by Category",
    "description": "A crosstab with two measures in every cell - sales and the number of orders",
    "author": "BluePrint"
  },
  "report": {
    "type": "crosstab",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "landscape",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    },
    "crosstabDefinition": {
      "rows": [
        {
          "field": "CategoryName",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "columns": [
        {
          "field": "OrderYear",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "values": [
        {
          "source": "Sales",
          "aggregate": "sum",
          "format": "#,##0",
          "label": "Sales"
        },
        {
          "source": "OrderCount",
          "aggregate": "sum",
          "format": "#,##0",
          "label": "Orders"
        }
      ],
      "totals": {
        "rowGrand": true,
        "colGrand": true,
        "grand": true
      },
      "emptyCell": "-",
      "columnGuard": {
        "maxColumns": 256,
        "maxPages": 10,
        "onExceed": "warn"
      }
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.CategoryName,\n       {bp:ToText(Year(o.OrderDate), 4)} AS OrderYear,\n       COUNT(DISTINCT o.OrderID) AS OrderCount,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS Sales\nFROM Orders o\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nJOIN Categories c ON c.CategoryID = p.CategoryID\nGROUP BY c.CategoryName, {bp:ToText(Year(o.OrderDate), 4)}\nORDER BY c.CategoryName, OrderYear",
    "columns": [
      {
        "name": "CategoryName",
        "dbType": "string"
      },
      {
        "name": "OrderYear",
        "dbType": "string"
      },
      {
        "name": "OrderCount",
        "dbType": "int64"
      },
      {
        "name": "Sales",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 25,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": "Sales and Orders by Category"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.9,
            "w": 25,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": "Every cell holds two numbers. An order that contains several categories is counted in each of them, so the order counts add up to more than the 830 orders in the data."
        }
      ]
