{
  "version": "1.0",
  "metadata": {
    "name": "Units by Category and Country",
    "description": "Units shipped per product category and destination country. The country headings are printed at 90 degrees so all 21 countries fit across one landscape page.",
    "author": "BluePrint"
  },
  "report": {
    "type": "crosstab",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "landscape",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    },
    "crosstabDefinition": {
      "rows": [
        {
          "field": "Category",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "columns": [
        {
          "field": "Country",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "values": [
        {
          "source": "Units",
          "aggregate": "sum",
          "format": "#,##0"
        }
      ],
      "totals": {
        "rowGrand": true,
        "colGrand": true,
        "grand": true
      },
      "emptyCell": "-",
      "columnGuard": {
        "maxColumns": 256,
        "maxPages": 10,
        "onExceed": "warn"
      }
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.CategoryName AS Category, o.ShipCountry AS Country, od.Quantity AS Units\nFROM Orders o\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nJOIN Categories c ON c.CategoryID = p.CategoryID\nORDER BY c.CategoryName, o.ShipCountry",
    "columns": [
      {
        "name": "Category",
        "dbType": "string"
      },
      {
        "name": "Country",
        "dbType": "string"
      },
      {
        "name": "Units",
        "dbType": "int64"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
