{
  "version": "1.0",
  "metadata": {
    "name": "Sales by Category",
    "description": "Total sales per product, grouped by category, with a share of each total",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.CategoryName, p.ProductName,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS ProductSales\nFROM Categories c\nJOIN Products p ON p.CategoryID = c.CategoryID\nJOIN {bp:Name(Order Details)} od ON od.ProductID = p.ProductID\nJOIN Orders o ON o.OrderID = od.OrderID\nGROUP BY c.CategoryName, p.ProductName\nORDER BY c.CategoryName, p.ProductName",
    "columns": [
      {
        "name": "Categories_CategoryName",
        "dbType": "string"
      },
      {
        "name": "Products_ProductName",
        "dbType": "string"
      },
      {
        "name": "ProductSales",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AccentBar",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.12
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 2,
            "foreColor": "#1F5FAD",
            "backColor": "#1F5FAD",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": ""
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Sales by Category"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 10.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Product"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 11,
            "y": 0,
            "w": 4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Sales"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 15,
            "y": 0,
            "w": 3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Share"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "Categories_CategoryName"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CatHead",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.15,
            "w": 10,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 12.5,
            "bold": true,
            "foreColor": "#1F5FAD",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "Categories_CategoryName"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.65,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Product",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 10.5,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "Products_ProductName"
        },
        {
          "name": "Sales",
          "type": "field",
          "bounds": {
            "x": 11,
            "y": 0,
            "w": 4,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "ProductSales",
          "format": "#,##0.00"
        },
        {
          "name": "Share",
          "type": "computed",
          "bounds": {
            "x": 15,
            "y": 0,
            "w": 3,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "ProductSales / Sum(ProductSales for group 1) * 100",
          "format": "#,##0.0\"%\""
        }
      ],
      "alternateBackColor": "#F7F9FC"
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CatLabel",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 10.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 10.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Total for \" + Categories_CategoryName"
        },
        {
          "name": "CatTotal",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 0.1,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(ProductSales for group 1)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1,
      "repeatOnNewPage": true,
      "printAtBottom": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandLabel",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 10.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Grand total"
        },
        {
          "name": "GrandTotal",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 0.2,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(ProductSales for all)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
