{
  "version": "1.0",
  "metadata": {
    "name": "Sales by Country",
    "description": "A crosstab of shipping countries down the side and years across the top",
    "author": "BluePrint"
  },
  "report": {
    "type": "crosstab",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    },
    "crosstabDefinition": {
      "rows": [
        {
          "field": "ShipCountry",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "columns": [
        {
          "field": "OrderYear",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "values": [
        {
          "source": "Sales",
          "aggregate": "sum",
          "format": "#,##0"
        }
      ],
      "totals": {
        "rowGrand": true,
        "colGrand": true,
        "grand": true
      },
      "emptyCell": "-",
      "columnGuard": {
        "maxColumns": 256,
        "maxPages": 10,
        "onExceed": "warn"
      }
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.ShipCountry,\n       {bp:ToText(Year(o.OrderDate), 4)} AS OrderYear,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS Sales\nFROM Orders o\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nGROUP BY o.ShipCountry, {bp:ToText(Year(o.OrderDate), 4)}\nORDER BY o.ShipCountry, OrderYear",
    "columns": [
      {
        "name": "ShipCountry",
        "dbType": "string"
      },
      {
        "name": "OrderYear",
        "dbType": "string"
      },
      {
        "name": "Sales",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
