{
  "version": "1.0",
  "metadata": {
    "name": "Customer Address Book",
    "description": "Every customer, in alphabetical sections like a phone book",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT {bp:Substr(c.CompanyName, 1, 1)} AS InitialLetter,\n       c.CompanyName AS CustomerName,\n       c.ContactName, c.ContactTitle,\n       c.Address, c.City, c.PostalCode, c.Country,\n       c.Phone\nFROM Customers c\nORDER BY InitialLetter, CustomerName",
    "columns": [
      {
        "name": "InitialLetter",
        "dbType": "string"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "ContactName",
        "dbType": "string"
      },
      {
        "name": "ContactTitle",
        "dbType": "string"
      },
      {
        "name": "Address",
        "dbType": "string"
      },
      {
        "name": "City",
        "dbType": "string"
      },
      {
        "name": "PostalCode",
        "dbType": "string"
      },
      {
        "name": "Country",
        "dbType": "string"
      },
      {
        "name": "Phone",
        "dbType": "string"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AccentBar",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.12
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 2,
            "foreColor": "#1F5FAD",
            "backColor": "#1F5FAD",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": ""
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Customer Address Book"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1.25,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "A section per first letter, the way a phone book is arranged"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 7.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Customer"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 7.7,
            "y": 0,
            "w": 6.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Where"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 14.4,
            "y": 0,
            "w": 3.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Phone"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "InitialLetter"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "LetterHead",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 15,
            "bold": true,
            "foreColor": "#1F4E79",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "InitialLetter"
        },
        {
          "name": "Rule",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 0.9,
            "w": 18,
            "h": 0.02
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "x1": 0,
          "y1": 0.9,
          "x2": 18,
          "y2": 0.9,
          "penWidth": 0.75,
          "penColor": "#1F4E79",
          "penStyle": "solid"
        }
      ]
    },
    {
      "type": "detail",
      "height": 1.1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Customer",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 7.5,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "CustomerName"
        },
        {
          "name": "Contact",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.55,
            "w": 7.5,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "TextJoin(\", \", ContactName, ContactTitle)"
        },
        {
          "name": "Address",
          "type": "field",
          "bounds": {
            "x": 7.7,
            "y": 0,
            "w": 6.5,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "Address"
        },
        {
          "name": "CityLine",
          "type": "computed",
          "bounds": {
            "x": 7.7,
            "y": 0.55,
            "w": 6.5,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "TextJoin(\" \", City, PostalCode, Country)"
        },
        {
          "name": "Phone",
          "type": "field",
          "bounds": {
            "x": 14.4,
            "y": 0,
            "w": 3.6,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "Phone"
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "LetterCount",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 10.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(CustomerName for group 1) + Iif(Count(CustomerName for group 1) = 1, \" customer under \", \" customers under \") + InitialLetter"
        }
      ]
    },
    {
      "type": "reportFooter",
      "printAtBottom": true,
      "height": 1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandLabel",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(CustomerName for all) + \" customers in the book\""
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
