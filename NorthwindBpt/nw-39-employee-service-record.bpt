{
  "version": "1.0",
  "metadata": {
    "name": "Employee Service Record",
    "description": "Age, years of service and days employed as of the print date - Now(), Today() and PrintDate() shown and used in calculations",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT e.EmployeeID,\n       {bp:Concat(e.FirstName, ' ', e.LastName)} AS EmployeeName,\n       e.Title,\n       {bp:Year(e.BirthDate)} AS BirthYear,\n       {bp:Year(e.HireDate)} AS HireYear,\n       {bp:Month(e.HireDate)} AS HireMonth,\n       {bp:Day(e.HireDate)} AS HireDay\nFROM Employees e\nORDER BY e.HireDate, e.EmployeeID",
    "columns": [
      {
        "name": "EmployeeID",
        "dbType": "int64"
      },
      {
        "name": "EmployeeName",
        "dbType": "string"
      },
      {
        "name": "Title",
        "dbType": "string"
      },
      {
        "name": "BirthYear",
        "dbType": "int64"
      },
      {
        "name": "HireYear",
        "dbType": "int64"
      },
      {
        "name": "HireMonth",
        "dbType": "int64"
      },
      {
        "name": "HireDay",
        "dbType": "int64"
      }
    ]
  },
  "sortColumns": [],
  "culture": "en-US",
  "sections": [
    {
      "type": "reportHeader",
      "height": 2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AccentBar",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.12
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 2,
            "foreColor": "#1F5FAD",
            "backColor": "#1F5FAD",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": ""
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 11,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Employee Service Record"
        },
        {
          "name": "AsOf",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.25,
            "w": 11,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Ages and years of service as of \" + String(Today(), \"d MMMM yyyy\")"
        },
        {
          "name": "Printed",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 0.35,
            "w": 7,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Printed \" + PrintDate()"
        },
        {
          "name": "Generated",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 0.85,
            "w": 7,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Generated \" + String(Now(), \"yyyy-MM-dd HH:mm:ss\")"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H0",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 1,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "#"
        },
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 1,
            "y": 0,
            "w": 4.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Employee"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 5.6,
            "y": 0,
            "w": 4.3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Title"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 9.9,
            "y": 0,
            "w": 2.2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Hired"
        },
        {
          "name": "H4",
          "type": "label",
          "bounds": {
            "x": 12.1,
            "y": 0,
            "w": 1.4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Age"
        },
        {
          "name": "H5",
          "type": "label",
          "bounds": {
            "x": 13.5,
            "y": 0,
            "w": 1.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Years"
        },
        {
          "name": "H6",
          "type": "label",
          "bounds": {
            "x": 15.1,
            "y": 0,
            "w": 2.9,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
          "text": "Days Employed"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "alternateBackColor": "#F7F9FC",
      "elements": [
        {
          "name": "Rank",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 1,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "backColorExpression": "Iif(HireMonth = Month(Today()), \"#FFF4D6\", \"Transparent\")",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Row()"
        },
        {
          "name": "Employee",
          "type": "field",
          "bounds": {
            "x": 1,
            "y": 0,
            "w": 4.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "backColorExpression": "Iif(HireMonth = Month(Today()), \"#FFF4D6\", \"Transparent\")",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "EmployeeName"
        },
        {
          "name": "JobTitle",
          "type": "field",
          "bounds": {
            "x": 5.6,
            "y": 0,
            "w": 4.3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "backColorExpression": "Iif(HireMonth = Month(Today()), \"#FFF4D6\", \"Transparent\")",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "Title"
        },
        {
          "name": "Hired",
          "type": "computed",
          "bounds": {
            "x": 9.9,
            "y": 0,
            "w": 2.2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "backColorExpression": "Iif(HireMonth = Month(Today()), \"#FFF4D6\", \"Transparent\")",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Date(String(HireYear) + \"/\" + String(HireMonth) + \"/\" + String(HireDay))",
          "format": "yyyy-MM-dd"
        },
        {
          "name": "Age",
          "type": "computed",
          "bounds": {
            "x": 12.1,
            "y": 0,
            "w": 1.4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "backColorExpression": "Iif(HireMonth = Month(Today()), \"#FFF4D6\", \"Transparent\")",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Year(Today()) - BirthYear",
          "format": "0"
        },
        {
          "name": "Years",
          "type": "computed",
          "bounds": {
            "x": 13.5,
            "y": 0,
            "w": 1.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "backColorExpression": "Iif(HireMonth = Month(Today()), \"#FFF4D6\", \"Transparent\")",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Year(Today()) - HireYear",
          "format": "0"
        },
        {
          "name": "DaysEmployed",
          "type": "computed",
          "bounds": {
            "x": 15.1,
            "y": 0,
            "w": 2.9,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "backColorExpression": "Iif(HireMonth = Month(Today()), \"#FFF4D6\", \"Transparent\")",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "DaysAfter(Date(String(HireYear) + \"/\" + String(HireMonth) + \"/\" + String(HireDay)), Today())",
          "format": "#,##0"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AvgAge",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Average age: \" + String(Avg(Year(Today()) - BirthYear for all), \"0.0\") + \" years\""
        },
        {
          "name": "Anniversary",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.8,
            "w": 18,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Hire anniversaries in \" + String(Today(), \"MMMM\") + \" (highlighted): \" + String(Sum(Iif(HireMonth = Month(Today()), 1, 0) for all))"
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "RunAt",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 10,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Run at \" + Now()"
        },
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
