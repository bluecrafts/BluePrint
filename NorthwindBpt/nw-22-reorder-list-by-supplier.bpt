{
  "version": "1.0",
  "metadata": {
    "name": "Reorder List by Supplier",
    "description": "Products at or below their reorder level, with a QR code of the supplier's contact",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT s.CompanyName AS SupplierName,\n       s.ContactName, s.Phone, s.Country,\n       p.ProductName, p.QuantityPerUnit,\n       p.UnitsInStock, p.UnitsOnOrder, p.ReorderLevel,\n       p.UnitPrice\nFROM Products p\nJOIN Suppliers s ON s.SupplierID = p.SupplierID\nWHERE p.Discontinued = 0\n  AND p.UnitsInStock <= p.ReorderLevel\nORDER BY SupplierName, p.ProductName",
    "columns": [
      {
        "name": "SupplierName",
        "dbType": "string"
      },
      {
        "name": "ContactName",
        "dbType": "string"
      },
      {
        "name": "Phone",
        "dbType": "string"
      },
      {
        "name": "Country",
        "dbType": "string"
      },
      {
        "name": "ProductName",
        "dbType": "string"
      },
      {
        "name": "QuantityPerUnit",
        "dbType": "string"
      },
      {
        "name": "UnitsInStock",
        "dbType": "int64"
      },
      {
        "name": "UnitsOnOrder",
        "dbType": "int64"
      },
      {
        "name": "ReorderLevel",
        "dbType": "int64"
      },
      {
        "name": "UnitPrice",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Frame",
          "type": "shape",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 2.2
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "penWidth": 1,
          "penColor": "#AABCCE",
          "penStyle": "solid",
          "geometric": "roundRectangle",
          "roundCorner": 0.2
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0.3,
            "y": 0.25,
            "w": 17.4,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Reorder List by Supplier"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0.3,
            "y": 1.2,
            "w": 17.4,
            "h": 0.8
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "wrapText": true,
          "text": "Products whose stock has fallen to the reorder level. Scan the code beside a supplier to get their contact details onto a phone."
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 6.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Product"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 7.2,
            "y": 0,
            "w": 4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Pack"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 11.4,
            "y": 0,
            "w": 2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "In stock"
        },
        {
          "name": "H4",
          "type": "label",
          "bounds": {
            "x": 13.6,
            "y": 0,
            "w": 2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "On order"
        },
        {
          "name": "H5",
          "type": "label",
          "bounds": {
            "x": 15.8,
            "y": 0,
            "w": 2.2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Reorder at"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "SupplierName"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 2.4,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "SupplierHead",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 13,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 13,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "SupplierName"
        },
        {
          "name": "SupplierContact",
          "type": "computed",
          "bounds": {
            "x": 0.1,
            "y": 0.95,
            "w": 13,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "TextJoin(\" - \", ContactName, Phone, Country)"
        },
        {
          "name": "ContactCode",
          "type": "barcode",
          "bounds": {
            "x": 15.8,
            "y": 0.1,
            "w": 2.2,
            "h": 2.2
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0,
            "paddingRight": 0
          },
          "expression": "\"BEGIN:VCARD\" + Char(10) + \"VERSION:3.0\" + Char(10) + \"N:\" + ContactName + Char(10) + \"ORG:\" + SupplierName + Char(10) + \"TEL:\" + Phone + Char(10) + \"END:VCARD\"",
          "barcode": {
            "symbology": "qrCode",
            "showText": false,
            "rotation": "none",
            "dpi": 300,
            "encoding": "auto",
            "narrowToWideRatio": 2,
            "qrEcLevel": "m",
            "includeChecksum": false,
            "aztecEcPercent": 23,
            "dataMatrixRectangular": false
          }
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Product",
          "type": "field",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 6.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "ProductName"
        },
        {
          "name": "Pack",
          "type": "field",
          "bounds": {
            "x": 7.2,
            "y": 0,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "QuantityPerUnit"
        },
        {
          "name": "Stock",
          "type": "field",
          "bounds": {
            "x": 11.4,
            "y": 0,
            "w": 2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "foreColorExpression": "Iif(UnitsInStock = 0, \"#B00000\", \"#000000\")",
            "backColorExpression": "Iif(UnitsInStock = 0, \"#FFE0E0\", \"Transparent\")",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "UnitsInStock",
          "format": "#,##0"
        },
        {
          "name": "OnOrder",
          "type": "field",
          "bounds": {
            "x": 13.6,
            "y": 0,
            "w": 2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "UnitsOnOrder",
          "format": "#,##0"
        },
        {
          "name": "ReorderAt",
          "type": "field",
          "bounds": {
            "x": 15.8,
            "y": 0,
            "w": 2.2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "ReorderLevel",
          "format": "#,##0"
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "SupplierLabel",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.1,
            "w": 12,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Count(ProductName for group 1) + Iif(Count(ProductName for group 1) = 1, \" product\", \" products\") + \" to reorder from this supplier\""
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandLabel",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.2,
            "w": 17.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(ProductName for all) + \" products to reorder\""
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
