{
  "version": "1.0",
  "metadata": {
    "name": "Monthly Sales by Employee",
    "description": "Sales month by month for each employee, over a date range you enter",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT {bp:Concat(e.LastName, ', ', e.FirstName)} AS EmployeeName,\n       {bp:ToText(Year(o.OrderDate), 4)} AS SalesYear,\n       {bp:Month(o.OrderDate)} AS MonthNo,\n       COUNT(DISTINCT o.OrderID) AS OrderCount,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS Sales\nFROM Orders o\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nWHERE {bp:DateText(o.OrderDate)} >= {bp:DateText(@FromDate)}\n  AND {bp:DateText(o.OrderDate)} <= {bp:DateText(@ToDate)}\nGROUP BY e.LastName, e.FirstName,\n         {bp:ToText(Year(o.OrderDate), 4)}, {bp:Month(o.OrderDate)}\nORDER BY EmployeeName, SalesYear, MonthNo",
    "arguments": [
      {
        "name": "FromDate",
        "argType": "date"
      },
      {
        "name": "ToDate",
        "argType": "date"
      }
    ],
    "columns": [
      {
        "name": "EmployeeName",
        "dbType": "string"
      },
      {
        "name": "SalesYear",
        "dbType": "string"
      },
      {
        "name": "MonthNo",
        "dbType": "int64"
      },
      {
        "name": "OrderCount",
        "dbType": "int64"
      },
      {
        "name": "Sales",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Monthly Sales by Employee"
        },
        {
          "name": "Period",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.95,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Orders from \" + String(@FromDate, \"yyyy-MM-dd\") + \" to \" + String(@ToDate, \"yyyy-MM-dd\")"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Month"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 6.8,
            "y": 0,
            "w": 3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Orders"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 10.1,
            "y": 0,
            "w": 4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Sales"
        },
        {
          "name": "H4",
          "type": "label",
          "bounds": {
            "x": 14.4,
            "y": 0,
            "w": 3.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Share of year"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "EmployeeName"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "EmpHead",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.15,
            "w": 10,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 13,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "EmployeeName"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "MonthName",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "Switch(MonthNo = 1, \"January\", MonthNo = 2, \"February\", MonthNo = 3, \"March\", MonthNo = 4, \"April\", MonthNo = 5, \"May\", MonthNo = 6, \"June\", MonthNo = 7, \"July\", MonthNo = 8, \"August\", MonthNo = 9, \"September\", MonthNo = 10, \"October\", MonthNo = 11, \"November\", \"December\") + \" \" + SalesYear"
        },
        {
          "name": "Orders",
          "type": "field",
          "bounds": {
            "x": 6.8,
            "y": 0,
            "w": 3,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "OrderCount",
          "format": "#,##0"
        },
        {
          "name": "MonthSales",
          "type": "field",
          "bounds": {
            "x": 10.1,
            "y": 0,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "Sales",
          "format": "#,##0.00"
        },
        {
          "name": "Share",
          "type": "computed",
          "bounds": {
            "x": 14.4,
            "y": 0,
            "w": 3.6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "Sales / Sum(Sales for group 1) * 100",
          "format": "#,##0.0\"%\""
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "EmpLabel",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Total for \" + EmployeeName"
        },
        {
          "name": "EmpOrders",
          "type": "computed",
          "bounds": {
            "x": 6.8,
            "y": 0.1,
            "w": 3,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(OrderCount for group 1)",
          "format": "#,##0"
        },
        {
          "name": "EmpSales",
          "type": "computed",
          "bounds": {
            "x": 10.1,
            "y": 0.1,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(Sales for group 1)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 9.5,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandLabel",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0.2,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "All employees"
        },
        {
          "name": "GrandSales",
          "type": "computed",
          "bounds": {
            "x": 10.1,
            "y": 0.2,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(Sales for all)",
          "format": "#,##0.00"
        },
        {
          "name": "StackChart",
          "type": "chart",
          "bounds": {
            "x": 0,
            "y": 1.2,
            "w": 18,
            "h": 8
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "chart": {
            "chartType": "stackedColumn",
            "title": "Sales per month, stacked by employee",
            "dataSet": "",
            "category": [
              {
                "expression": "SalesYear + \"-\" + String(MonthNo, \"00\")"
              }
            ],
            "seriesGroup": [
              {
                "expression": "EmployeeName"
              }
            ],
            "values": [
              {
                "expression": "Sales",
                "aggregate": "sum",
                "name": "Sales",
                "format": "#,##0",
                "axisIndex": 0
              }
            ],
            "reduction": {
              "maxCategories": 36,
              "onExceed": "warn",
              "othersLabel": "Other",
              "sort": "categoryAsc",
              "hardLimit": 5000,
              "downsample": false,
              "downsampleTarget": 0
            },
            "categoryAxis": {
              "title": "Month",
              "scaleType": "auto",
              "visible": true,
              "showGridLines": false,
              "labelInterval": 0,
              "labelAngle": 30
            },
            "valueAxis": {
              "title": "Sales",
              "scaleType": "auto",
              "format": "#,##0",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "legend": {
              "visible": true,
              "position": "bottom"
            },
            "style": {
              "palette": "office",
              "fontFamily": "Tahoma",
              "titleFontPt": 12,
              "labelFontPt": 8,
              "foreColor": "#000000",
              "gridLineColor": "#D9D9D9",
              "axisLineColor": "#808080",
              "plotBackColor": "Transparent",
              "showDataLabels": false,
              "barGapRatio": 0.2,
              "doughnutHoleRatio": 0.5
            }
          }
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
