{
  "version": "1.0",
  "metadata": {
    "name": "Product Sales ABC",
    "description": "Products ranked by sales, graded A, B and C by cumulative share",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT p.ProductName,\n       c.CategoryName,\n       SUM(od.Quantity) AS Units,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS Sales\nFROM {bp:Name(Order Details)} od\nJOIN Products p ON p.ProductID = od.ProductID\nJOIN Categories c ON c.CategoryID = p.CategoryID\nGROUP BY p.ProductName, c.CategoryName\nORDER BY Sales DESC",
    "columns": [
      {
        "name": "ProductName",
        "dbType": "string"
      },
      {
        "name": "CategoryName",
        "dbType": "string"
      },
      {
        "name": "Units",
        "dbType": "int64"
      },
      {
        "name": "Sales",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Product Sales ABC"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.95,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Best sellers first. A is the products that make the first 80 per cent of sales, B the next 15, C the rest."
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H0",
          "type": "label",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 1.2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "No."
        },
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 1.9,
            "y": 0,
            "w": 6.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Product"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 8.6,
            "y": 0,
            "w": 3.4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Category"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 12.2,
            "y": 0,
            "w": 3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Sales"
        },
        {
          "name": "H4",
          "type": "label",
          "bounds": {
            "x": 15.4,
            "y": 0,
            "w": 1.7,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Cum. %"
        },
        {
          "name": "H5",
          "type": "label",
          "bounds": {
            "x": 17.3,
            "y": 0,
            "w": 0.7,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "center",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Gr"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Rank",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 1.2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "Row()"
        },
        {
          "name": "Product",
          "type": "field",
          "bounds": {
            "x": 1.9,
            "y": 0,
            "w": 6.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "ProductName"
        },
        {
          "name": "Category",
          "type": "field",
          "bounds": {
            "x": 8.6,
            "y": 0,
            "w": 3.4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "CategoryName"
        },
        {
          "name": "SalesValue",
          "type": "field",
          "bounds": {
            "x": 12.2,
            "y": 0,
            "w": 3,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "Sales",
          "format": "#,##0.00"
        },
        {
          "name": "CumPercent",
          "type": "computed",
          "bounds": {
            "x": 15.4,
            "y": 0,
            "w": 1.7,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "CumulativePercent(Sales for all)",
          "format": "#,##0.0"
        },
        {
          "name": "Grade",
          "type": "computed",
          "bounds": {
            "x": 17.3,
            "y": 0,
            "w": 0.7,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "foreColorExpression": "Switch(CumulativePercent(Sales for all) <= 80, \"#1F6F3C\", CumulativePercent(Sales for all) <= 95, \"#8A6D00\", \"#B00000\")",
            "hAlign": "center",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "expression": "Switch(CumulativePercent(Sales for all) <= 80, \"A\", CumulativePercent(Sales for all) <= 95, \"B\", \"C\")"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 9.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandLabel",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.2,
            "w": 11.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(ProductName for all) + \" products\""
        },
        {
          "name": "GrandTotal",
          "type": "computed",
          "bounds": {
            "x": 12.2,
            "y": 0.2,
            "w": 3,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Sum(Sales for all)",
          "format": "#,##0.00"
        },
        {
          "name": "ParetoChart",
          "type": "chart",
          "bounds": {
            "x": 0,
            "y": 1.2,
            "w": 18,
            "h": 8.2
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "chart": {
            "chartType": "column",
            "title": "Sales per category, from the same rows",
            "dataSet": "",
            "category": [
              {
                "expression": "CategoryName"
              }
            ],
            "seriesGroup": [],
            "values": [
              {
                "expression": "Sales",
                "aggregate": "sum",
                "name": "Sales",
                "format": "#,##0",
                "axisIndex": 0
              }
            ],
            "reduction": {
              "maxCategories": 24,
              "onExceed": "warn",
              "othersLabel": "Other",
              "sort": "valueDesc",
              "hardLimit": 5000,
              "downsample": false,
              "downsampleTarget": 0
            },
            "categoryAxis": {
              "title": "Category",
              "scaleType": "auto",
              "visible": true,
              "showGridLines": false,
              "labelInterval": 0,
              "labelAngle": 30
            },
            "valueAxis": {
              "title": "Sales",
              "scaleType": "auto",
              "format": "#,##0",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "legend": {
              "visible": false,
              "position": "bottom"
            },
            "style": {
              "palette": "office",
              "fontFamily": "Tahoma",
              "titleFontPt": 12,
              "labelFontPt": 8,
              "foreColor": "#000000",
              "gridLineColor": "#D9D9D9",
              "axisLineColor": "#808080",
              "plotBackColor": "Transparent",
              "showDataLabels": false,
              "barGapRatio": 0.2,
              "doughnutHoleRatio": 0.5
            }
          }
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}
