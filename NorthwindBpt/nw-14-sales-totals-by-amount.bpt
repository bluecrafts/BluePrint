            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(OrderID for group 1) + \" orders of \" + Switch(AmountBand = 1, \"10,000 and over\", AmountBand = 2, \"5,000 to 9,999\", \"2,500 to 4,999\")"
        },
        {
          "name": "BandTotal",
          "type": "computed",
          "bounds": {
            "x": 14,
            "y": 0.1,
            "w": 4,
