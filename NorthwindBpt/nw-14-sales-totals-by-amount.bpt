{
  "version": "1.0",
  "metadata": {
    "name": "Sales Totals by Amount",
    "description": "Shipped orders of 2,500 and over, grouped into amount bands",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT CASE WHEN SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) >= 10000 THEN 1\n            WHEN SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) >= 5000  THEN 2\n            ELSE 3 END AS AmountBand,\n       o.OrderID,\n       c.CompanyName AS CustomerName,\n       {bp:DateText(o.ShippedDate)} AS ShippedDate,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS OrderTotal\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nWHERE o.ShippedDate IS NOT NULL\nGROUP BY o.OrderID, c.CompanyName, o.ShippedDate\nHAVING SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) >= 2500\nORDER BY AmountBand, SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) DESC",
    "columns": [
      {
        "name": "AmountBand",
        "dbType": "int64"
      },
      {
        "name": "OrderID",
        "dbType": "int64"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "ShippedDate",
        "dbType": "string"
      },
      {
        "name": "OrderTotal",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Sales Totals by Amount"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.95,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Shipped orders worth 2,500 or more, largest first"
        }
      ]
    },
