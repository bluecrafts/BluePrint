    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "CategoryTitle"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "resetPageNumberOnNewGroup": true,
      "height": 1.1,
      "autoHeight": true,
      "newPageBefore": true,
      "repeatOnNewPage": true,
      "backColor": "#DCE6F0",
      "elements": [
        {
          "name": "G1A",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.05,
            "w": 18,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "CategoryTitle + \" - \" + Count(OrderNo for group 1) + \" lines of \" + Count(ProductNo for group 1 distinct) + \" products\""
        },
        {
          "name": "G1Note",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.65,
            "w": 18,
            "h": 0.4
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 7,
            "italic": true,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "source": "CategoryNote",
          "wrapText": true,
          "autoHeight": true
        },
        {
          "name": "G1B",
          "type": "computed",
          "bounds": {
            "x": 18,
            "y": 0.05,
            "w": 18,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "CategoryTitle + \" - sales \" + String(Sum(ListPrice * LineQuantity for group 1), \"#,##0.00\")"
        },
        {
          "name": "G1C",
          "type": "computed",
          "bounds": {
            "x": 36,
            "y": 0.05,
            "w": 18,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "CategoryTitle + \" - \" + Count(PriceBand for group 1 distinct) + \" price bands\""
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 2,
      "groupByColumns": [
        "PriceBand"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.5,
      "repeatOnNewPage": true,
      "backColor": "#EEF3F8",
      "elements": [
        {
          "name": "G2A",
          "type": "computed",
          "bounds": {
            "x": 0.3,
            "y": 0.03,
            "w": 17.7,
            "h": 0.44
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 8,
            "bold": true,
            "foreColor": "#1F3864",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "\"Price \" + Switch(PriceBand = 1, \"under 20\", PriceBand = 2, \"20 to 50\", \"50 and over\")"
        },
        {
          "name": "G2B",
          "type": "computed",
          "bounds": {
            "x": 18,
            "y": 0.03,
            "w": 18,
            "h": 0.44
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 7.5,
            "bold": true,
            "foreColor": "#1F3864",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "\"Price \" + Switch(PriceBand = 1, \"under 20\", PriceBand = 2, \"20 to 50\", \"50 and over\") + \" - average \" + String(Avg(ListPrice for group 2), \"#,##0.00\")"
        },
        {
          "name": "G2C",
          "type": "computed",
          "bounds": {
            "x": 36,
            "y": 0.03,
