            "w": 18,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 7,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "text": "Sheet 2 of 3: the report culture is German, so numbers use a comma for decimals."
        },
        {
