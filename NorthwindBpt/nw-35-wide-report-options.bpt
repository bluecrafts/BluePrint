          "type": "label",
          "bounds": {
            "x": 36,
            "y": 0,
            "w": 18,
            "h": 0.8
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 13,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "text": "Report Options (culture and position)"
        },
        {
          "name": "S3",
          "type": "label",
          "bounds": {
            "x": 36,
            "y": 0.85,
            "w": 18,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 7,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "text": "Sheet 3 of 3: day and month names follow the culture; group positions."
        }
