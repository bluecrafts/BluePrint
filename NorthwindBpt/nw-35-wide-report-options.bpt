{
  "version": "1.0",
  "metadata": {
    "name": "Report Options",
    "description": "Order lines of 1998 in three categories, page numbers restarting for each category, German number format, three sheets wide",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT od.OrderID AS OrderNo,\n       p.ProductID AS ProductNo,\n       p.ProductName AS ItemName,\n       cat.CategoryName AS CategoryTitle,\n       cat.Description AS CategoryNote,\n       sup.CompanyName AS SupplierName,\n       sup.Country AS SupplierCountry,\n       CAST(od.UnitPrice AS REAL) AS ListPrice,\n       od.Quantity AS LineQuantity,\n       p.UnitsInStock AS InStock,\n       {bp:Year(o.OrderDate)} AS OrderYear,\n       CASE WHEN p.Discontinued = 0 THEN 0 ELSE 1 END AS DiscontinuedFlag,\n       CASE WHEN od.UnitPrice < 20 THEN 1 WHEN od.UnitPrice < 50 THEN 2 ELSE 3 END AS PriceBand\nFROM {bp:Name(Order Details)} od\nJOIN Orders o ON o.OrderID = od.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nJOIN Categories cat ON cat.CategoryID = p.CategoryID\nJOIN Suppliers sup ON sup.SupplierID = p.SupplierID",
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "ProductNo",
        "dbType": "int64"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "CategoryTitle",
        "dbType": "string"
      },
      {
        "name": "CategoryNote",
        "dbType": "string"
      },
      {
        "name": "SupplierName",
        "dbType": "string"
      },
      {
        "name": "SupplierCountry",
        "dbType": "string"
      },
      {
        "name": "ListPrice",
        "dbType": "double"
      },
      {
        "name": "LineQuantity",
        "dbType": "int64"
      },
      {
        "name": "InStock",
        "dbType": "int64"
      },
      {
        "name": "OrderYear",
        "dbType": "int64"
      },
      {
        "name": "DiscontinuedFlag",
        "dbType": "int64"
      },
      {
        "name": "PriceBand",
        "dbType": "int64"
      }
    ]
  },
  "sortColumns": [
    {
      "rules": [
        {
          "field": "CategoryTitle",
          "direction": "asc"
        },
        {
          "field": "PriceBand",
          "direction": "desc"
        },
        {
          "field": "ListPrice",
          "direction": "desc"
        },
        {
          "field": "ItemName",
          "direction": "asc"
        },
        {
          "field": "OrderNo",
          "direction": "asc"
        }
      ]
    }
  ],
  "culture": "de-DE",
  "filters": "OrderYear = 1998 && CategoryTitle in (\"Beverages\", \"Condiments\", \"Confections\")",
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "T1",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.8
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 15,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "text": "Report Options"
        },
        {
          "name": "S1",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.85,
            "w": 18,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 7,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "text": "Each category starts a new page and restarts page numbers. Long names wrap and the row grows."
        },
        {
          "name": "T2",
          "type": "label",
          "bounds": {
            "x": 18,
            "y": 0,
            "w": 18,
            "h": 0.8
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 13,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "text": "Report Options (numbers)"
        },
        {
