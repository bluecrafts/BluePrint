            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#B8C2CC",
                "width": 1
              }
            }
          },
