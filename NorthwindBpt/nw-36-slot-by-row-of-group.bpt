                "width": 1
              }
            }
          },
          "text": "Product (even rows)"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "Categories_CategoryID"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CatHead",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.15,
            "w": 10,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
