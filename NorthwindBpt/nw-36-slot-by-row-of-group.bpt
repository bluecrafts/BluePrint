                "width": 0.5
              }
            }
          },
          "source": "Products_ProductName",
          "slotNo": 2
        }
      ],
      "alternateBackColor": "#F7F9FC"
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CatCount",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 9,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(Products_ProductID for group 1) + \" product(s)\""
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "GrandCount",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Count(Products_ProductID for all) + \" products in \" + Count(Categories_CategoryID for all distinct) + \" categories\""
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": [
    {
      "slotNo": 1,
      "expression": "Mod(RowOfGroup(1), 2) = 1"
    },
    {
      "slotNo": 2,
      "expression": "Mod(RowOfGroup(1), 2) = 0"
    }
  ]
}
