{
  "version": "1.0",
  "metadata": {
    "name": "Products in Two Columns - RowOfGroup",
    "description": "Slot Data splits each category into two columns: odd rows of the group on the left, even rows on the right. RowOfGroup(1) restarts at 1 in every category",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.CategoryID, c.CategoryName, p.ProductID, p.ProductName\nFROM Categories c\nJOIN Products p ON p.CategoryID = c.CategoryID\nORDER BY c.CategoryID, p.ProductID",
    "columns": [
      {
        "name": "Categories_CategoryID",
        "dbType": "int64"
      },
      {
        "name": "Categories_CategoryName",
        "dbType": "string"
      },
      {
        "name": "Products_ProductID",
        "dbType": "int64"
      },
      {
        "name": "Products_ProductName",
        "dbType": "string"
      }
    ]
  },
  "sortColumns": [
    {
      "rules": [
        {
          "field": "Categories_CategoryID",
          "direction": "asc"
        }
      ]
    }
  ],
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AccentBar",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.12
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 2,
            "foreColor": "#1F5FAD",
            "backColor": "#1F5FAD",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": ""
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Products in Two Columns"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1.25,
            "w": 18,
            "h": 1.3
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "wrapText": true,
          "text": "Odd rows of each category on the left, even rows on the right, from one query. Slot 1 is Mod(RowOfGroup(1), 2) = 1, slot 2 is Mod(RowOfGroup(1), 2) = 0 - the count starts again in every category."
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 1.2,
