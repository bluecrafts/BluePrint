{
  "version": "1.0",
  "metadata": {
    "name": "Customer Aggregates",
    "description": "Order lines of German customers in 1998 with every aggregate, three group levels, three sheets wide",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT od.OrderID AS OrderNo,\n       c.Country AS CustomerCountry,\n       c.CompanyName AS CustomerName,\n       p.ProductName AS ItemName,\n       od.Quantity AS LineQuantity,\n       ROUND(od.UnitPrice * 100, 0) AS PriceCents,\n       ROUND(od.Discount * 100, 0) AS DiscountPercent,\n       ROUND(o.Freight * 100, 0) AS FreightCents,\n       {bp:DateText(o.OrderDate)} AS OrderDateText,\n       {bp:Year(o.OrderDate)} AS OrderYear\nFROM {bp:Name(Order Details)} od\nJOIN Orders o ON o.OrderID = od.OrderID\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Products p ON p.ProductID = od.ProductID",
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "CustomerCountry",
        "dbType": "string"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "LineQuantity",
        "dbType": "int64"
      },
      {
        "name": "PriceCents",
        "dbType": "int64"
      },
      {
        "name": "DiscountPercent",
        "dbType": "int64"
      },
      {
        "name": "FreightCents",
        "dbType": "int64"
      },
      {
        "name": "OrderDateText",
        "dbType": "string"
      },
      {
        "name": "OrderYear",
        "dbType": "int64"
      }
    ]
  },
  "sortColumns": [
    {
      "rules": [
        {
          "field": "CustomerCountry",
          "direction": "asc"
        },
        {
          "field": "CustomerName",
          "direction": "asc"
        },
        {
          "field": "OrderNo",
          "direction": "asc"
        },
        {
          "field": "computeField:LineAmount",
          "direction": "desc"
        }
      ]
    }
  ],
  "filters": "CustomerCountry = \"Germany\" && OrderYear = 1998",
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
