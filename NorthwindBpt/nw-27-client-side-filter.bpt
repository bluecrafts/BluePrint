{
  "version": "1.0",
  "metadata": {
    "name": "Client-Side Filter",
    "description": "The query returns every product; the report keeps only the rows worth printing",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.CategoryName,\n       p.ProductName,\n       p.UnitsInStock,\n       p.UnitsOnOrder,\n       p.ReorderLevel,\n       CASE WHEN p.Discontinued = 0 THEN 0 ELSE 1 END AS Discontinued,\n       CAST(p.UnitPrice AS REAL) AS UnitPrice\nFROM Products p\nJOIN Categories c ON c.CategoryID = p.CategoryID\nORDER BY c.CategoryName, p.ProductName",
    "columns": [
      {
        "name": "CategoryName",
        "dbType": "string"
      },
      {
        "name": "ProductName",
        "dbType": "string"
      },
      {
        "name": "UnitsInStock",
        "dbType": "int64"
      },
      {
        "name": "UnitsOnOrder",
        "dbType": "int64"
      },
      {
        "name": "ReorderLevel",
        "dbType": "int64"
      },
      {
        "name": "Discontinued",
        "dbType": "int64"
      },
      {
        "name": "UnitPrice",
        "dbType": "double"
      }
    ]
  },
  "filters": "Discontinued = 0 && UnitsInStock <= ReorderLevel",
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.4,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Client-Side Filter"
        },
        {
          "name": "Subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.95,
            "w": 18,
            "h": 1.3
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#555555",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "wrapText": true,
          "text": "The query has no WHERE clause - it returns all 77 products. What you see is what the report's filter kept: Discontinued = 0 && UnitsInStock <= ReorderLevel. Open Design > Rows > Filter to change it without touching the SQL."
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
