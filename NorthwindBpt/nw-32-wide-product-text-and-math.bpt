            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Ceiling(ListPrice / 10) * 10",
          "format": "0"
        },
        {
          "name": "Floor10",
          "type": "computed",
          "bounds": {
            "x": 43.3,
            "y": 0,
