            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Sign(InStock - ReorderAt)"
        },
        {
          "name": "AbsF",
          "type": "computed",
          "bounds": {
            "x": 46.9,
            "y": 0,
            "w": 0.9,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Abs(InStock - ReorderAt)"
        },
        {
          "name": "SqrtF",
