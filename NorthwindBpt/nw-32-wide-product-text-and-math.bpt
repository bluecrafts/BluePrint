    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "CategoryTitle"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.65,
      "repeatOnNewPage": true,
      "backColor": "#DCE6F0",
      "elements": [
        {
          "name": "G1A",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.05,
            "w": 18,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Upper(CategoryTitle) + \" - \" + Count(ProductNo for group 1) + \" products\""
        },
        {
          "name": "G1B",
          "type": "computed",
          "bounds": {
            "x": 18,
            "y": 0.05,
            "w": 18,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "CategoryTitle + \" - \" + Count(SupplierName for group 1 distinct) + \" suppliers in \" + Count(SupplierCountry for group 1 distinct) + \" countries\""
        },
        {
          "name": "G1C",
          "type": "computed",
          "bounds": {
            "x": 36,
            "y": 0.05,
            "w": 18,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "CategoryTitle + \" - prices from \" + String(Min(ListPrice for group 1), \"#,##0.00\") + \" to \" + String(Max(ListPrice for group 1), \"#,##0.00\")"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 2,
      "groupByColumns": [
        "SupplierCountry"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.5,
      "repeatOnNewPage": true,
      "backColor": "#EEF3F8",
      "elements": [
        {
          "name": "G2A",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.03,
            "w": 18,
            "h": 0.44
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7.5,
            "bold": true,
            "foreColor": "#1F3864",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "\"Made in \" + SupplierCountry + \" (\" + Fill(\"*\", Count(ProductNo for group 2)) + \")\""
        },
        {
          "name": "G2B",
          "type": "computed",
          "bounds": {
            "x": 18,
            "y": 0.03,
            "w": 18,
            "h": 0.44
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7.5,
            "bold": true,
            "foreColor": "#1F3864",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "SupplierCountry + \" - first supplier \" + First(SupplierName for group 2)"
        },
        {
          "name": "G2C",
          "type": "computed",
          "bounds": {
            "x": 36,
            "y": 0.03,
            "w": 18,
            "h": 0.44
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7.5,
            "bold": true,
            "foreColor": "#1F3864",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "SupplierCountry + \" - stock value \" + String(Sum([StockValue] for group 2), \"#,##0.00\")"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.45,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "alternateBackColor": "#F7F9FB",
      "elements": [
        {
          "name": "Cover",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 0.1,
            "h": 0.1
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "visible": false,
          "expression": "If(ReorderAt = 0, 99, Round((InStock + OnOrder) / ReorderAt, 1))"
        },
        {
          "name": "NoF",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 1,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "source": "ProductNo"
        },
        {
          "name": "NameF",
          "type": "field",
          "bounds": {
            "x": 1,
            "y": 0,
            "w": 5,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "source": "ItemName"
        },
        {
          "name": "Upper12",
          "type": "computed",
          "bounds": {
            "x": 6,
            "y": 0,
            "w": 3,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Upper(Left(ItemName, 12))"
        },
        {
          "name": "WordCapLower",
          "type": "computed",
          "bounds": {
            "x": 9,
            "y": 0,
            "w": 5,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "WordCap(Lower(ItemName))"
        },
        {
          "name": "LenF",
          "type": "computed",
          "bounds": {
            "x": 14,
            "y": 0,
            "w": 1,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Len(ItemName)"
        },
        {
          "name": "GLenF",
          "type": "computed",
          "bounds": {
            "x": 15,
            "y": 0,
            "w": 1,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "GLen(ItemName)"
        },
        {
          "name": "Right6",
          "type": "computed",
          "bounds": {
            "x": 16,
            "y": 0,
            "w": 2,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Right(ItemName, 6)"
        },
        {
          "name": "PackF",
          "type": "field",
          "bounds": {
            "x": 18,
            "y": 0,
            "w": 3.6,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "source": "PackSize"
        },
        {
          "name": "FirstSpace",
          "type": "computed",
          "bounds": {
            "x": 21.6,
            "y": 0,
            "w": 0.8,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Pos(PackSize, \" \", 1)"
        },
        {
          "name": "FirstWord",
          "type": "computed",
          "bounds": {
            "x": 22.4,
            "y": 0,
            "w": 1.6,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Mid(PackSize, 1, Pos(PackSize, \" \", 1) - 1)"
        },
        {
          "name": "LastSpace",
          "type": "computed",
          "bounds": {
            "x": 24,
            "y": 0,
            "w": 0.8,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "LastPos(PackSize, \" \")"
        },
        {
          "name": "ReplaceX",
          "type": "computed",
          "bounds": {
            "x": 24.8,
            "y": 0,
            "w": 3,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Replace(PackSize, \" x \", \"*\")"
        },
        {
          "name": "PadNo",
          "type": "computed",
          "bounds": {
            "x": 27.8,
            "y": 0,
            "w": 1.2,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "PadLeft(\"\" + ProductNo, 5, \"0\")"
        },
        {
          "name": "PadSupplier",
          "type": "computed",
          "bounds": {
            "x": 29,
            "y": 0,
            "w": 2.6,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "PadRight(Left(SupplierName, 10), 14, \".\")"
        },
        {
          "name": "Flags",
          "type": "computed",
          "bounds": {
            "x": 31.6,
            "y": 0,
            "w": 1.6,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "If(Contains(PackSize, \"bottles\"), \"B\", \"-\") + If(StartsWith(ItemName, \"Ch\"), \"C\", \"-\") + If(EndsWith(PackSize, \"g\"), \"G\", \"-\") + If(Match(PackSize, \"^[0-9]+ x\"), \"M\", \"-\") + If(IsNumber(Left(PackSize, 1)), \"N\", \"-\")"
        },
        {
          "name": "AscF",
          "type": "computed",
          "bounds": {
            "x": 33.2,
            "y": 0,
            "w": 0.9,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Asc(ItemName)"
        },
        {
          "name": "Trims",
          "type": "computed",
          "bounds": {
            "x": 34.1,
            "y": 0,
            "w": 1.9,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "\"[\" + LTrim(Space(2) + Left(ItemName, 3)) + \"|\" + RTrim(Left(ItemName, 3) + Space(2)) + \"]\""
        },
        {
          "name": "ListPrice",
          "type": "computed",
          "bounds": {
            "x": 36,
            "y": 0,
            "w": 1.4,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Long(PriceCents) / 100",
          "format": "#,##0.00"
        },
        {
          "name": "RoundF",
          "type": "computed",
          "bounds": {
            "x": 37.4,
            "y": 0,
            "w": 1.3,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Round(ListPrice * 1.0725, 1)",
          "format": "0.0"
        },
        {
          "name": "TruncF",
          "type": "computed",
          "bounds": {
            "x": 38.7,
            "y": 0,
            "w": 1.3,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Truncate(ListPrice * 1.0725, 1)",
          "format": "0.0"
        },
        {
          "name": "RoundUpF",
          "type": "computed",
          "bounds": {
            "x": 40,
            "y": 0,
            "w": 1.1,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "RoundUp(ListPrice * 1.0725, 0)",
          "format": "0"
        },
        {
          "name": "RoundDownF",
          "type": "computed",
          "bounds": {
            "x": 41.1,
            "y": 0,
