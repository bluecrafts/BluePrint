            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "RoundDown(ListPrice * 1.0725, 0)",
          "format": "0"
        },
        {
          "name": "Ceil10",
          "type": "computed",
          "bounds": {
            "x": 42.2,
            "y": 0,
            "w": 1.1,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 7,
