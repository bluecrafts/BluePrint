            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Floor(ListPrice / 10) * 10",
          "format": "0"
        },
        {
          "name": "ModF",
          "type": "computed",
          "bounds": {
            "x": 44.4,
            "y": 0,
            "w": 0.9,
