            "fontSize": 7,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.05,
            "paddingRight": 0.05
          },
          "expression": "Int(InStock / 12)"
