{
  "version": "1.0",
  "metadata": {
    "name": "Product Text and Math",
    "description": "Every product with text, math and conversion functions applied, three sheets wide",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT p.ProductID AS ProductNo,\n       p.ProductName AS ItemName,\n       cat.CategoryName AS CategoryTitle,\n       sup.CompanyName AS SupplierName,\n       sup.Country AS SupplierCountry,\n       p.QuantityPerUnit AS PackSize,\n       ROUND(p.UnitPrice * 100, 0) AS PriceCents,\n       p.UnitsInStock AS InStock,\n       p.UnitsOnOrder AS OnOrder,\n       p.ReorderLevel AS ReorderAt,\n       CASE WHEN p.Discontinued = 0 THEN 0 ELSE 1 END AS DiscontinuedFlag\nFROM Products p\nJOIN Categories cat ON cat.CategoryID = p.CategoryID\nJOIN Suppliers sup ON sup.SupplierID = p.SupplierID",
    "columns": [
      {
        "name": "ProductNo",
        "dbType": "int64"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "CategoryTitle",
        "dbType": "string"
      },
      {
        "name": "SupplierName",
        "dbType": "string"
      },
      {
        "name": "SupplierCountry",
        "dbType": "string"
      },
      {
        "name": "PackSize",
        "dbType": "string"
      },
      {
        "name": "PriceCents",
        "dbType": "int64"
      },
      {
        "name": "InStock",
        "dbType": "int64"
      },
      {
        "name": "OnOrder",
        "dbType": "int64"
      },
      {
        "name": "ReorderAt",
        "dbType": "int64"
      },
      {
        "name": "DiscontinuedFlag",
        "dbType": "int64"
      }
    ]
  },
  "sortColumns": [
    {
      "rules": [
        {
          "field": "CategoryTitle",
          "direction": "asc"
        },
        {
          "field": "SupplierCountry",
          "direction": "asc"
        },
        {
          "field": "ItemName",
          "direction": "asc"
        }
      ]
    }
  ],
  "culture": "en-US",
  "sections": [
