{
  "version": "1.2",
  "metadata": {
    "name": "Sales by Region",
    "description": "A crosstab: regions down the side, quarters across the top",
    "author": "BluePrint"
  },
  "report": {
    "type": "crosstab",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 297,
        "heightMm": 210
      },
      "orientation": "landscape",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    },
    "crosstabDefinition": {
      "rows": [
        {
          "field": "Region",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "columns": [
        {
          "field": "Quarter",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "values": [
        {
          "source": "Amount",
          "aggregate": "sum",
          "format": "#,##0.00"
        }
      ],
      "totals": {
        "rowGrand": true,
        "colGrand": true,
        "grand": true
      },
      "emptyCell": "-",
      "columnGuard": {
        "maxColumns": 256,
        "maxPages": 10,
        "onExceed": "warn"
      }
    }
  },
  "dataSource": {
    "dataSourceType": "external",
    "columns": [
      {
        "name": "Region",
        "dbType": "string",
        "length": 40
      },
      {
        "name": "Quarter",
        "dbType": "string",
        "length": 8
      },
      {
        "name": "Amount",
        "dbType": "decimal",
        "decimals": 2
      }
    ]
  },
