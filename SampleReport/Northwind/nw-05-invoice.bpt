{
  "version": "1.2",
  "metadata": {
    "name": "Invoice",
    "description": "A full invoice for one order. Enter the order number when you retrieve",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID, o.OrderDate, o.ShippedDate,\n       c.CompanyName AS CustomerName, c.Address, c.City, c.PostalCode, c.Country,\n       e.LastName || ', ' || e.FirstName AS Salesperson,\n       sh.CompanyName AS ShipperName, CAST(o.Freight AS REAL) AS Freight,\n       p.ProductName, CAST(od.UnitPrice AS REAL) AS UnitPrice,\n       od.Quantity, od.Discount,\n       od.UnitPrice * od.Quantity * (1 - od.Discount) AS ExtendedPrice\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN Shippers sh ON sh.ShipperID = o.ShipVia\nJOIN \"Order Details\" od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nWHERE o.OrderID = @OrderId\nORDER BY p.ProductName",
    "arguments": [
      {
        "name": "OrderId",
        "argType": "number"
      }
    ],
    "columns": [
      {
        "name": "OrderID",
        "dbType": "int64"
      },
      {
        "name": "OrderDate",
        "dbType": "string"
      },
      {
        "name": "ShippedDate",
        "dbType": "string"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "Address",
        "dbType": "string"
      },
      {
        "name": "City",
        "dbType": "string"
      },
      {
        "name": "PostalCode",
        "dbType": "string"
      },
      {
        "name": "Country",
        "dbType": "string"
      },
      {
        "name": "Salesperson",
        "dbType": "string"
      },
      {
        "name": "ShipperName",
        "dbType": "string"
      },
      {
        "name": "Freight",
        "dbType": "double"
      },
      {
        "name": "ProductName",
        "dbType": "string"
      },
      {
        "name": "UnitPrice",
        "dbType": "double"
      },
      {
        "name": "Quantity",
        "dbType": "int64"
      },
      {
        "name": "Discount",
        "dbType": "double"
      },
      {
        "name": "ExtendedPrice",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 5.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 9,
            "h": 1.1
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 22,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "INVOICE"
        },
        {
          "name": "Co",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1.1,
            "w": 9,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Northwind Traders"
        },
        {
          "name": "InvNo",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 0.1,
            "w": 7,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Order no. \" + OrderID"
        },
        {
          "name": "InvDate",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 0.75,
            "w": 7,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Ordered \" + OrderDate"
        },
        {
          "name": "ShipDate",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 1.35,
            "w": 7,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Shipped \" + Coalesce(ShippedDate, \"not yet\")"
        },
        {
          "name": "BillTo",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 2.2,
            "w": 4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Bill to"
        },
        {
          "name": "CustName",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 2.8,
            "w": 9,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "CustomerName"
        },
        {
          "name": "CustAddr",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 3.4,
            "w": 9,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "Address"
        },
        {
          "name": "CustCity",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 4,
            "w": 9,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "TextJoin(\" \", City, PostalCode, Country)"
        },
        {
          "name": "SalesBy",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 2.8,
            "w": 7,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Salesperson: \" + Salesperson"
        },
        {
          "name": "ShipBy",
          "type": "computed",
          "bounds": {
            "x": 11,
            "y": 3.4,
            "w": 7,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Shipped via: \" + ShipperName"
        },
        {
          "name": "OrderBarcode",
          "type": "barcode",
          "bounds": {
            "x": 11,
            "y": 4,
            "w": 7,
            "h": 1.1
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "String(OrderID)",
          "barcode": {
            "symbology": "code128",
            "showText": true,
            "rotation": "none",
            "dpi": 300,
            "encoding": "auto",
            "narrowToWideRatio": 2,
            "qrEcLevel": "m",
            "includeChecksum": false,
            "aztecEcPercent": 23,
            "dataMatrixRectangular": false
          }
        },
