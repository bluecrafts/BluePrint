{
  "version": "1.2",
  "metadata": {
    "name": "Alphabetical List of Products",
    "description": "Every product in name order, with its category and supplier",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT p.ProductName, c.CategoryName, s.CompanyName AS SupplierName,\n       p.QuantityPerUnit, CAST(p.UnitPrice AS REAL) AS UnitPrice\nFROM Products p\nJOIN Categories c ON c.CategoryID = p.CategoryID\nJOIN Suppliers  s ON s.SupplierID = p.SupplierID\nORDER BY p.ProductName",
    "columns": [
      {
        "name": "ProductName",
        "dbType": "string"
      },
      {
        "name": "CategoryName",
        "dbType": "string"
      },
      {
        "name": "SupplierName",
        "dbType": "string"
      },
      {
        "name": "QuantityPerUnit",
        "dbType": "string"
      },
      {
        "name": "UnitPrice",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.4,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Alphabetical List of Products"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Product"
        },
        {
          "name": "H2",
          "type": "label",
          "bounds": {
            "x": 6,
            "y": 0,
            "w": 3.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Category"
        },
        {
          "name": "H3",
          "type": "label",
          "bounds": {
            "x": 9.5,
            "y": 0,
            "w": 5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Supplier"
        },
        {
          "name": "H4",
          "type": "label",
          "bounds": {
            "x": 14.5,
            "y": 0,
            "w": 2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Pack"
        },
        {
          "name": "H5",
          "type": "label",
          "bounds": {
            "x": 16.5,
            "y": 0,
            "w": 1.5,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "#E8EDF2",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#AABCCE",
                "width": 0.5
              }
            }
          },
          "text": "Price"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Product",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "ProductName"
        },
        {
          "name": "Category",
          "type": "field",
          "bounds": {
            "x": 6,
            "y": 0,
            "w": 3.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "CategoryName"
        },
        {
          "name": "Supplier",
          "type": "field",
          "bounds": {
            "x": 9.5,
            "y": 0,
            "w": 5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "SupplierName"
        },
        {
          "name": "Pack",
          "type": "field",
          "bounds": {
            "x": 14.5,
            "y": 0,
            "w": 2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "QuantityPerUnit"
        },
        {
          "name": "Price",
          "type": "field",
          "bounds": {
            "x": 16.5,
            "y": 0,
            "w": 1.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": true,
              "all": {
                "style": "solid",
                "color": "#D8D8D8",
                "width": 0.5
              }
            }
          },
          "source": "UnitPrice",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Count",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Products: \" + Count(ProductName for all)"
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}