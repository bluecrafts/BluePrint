          "name": "EmpHead",
          "type": "field",
          "bounds": {
            "x": 0.5,
            "y": 0.05,
            "w": 10,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
