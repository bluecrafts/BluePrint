{
  "version": "1.2",
  "metadata": {
    "name": "Sales by Year",
    "description": "A crosstab: categories down the side, year and quarter across the top",
    "author": "BluePrint"
  },
  "report": {
    "type": "crosstab",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "landscape",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    },
    "crosstabDefinition": {
      "rows": [
        {
          "field": "CategoryName",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "columns": [
        {
          "field": "OrderYear",
          "sort": "asc",
          "subtotal": false
        },
        {
          "field": "Quarter",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "values": [
        {
          "source": "Sales",
          "aggregate": "sum",
          "format": "#,##0"
        }
      ],
      "totals": {
        "rowGrand": true,
        "colGrand": true,
        "grand": true
      },
      "emptyCell": "-",
      "columnGuard": {
        "maxColumns": 256,
        "maxPages": 10,
        "onExceed": "warn"
      }
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT STRFTIME('%Y', o.OrderDate) AS OrderYear,\n       'Q' || ((CAST(STRFTIME('%m', o.OrderDate) AS INTEGER) + 2) / 3) AS Quarter,\n       c.CategoryName,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS Sales\nFROM Orders o\nJOIN \"Order Details\" od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nJOIN Categories c ON c.CategoryID = p.CategoryID\nGROUP BY OrderYear, Quarter, c.CategoryName",
    "columns": [
      {
        "name": "OrderYear",
        "dbType": "string"
      },
      {
        "name": "Quarter",
        "dbType": "string"
      },
      {
        "name": "CategoryName",
        "dbType": "string"
      },
      {
        "name": "Sales",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
