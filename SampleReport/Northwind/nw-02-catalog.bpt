{
  "version": "1.2",
  "metadata": {
    "name": "Catalog",
    "description": "A product catalogue, one section per category, with pictures",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.CategoryName, c.Description, c.Picture,\n       p.ProductName, p.QuantityPerUnit, CAST(p.UnitPrice AS REAL) AS UnitPrice\nFROM Categories c\nJOIN Products p ON p.CategoryID = c.CategoryID\nORDER BY c.CategoryName, p.ProductName",
    "columns": [
      {
        "name": "CategoryName",
        "dbType": "string"
      },
      {
        "name": "Description",
        "dbType": "string"
      },
      {
        "name": "Picture",
        "dbType": "binary"
      },
      {
        "name": "ProductName",
        "dbType": "string"
      },
      {
        "name": "QuantityPerUnit",
        "dbType": "string"
      },
      {
        "name": "UnitPrice",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 3,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.4,
            "w": 18,
            "h": 1.3
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 24,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Product Catalog"
        },
        {
          "name": "Sub",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1.8,
            "w": 18,
            "h": 0.8
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 13,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Northwind Traders"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "CategoryName"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 4.2,
      "newPageBefore": true,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CategoryPicture",
          "type": "image",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 4,
            "h": 3
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Picture",
          "sizeMode": "zoom",
          "imageDpi": 96,
          "grayscale": false,
          "showErrorImage": false
        },
        {
          "name": "CategoryHead",
          "type": "field",
          "bounds": {
            "x": 4.4,
            "y": 0.2,
            "w": 13.6,
            "h": 1
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "CategoryName"
        },
        {
          "name": "CategoryDesc",
          "type": "field",
          "bounds": {
            "x": 4.4,
            "y": 1.3,
            "w": 13.6,
            "h": 1.8
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1
          },
          "source": "Description"
        },
        {
          "name": "CatRule",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 3.9,
            "w": 18,
            "h": 0.02
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "x1": 0,
          "y1": 3.9,
          "x2": 18,
          "y2": 3.9,
          "penWidth": 1,
          "penColor": "#000000",
          "penStyle": "solid"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Product",
          "type": "field",
          "bounds": {
            "x": 0.5,
            "y": 0,
            "w": 9,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "ProductName"
        },
        {
          "name": "Pack",
          "type": "field",
          "bounds": {
            "x": 9.5,
            "y": 0,
            "w": 5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "QuantityPerUnit"
        },
        {
          "name": "Price",
          "type": "field",
          "bounds": {
            "x": 14.5,
            "y": 0,
            "w": 3.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "UnitPrice",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CatCount",
          "type": "computed",
          "bounds": {
            "x": 0.5,
            "y": 0.1,
            "w": 9,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#808080",
                "width": 1
              }
            }
          },
          "expression": "\"  \" + Count(ProductName for group 1) + \" product(s)\""
        },
        {
          "name": "CatAvg",
          "type": "computed",
          "bounds": {
            "x": 14.5,
            "y": 0.1,
            "w": 3.5,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#000000",
                "width": 1
              }
            }
          },
          "expression": "Avg(UnitPrice for group 1)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}