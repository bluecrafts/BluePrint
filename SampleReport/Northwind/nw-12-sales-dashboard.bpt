{
  "version": "1.2",
  "metadata": {
    "name": "Sales Dashboard",
    "description": "Three chart types over one set of rows",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.CategoryName,\n       STRFTIME('%Y', o.OrderDate) AS OrderYear,\n       SUM(od.UnitPrice * od.Quantity * (1 - od.Discount)) AS Sales\nFROM Orders o\nJOIN \"Order Details\" od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nJOIN Categories c ON c.CategoryID = p.CategoryID\nGROUP BY c.CategoryName, OrderYear\nORDER BY c.CategoryName, OrderYear",
    "columns": [
      {
        "name": "CategoryName",
        "dbType": "string"
      },
      {
        "name": "OrderYear",
        "dbType": "string"
      },
      {
        "name": "Sales",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Sales Dashboard"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": []
    },
    {
      "type": "reportFooter",
      "height": 23.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "ByCategory",
          "type": "chart",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 18,
            "h": 7.4
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "chart": {
            "chartType": "column",
            "title": "Sales by category, split by year",
            "dataSet": "",
            "category": [
              {
                "expression": "CategoryName"
              }
            ],
            "seriesGroup": [
              {
                "expression": "OrderYear"
              }
            ],
            "values": [
              {
                "expression": "Sales",
                "aggregate": "sum",
                "name": "Sales",
                "format": "#,##0",
                "axisIndex": 0
              }
            ],
            "reduction": {
              "maxCategories": 24,
              "onExceed": "warn",
              "othersLabel": "Other",
              "sort": "categoryAsc",
              "hardLimit": 5000,
              "downsample": false,
              "downsampleTarget": 0
            },
            "categoryAxis": {
              "title": "Category",
              "scaleType": "auto",
              "visible": true,
              "showGridLines": false,
              "labelInterval": 0,
              "labelAngle": 30
            },
            "valueAxis": {
              "title": "Sales",
              "scaleType": "auto",
              "format": "#,##0",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "secondaryValueAxis": {
              "scaleType": "auto",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "legend": {
              "visible": true,
              "position": "bottom"
            },
            "style": {
              "palette": "office",
              "fontFamily": "Tahoma",
              "titleFontPt": 12,
              "labelFontPt": 8,
              "foreColor": "#000000",
              "gridLineColor": "#D9D9D9",
              "axisLineColor": "#808080",
              "plotBackColor": "Transparent",
              "showDataLabels": false,
              "barGapRatio": 0.2,
              "doughnutHoleRatio": 0.5
            }
          }
        },
        {
          "name": "Trend",
          "type": "chart",
          "bounds": {
            "x": 0,
            "y": 8,
            "w": 18,
            "h": 7.4
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "chart": {
            "chartType": "line",
            "title": "The same data as a line chart",
            "dataSet": "",
            "category": [
              {
                "expression": "CategoryName"
              }
            ],
            "seriesGroup": [
              {
                "expression": "OrderYear"
              }
            ],
            "values": [
              {
                "expression": "Sales",
                "aggregate": "sum",
                "name": "Sales",
                "format": "#,##0",
                "axisIndex": 0
              }
            ],
            "reduction": {
              "maxCategories": 24,
              "onExceed": "warn",
              "othersLabel": "Other",
              "sort": "categoryAsc",
              "hardLimit": 5000,
              "downsample": false,
              "downsampleTarget": 0
            },
            "categoryAxis": {
              "title": "Category",
              "scaleType": "auto",
              "visible": true,
              "showGridLines": false,
              "labelInterval": 0,
              "labelAngle": 30
            },
            "valueAxis": {
              "title": "Sales",
              "scaleType": "auto",
              "format": "#,##0",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "secondaryValueAxis": {
              "scaleType": "auto",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "legend": {
              "visible": true,
              "position": "bottom"
            },
            "style": {
              "palette": "office",
              "fontFamily": "Tahoma",
              "titleFontPt": 12,
              "labelFontPt": 8,
              "foreColor": "#000000",
              "gridLineColor": "#D9D9D9",
              "axisLineColor": "#808080",
              "plotBackColor": "Transparent",
              "showDataLabels": false,
              "barGapRatio": 0.2,
              "doughnutHoleRatio": 0.5
            }
          }
        },
        {
          "name": "Share",
          "type": "chart",
          "bounds": {
            "x": 0,
            "y": 15.8,
            "w": 18,
            "h": 7.4
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "chart": {
            "chartType": "pie",
            "title": "Share of sales by category",
            "dataSet": "",
            "category": [
              {
                "expression": "CategoryName"
              }
            ],
            "seriesGroup": [],
            "values": [
              {
                "expression": "Sales",
                "aggregate": "sum",
                "name": "Sales",
                "format": "#,##0",
                "axisIndex": 0
              }
            ],
            "reduction": {
              "maxCategories": 24,
              "onExceed": "warn",
              "othersLabel": "Other",
              "sort": "categoryAsc",
              "hardLimit": 5000,
              "downsample": false,
              "downsampleTarget": 0
            },
            "categoryAxis": {
              "title": "Category",
              "scaleType": "auto",
              "visible": true,
              "showGridLines": false,
              "labelInterval": 0,
              "labelAngle": 30
            },
            "valueAxis": {
              "title": "Sales",
              "scaleType": "auto",
              "format": "#,##0",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "secondaryValueAxis": {
              "scaleType": "auto",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "legend": {
              "visible": true,
              "position": "bottom"
            },
            "style": {
              "palette": "pastel",
              "fontFamily": "Tahoma",
              "titleFontPt": 12,
              "labelFontPt": 8,
              "foreColor": "#000000",
              "gridLineColor": "#D9D9D9",
              "axisLineColor": "#808080",
              "plotBackColor": "Transparent",
              "showDataLabels": false,
              "barGapRatio": 0.2,
              "doughnutHoleRatio": 0.5
            }
          }
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}