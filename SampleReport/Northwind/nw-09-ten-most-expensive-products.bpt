{
  "version": "1.2",
  "metadata": {
    "name": "Ten Most Expensive Products",
    "description": "The ten highest priced products, ranked",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT ProductName, CAST(UnitPrice AS REAL) AS UnitPrice\nFROM Products\nORDER BY UnitPrice DESC\nLIMIT 10",
    "columns": [
      {
        "name": "ProductName",
        "dbType": "string"
      },
      {
        "name": "UnitPrice",
        "dbType": "double"
      }
    ]
  },
  "sortColumns": [],
  "sections": [
