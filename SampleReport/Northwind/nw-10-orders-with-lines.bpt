{
  "version": "1.2",
  "metadata": {
    "name": "Orders with Lines",
    "description": "Each order prints its own lines underneath, from a second query",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID, o.OrderDate, c.CompanyName AS CustomerName,\n       o.ShipCountry, CAST(o.Freight AS REAL) AS Freight\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nWHERE o.OrderID BETWEEN 10248 AND 10267\nORDER BY o.OrderID",
    "columns": [
      {
        "name": "OrderID",
        "dbType": "int64"
      },
      {
        "name": "OrderDate",
        "dbType": "string"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "ShipCountry",
        "dbType": "string"
      },
      {
        "name": "Freight",
        "dbType": "double"
      }
    ]
  },
  "lookupDataSources": [
    {
      "name": "OrderLines",
      "dataSourceType": "dbsql",
      "sql": "SELECT od.OrderID, p.ProductName, od.Quantity,\n       CAST(od.UnitPrice AS REAL) AS UnitPrice,\n       od.UnitPrice * od.Quantity * (1 - od.Discount) AS LineTotal\nFROM \"Order Details\" od\nJOIN Products p ON p.ProductID = od.ProductID\nORDER BY od.OrderID, p.ProductName",
      "columns": [
        {
          "name": "OrderID",
          "dbType": "int64"
        },
        {
          "name": "ProductName",
          "dbType": "string"
        },
        {
          "name": "Quantity",
          "dbType": "int64"
        },
        {
          "name": "UnitPrice",
          "dbType": "double"
        },
        {
          "name": "LineTotal",
          "dbType": "double"
        }
      ]
    }
  ],
  "sortColumns": [],
  "sections": [
    {
      "type": "reportHeader",
      "height": 1.4,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Orders with Lines"
        }
      ]
    },
    {
      "type": "detail",
      "height": 4.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "OrderNo",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "OrderID"
        },
        {
          "name": "CustName",
          "type": "field",
          "bounds": {
            "x": 3,
            "y": 0,
            "w": 8,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 12,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "CustomerName"
        },
        {
          "name": "ODate",
          "type": "field",
          "bounds": {
            "x": 11,
            "y": 0,
            "w": 3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "OrderDate"
        },
        {
          "name": "Country",
          "type": "field",
          "bounds": {
            "x": 14,
            "y": 0,
            "w": 4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 11,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "ShipCountry"
        },
        {
          "name": "LinesHdr",
          "type": "label",
          "bounds": {
            "x": 0.6,
            "y": 0.8,
            "w": 5,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Lines"
        },
        {
          "name": "OrderLines",
          "type": "subBand",
          "bounds": {
            "x": 0,
            "y": 1.35,
            "w": 18,
            "h": 2.2
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "autoHeight": true,
          "subBand": {
            "dataset": "OrderLines",
            "linkKey": "OrderID",
            "linkColumn": "OrderID",
            "rowHeight": 0.55,
            "autoRowHeight": false,
            "rowSeparator": true,
            "elements": [
              {
                "name": "L_Product",
                "type": "computed",
                "bounds": {
                  "x": 0.6,
                  "y": 0,
                  "w": 8.4,
                  "h": 0.55
                },
                "style": {
                  "fontFamily": "Tahoma",
                  "fontSize": 9,
                  "foreColor": "#000000",
                  "backColor": "Transparent",
                  "hAlign": "left",
                  "vAlign": "top",
                  "paddingLeft": 0.1,
                  "paddingRight": 0.05
                },
                "expression": "ProductName"
              },
              {
                "name": "L_Qty",
                "type": "computed",
                "bounds": {
                  "x": 9,
                  "y": 0,
                  "w": 2,
                  "h": 0.55
                },
                "style": {
                  "fontFamily": "Tahoma",
                  "fontSize": 9,
                  "foreColor": "#000000",
                  "backColor": "Transparent",
                  "hAlign": "right",
                  "vAlign": "top",
                  "paddingLeft": 0.1,
                  "paddingRight": 0.05
                },
                "expression": "Quantity",
                "format": "#,##0"
              },
              {
                "name": "L_Price",
                "type": "computed",
                "bounds": {
                  "x": 11,
                  "y": 0,
                  "w": 3,
                  "h": 0.55
                },
                "style": {
                  "fontFamily": "Tahoma",
                  "fontSize": 9,
                  "foreColor": "#000000",
                  "backColor": "Transparent",
                  "hAlign": "right",
                  "vAlign": "top",
                  "paddingLeft": 0.1,
                  "paddingRight": 0.05
                },
                "expression": "UnitPrice",
                "format": "#,##0.00"
              },
              {
                "name": "L_Total",
                "type": "computed",
                "bounds": {
                  "x": 14,
                  "y": 0,
                  "w": 4,
                  "h": 0.55
                },
                "style": {
                  "fontFamily": "Tahoma",
                  "fontSize": 9,
                  "foreColor": "#000000",
                  "backColor": "Transparent",
                  "hAlign": "right",
                  "vAlign": "top",
                  "paddingLeft": 0.1,
                  "paddingRight": 0.05
                },
                "expression": "LineTotal",
                "format": "#,##0.00"
              }
            ]
          }
        },
        {
          "name": "Sep",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 4.05,
            "w": 18,
            "h": 0.02
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "x1": 0,
          "y1": 4.05,
          "x2": 18,
          "y2": 4.05,
          "penWidth": 1,
          "penColor": "#B0B0B0",
          "penStyle": "solid"
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Tahoma",
            "fontSize": 10,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}