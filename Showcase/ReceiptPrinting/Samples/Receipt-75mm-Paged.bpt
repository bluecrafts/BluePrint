{
  "version": "1.0",
  "metadata": {
    "name": "Receipt-75mm-Paged",
    "description": "75 mm receipt (63.5 mm printable, dot matrix) on 200 mm pages, for very long documents. The order and the page number repeat on every page. Arguments: FromOrder, ToOrder, Lines.",
    "author": ""
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "Roll 75 mm (63.5 mm printable)",
        "widthMm": 63.5,
        "heightMm": 200
      },
      "orientation": "portrait",
      "margins": {
        "top": 0.2,
        "bottom": 0.3,
        "left": 0,
        "right": 0
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID AS OrderNo, {bp:DateText(o.OrderDate)} AS OrderDay,\n       c.CompanyName AS Customer, {bp:Concat(e.FirstName, ' ', e.LastName)} AS Salesperson,\n       k.ShipperID AS Pass,\n       p.ProductName AS ItemName, od.Quantity AS Qty, od.UnitPrice AS Price, od.Discount AS DiscountRate\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nCROSS JOIN Shippers k\nWHERE o.OrderID >= @FromOrder AND o.OrderID <= @ToOrder\nORDER BY Pass, OrderNo, ItemName\n{bp:Limit(@Lines)}",
    "arguments": [
      {
        "name": "FromOrder",
        "argType": "number"
      },
      {
        "name": "ToOrder",
        "argType": "number"
      },
      {
        "name": "Lines",
        "argType": "number"
      }
    ],
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "OrderDay",
        "dbType": "object"
      },
      {
        "name": "Customer",
        "dbType": "string"
      },
      {
        "name": "Salesperson",
        "dbType": "object"
      },
      {
        "name": "Pass",
        "dbType": "int64"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "Qty",
        "dbType": "int64"
      },
      {
        "name": "Price",
        "dbType": "decimal",
        "decimals": 4
      },
      {
        "name": "DiscountRate",
        "dbType": "decimal",
        "decimals": 4
      }
    ]
  },
  "sortColumns": [],
  "culture": "en-US",
  "sections": [
    {
      "type": "reportHeader",
      "height": 3,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "logo",
          "type": "image",
          "bounds": {
            "x": 2.42,
            "y": 0,
            "w": 1.5,
            "h": 1.5
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "imagePath": "BluePrintLogo.png",
          "sizeMode": "zoom",
          "imageDpi": 96,
          "grayscale": false,
          "showErrorImage": true
        },
        {
          "name": "shop",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1.65,
            "w": 6.35,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 14,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "text": "NORTHWIND TRADERS"
        },
        {
          "name": "subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 2.37,
            "w": 6.35,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "text": "Sample receipt (ESC/POS)"
        },
        {
          "name": "headRule",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 2.87,
            "w": 6.35,
            "h": 0
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "x1": 0,
          "y1": 2.87,
          "x2": 6.35,
          "y2": 2.87,
          "penWidth": 1,
          "penColor": "#000000",
          "penStyle": "dashed"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 1.05,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "order",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 4.06,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "expression": "If(Min(OrderNo for all) = Max(OrderNo for all), \"Order \" + String(Min(OrderNo for all)), \"Orders \" + String(Min(OrderNo for all)) + \" - \" + String(Max(OrderNo for all)))"
        },
        {
          "name": "page",
          "type": "computed",
          "bounds": {
            "x": 4.06,
            "y": 0,
            "w": 2.29,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        },
        {
          "name": "hNo",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.52,
            "w": 0.79,
            "h": 0.42
          },
          "style": {
