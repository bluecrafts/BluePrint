            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "text": "Amount"
        },
        {
          "name": "hRule",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 0.98,
            "w": 6.35,
            "h": 0
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "x1": 0,
          "y1": 0.98,
          "x2": 6.35,
          "y2": 0.98,
          "penWidth": 1,
          "penColor": "#000000",
          "penStyle": "dashed"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.42,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "no",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 0.79,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "Row()",
          "format": "#,##0"
        },
        {
          "name": "item",
          "type": "computed",
          "bounds": {
            "x": 0.88,
            "y": 0,
            "w": 3.18,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "expression": "If(Len(ItemName) > 22, Left(ItemName, 19) + \"...\", ItemName)"
        },
        {
          "name": "qty",
          "type": "field",
          "bounds": {
            "x": 4.06,
            "y": 0,
            "w": 0.7,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "source": "Qty",
          "format": "#,##0"
        },
        {
          "name": "amount",
          "type": "computed",
          "bounds": {
            "x": 4.76,
            "y": 0,
            "w": 1.59,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "Price * Qty * (1 - DiscountRate)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 3.85,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "totalRule",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 0.08,
            "w": 6.35,
            "h": 0
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "x1": 0,
          "y1": 0.08,
          "x2": 6.35,
          "y2": 0.08,
          "penWidth": 1,
          "penColor": "#000000",
          "penStyle": "dashed"
        },
        {
          "name": "subtotalLbl",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.18,
            "w": 3.18,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": "Subtotal"
        },
        {
          "name": "subtotal",
          "type": "computed",
          "bounds": {
            "x": 3.18,
            "y": 0.18,
            "w": 3.17,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "Sum(Price * Qty for all)",
          "format": "#,##0.00"
        },
        {
          "name": "discountLbl",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.6,
            "w": 3.18,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": "Discount"
        },
        {
          "name": "discount",
          "type": "computed",
          "bounds": {
            "x": 3.18,
            "y": 0.6,
            "w": 3.17,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "-Sum(Price * Qty * DiscountRate for all)",
          "format": "#,##0.00"
        },
        {
          "name": "totalLbl",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1.04,
            "w": 3.18,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": "TOTAL"
        },
        {
          "name": "total",
          "type": "computed",
          "bounds": {
            "x": 3.18,
            "y": 1.04,
            "w": 3.17,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "Sum(Price * Qty * (1 - DiscountRate) for all)",
          "format": "#,##0.00"
        },
        {
          "name": "items",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.62,
            "w": 6.35,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "expression": "String(Count(ItemName for all), \"#,##0\") + \" items\""
        },
        {
          "name": "barcode",
          "type": "barcode",
          "bounds": {
            "x": 0.97,
            "y": 2.15,
            "w": 4.4,
            "h": 1.1
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 7,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "expression": "String(Min(OrderNo for all))",
          "barcode": {
            "symbology": "code128",
            "showText": true,
            "rotation": "none",
            "dpi": 300,
            "encoding": "auto",
            "narrowToWideRatio": 2,
            "qrEcLevel": "m",
            "includeChecksum": false,
            "aztecEcPercent": 23,
            "dataMatrixRectangular": false
          }
        },
        {
          "name": "thanks",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 3.35,
            "w": 6.35,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "text": "Thank you. Please come again."
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.5,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "continued",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.05,
            "w": 6.35,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "italic": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "visibleExpression": "Page() < TotalPages()",
          "text": "Continued on next page"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}