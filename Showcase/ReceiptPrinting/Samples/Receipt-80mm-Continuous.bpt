          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.18,
            "w": 3.6,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": "Subtotal"
        },
        {
          "name": "subtotal",
          "type": "computed",
          "bounds": {
            "x": 3.6,
            "y": 0.18,
            "w": 3.6,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "Sum(Price * Qty for all)",
          "format": "#,##0.00"
        },
        {
          "name": "discountLbl",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.6,
            "w": 3.6,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": "Discount"
        },
        {
          "name": "discount",
          "type": "computed",
          "bounds": {
            "x": 3.6,
            "y": 0.6,
            "w": 3.6,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "-Sum(Price * Qty * DiscountRate for all)",
          "format": "#,##0.00"
        },
        {
          "name": "totalLbl",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 1.04,
            "w": 3.6,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": "TOTAL"
        },
        {
          "name": "total",
          "type": "computed",
          "bounds": {
            "x": 3.6,
            "y": 1.04,
            "w": 3.6,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "Sum(Price * Qty * (1 - DiscountRate) for all)",
          "format": "#,##0.00"
        },
        {
          "name": "items",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.62,
            "w": 7.2,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "expression": "String(Count(ItemName for all), \"#,##0\") + \" items\""
        },
        {
          "name": "qr",
          "type": "barcode",
          "bounds": {
            "x": 2.35,
            "y": 2.2,
            "w": 2.5,
            "h": 2
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 7,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "expression": "String(Min(OrderNo for all))",
          "barcode": {
            "symbology": "qrCode",
            "showText": false,
            "rotation": "none",
            "dpi": 300,
            "encoding": "auto",
            "narrowToWideRatio": 2,
            "qrEcLevel": "m",
            "includeChecksum": false,
            "aztecEcPercent": 23,
            "dataMatrixRectangular": false
          }
        },
        {
          "name": "thanks",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 4.35,
            "w": 7.2,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "text": "Thank you. Please come again."
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
