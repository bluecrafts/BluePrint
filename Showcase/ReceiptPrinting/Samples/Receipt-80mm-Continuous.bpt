    {
      "type": "detail",
      "height": 0.42,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "item",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 3.4,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "expression": "If(Len(ItemName) > 24, Left(ItemName, 21) + \"...\", ItemName)"
        },
        {
          "name": "qty",
          "type": "field",
          "bounds": {
            "x": 3.4,
            "y": 0,
            "w": 0.7,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "source": "Qty",
          "format": "#,##0"
        },
        {
          "name": "price",
          "type": "field",
          "bounds": {
            "x": 4.1,
            "y": 0,
            "w": 1.4,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "source": "Price",
          "format": "#,##0.00"
        },
        {
          "name": "amount",
          "type": "computed",
          "bounds": {
            "x": 5.5,
            "y": 0,
            "w": 1.7,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "Price * Qty * (1 - DiscountRate)",
          "format": "#,##0.00"
        }
      ]
