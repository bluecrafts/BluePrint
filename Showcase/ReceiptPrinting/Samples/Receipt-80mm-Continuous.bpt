{
  "version": "1.0",
  "metadata": {
    "name": "Receipt-80mm-Continuous",
    "description": "80 mm receipt (72 mm printable), one continuous page as long as the data. One line per item. Arguments: FromOrder, ToOrder, Lines.",
    "author": ""
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "Roll 80 mm (72 mm printable)",
        "widthMm": 72,
        "heightMm": 200
      },
      "orientation": "portrait",
      "margins": {
        "top": 0.2,
        "bottom": 0.3,
        "left": 0,
        "right": 0
      },
      "backgroundColor": "#FFFFFF",
      "heightMode": "continuous"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID AS OrderNo, {bp:DateText(o.OrderDate)} AS OrderDay,\n       c.CompanyName AS Customer, {bp:Concat(e.FirstName, ' ', e.LastName)} AS Salesperson,\n       k.ShipperID AS Pass,\n       p.ProductName AS ItemName, od.Quantity AS Qty, od.UnitPrice AS Price, od.Discount AS DiscountRate\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nCROSS JOIN Shippers k\nWHERE o.OrderID >= @FromOrder AND o.OrderID <= @ToOrder\nORDER BY Pass, OrderNo, ItemName\n{bp:Limit(@Lines)}",
    "arguments": [
      {
        "name": "FromOrder",
        "argType": "number"
      },
      {
        "name": "ToOrder",
        "argType": "number"
      },
      {
        "name": "Lines",
        "argType": "number"
      }
    ],
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "OrderDay",
        "dbType": "object"
      },
      {
        "name": "Customer",
        "dbType": "string"
      },
      {
        "name": "Salesperson",
        "dbType": "object"
      },
      {
        "name": "Pass",
        "dbType": "int64"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "Qty",
        "dbType": "int64"
      },
      {
        "name": "Price",
        "dbType": "decimal",
        "decimals": 4
      },
      {
        "name": "DiscountRate",
        "dbType": "decimal",
        "decimals": 4
      }
    ]
  },
  "sortColumns": [],
  "culture": "en-US",
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "shop",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 7.2,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 14,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "text": "NORTHWIND TRADERS"
        },
        {
          "name": "subtitle",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.72,
            "w": 7.2,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "text": "Sample receipt (ESC/POS)"
        },
        {
          "name": "headRule",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 1.22,
            "w": 7.2,
            "h": 0
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "x1": 0,
          "y1": 1.22,
          "x2": 7.2,
          "y2": 1.22,
          "penWidth": 1,
          "penColor": "#000000",
          "penStyle": "dashed"
        },
        {
          "name": "order",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.32,
            "w": 7.2,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "expression": "If(Min(OrderNo for all) = Max(OrderNo for all), \"Order \" + String(Min(OrderNo for all)), \"Orders \" + String(Min(OrderNo for all)) + \" - \" + String(Max(OrderNo for all)))"
        },
        {
          "name": "orderDay",
          "type": "computed",
          "bounds": {
            "x": 4.464,
            "y": 1.32,
            "w": 2.736,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top"
          },
          "expression": "If(Min(OrderNo for all) = Max(OrderNo for all), OrderDay, \"\")"
        },
        {
          "name": "customer",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.8,
            "w": 7.2,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "expression": "If(Min(OrderNo for all) = Max(OrderNo for all), \"Customer  \" + Customer, \"Several orders on one receipt\")"
        },
        {
          "name": "sales",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 2.22,
            "w": 7.2,
            "h": 0.42
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "expression": "If(Min(OrderNo for all) = Max(OrderNo for all), \"Sales  \" + Salesperson, String(Count(ItemName for all), \"#,##0\") + \" lines\")"
        },
        {
          "name": "orderRule",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 2.72,
            "w": 7.2,
            "h": 0
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 8,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "x1": 0,
          "y1": 2.72,
          "x2": 7.2,
          "y2": 2.72,
          "penWidth": 1,
          "penColor": "#000000",
          "penStyle": "dashed"
        }
      ]
