<Window x:Class="ReceiptPrinting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BluePrint.UI.Controls;assembly=BluePrint.UI"
        xmlns:bh="clr-namespace:BluePrint.UI.Behaviors;assembly=BluePrint.UI"
        xmlns:local="clr-namespace:ReceiptPrinting"
        xmlns:views="clr-namespace:ReceiptPrinting.Views"
        xmlns:rw="clr-namespace:BluePrint.Render.WPF.Controls;assembly=BluePrint.Render.WPF"
        Title="ReceiptPrinting" Width="1440" Height="900" MinWidth="1100" MinHeight="640">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The theme's toolbar buttons are sized for 16 px icons (a fixed button
                 height). These carry 24 px icons: let the height follow the icon, with
                 the same padding on every side, for square 34 x 34 buttons. -->
            <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button"
                   BasedOn="{StaticResource Bp.Button.Toolbar}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Padding" Value="4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open"       Executed="OpenForm_Executed"     CanExecute="NotBusy_CanExecute" />
        <CommandBinding Command="local:AppCommands.Retrieve"     Executed="Retrieve_Executed"     CanExecute="CanRetrieve_CanExecute" />
        <CommandBinding Command="local:AppCommands.Print"        Executed="Print_Executed"        CanExecute="CanPrint_CanExecute" />
        <CommandBinding Command="local:AppCommands.SaveCommands" Executed="SaveCommands_Executed" CanExecute="CanPrint_CanExecute" />
        <CommandBinding Command="local:AppCommands.Stop"         Executed="Stop_Executed"         CanExecute="CanStop_CanExecute" />
        <CommandBinding Command="local:AppCommands.ZoomIn"       Executed="ZoomIn_Executed" />
        <CommandBinding Command="local:AppCommands.ZoomOut"      Executed="ZoomOut_Executed" />
        <CommandBinding Command="ApplicationCommands.Find"       Executed="Find_Executed" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Form..." Command="ApplicationCommands.Open"
                          ToolTip="Open a receipt form (.bpt) that is not in the Samples folder" />
                <MenuItem Header="Open Samples _Folder" Click="OpenSamplesFolder_Click"
                          ToolTip="Show the Samples folder in File Explorer. Put your own forms there, then Refresh Forms." />
                <MenuItem Header="_Refresh Forms" Click="RefreshForms_Click"
                          ToolTip="Read the Samples folder again" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem Header="_Retrieve" Command="local:AppCommands.Retrieve"
                          ToolTip="Read the selected document from the Northwind database again" />
            </MenuItem>
            <MenuItem Header="_Print">
                <MenuItem Header="_Print" Command="local:AppCommands.Print" />
                <MenuItem Header="_Stop" Command="local:AppCommands.Stop" />
                <MenuItem Header="Save _Commands..." Command="local:AppCommands.SaveCommands"
                          ToolTip="Save the bytes that would be sent to the printer in a file" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" Command="local:AppCommands.ZoomIn" />
                <MenuItem Header="Zoom _Out" Command="local:AppCommands.ZoomOut" />
                <Separator />
                <MenuItem x:Name="LeftPanelMenuItem" Header="_Left Panel" IsCheckable="True" IsChecked="True"
                          Click="PanelMenuItem_Click" ToolTip="Show or hide the panel on the left: Forms and Documents" />
                <MenuItem x:Name="RightPanelMenuItem" Header="_Right Panel" IsCheckable="True" IsChecked="True"
                          Click="PanelMenuItem_Click" ToolTip="Show or hide the panel on the right: Printer Profile and Print" />
                <!-- Theme > Light / Dark / System is added here by MainWindow.xaml.cs -->
                <Separator x:Name="ThemeSeparator" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About ReceiptPrinting" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Icon buttons, 24 x 24 (Views/Icons.xaml). The name of each button is in its
             tooltip and its automation name, shown on a disabled button too. -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="DocumentToolBar" Band="0" BandIndex="0">
                <Button Command="ApplicationCommands.Open" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Open Form (Ctrl+O)" AutomationProperties.Name="Open Form">
                    <Path Data="{StaticResource Icon.Open}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Button Command="local:AppCommands.Retrieve" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Retrieve"
                        ToolTip="Retrieve: read the selected document from the Northwind database again (Ctrl+R)">
                    <Path Data="{StaticResource Icon.Retrieve}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
            </ToolBar>

            <ToolBar x:Name="PrinterToolBar" Band="0" BandIndex="1">
                <TextBlock Text="Profile" VerticalAlignment="Center" Margin="4,0,6,0" />
                <!-- The same profile as the combo box in the Printer Profile panel: choosing
                     one in either place changes both. -->
                <ComboBox x:Name="ProfileBox" Width="260" DisplayMemberPath="Name"
                          SelectionChanged="ProfileBox_SelectionChanged" ToolTipService.ShowOnDisabled="True"
                          ToolTip="The printer to print to" AutomationProperties.Name="Profile" />
                <Separator />
                <Button Command="local:AppCommands.Print" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Print (Ctrl+P)" AutomationProperties.Name="Print">
                    <Path Data="{StaticResource Icon.Print}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Button Command="local:AppCommands.Stop" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Stop printing (Esc)" AutomationProperties.Name="Stop">
                    <Path Data="{StaticResource Icon.Stop}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Margin="0,0,8,0">
                <TextBlock x:Name="StatusProfileText" Foreground="{DynamicResource Bp.Brush.Text.Secondary}" />
            </StatusBarItem>
            <StatusBarItem>
                <!-- The last thing that happened. There is no log panel: each message
                     replaces the one before, and the full text is in the tooltip. -->
                <StackPanel x:Name="StatusPanel" Orientation="Horizontal">
                    <ui:BpStatusIcon x:Name="StatusIcon" Kind="Information" AlignToTextBaseline="True"
                                     Margin="0,0,6,0" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Top"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Left to right, what the user does: choose a form, choose a document, see the
             1-bit image the printer will get, set up the printer and print. One page,
             no tabs: there is nothing to design. Kept off the window's left and right
             edges, so the panels do not touch the frame. -->
        <Grid Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left: the forms above, the documents below -->
            <Grid x:Name="LeftPane" Background="{DynamicResource Bp.Brush.Surface.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                            MinHeight="{DynamicResource Bp.Size.Header.Height}">
                        <TextBlock Text="Forms" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                    </Border>
                    <Grid>
                        <!-- Grouped by paper width (MainWindow.Forms.cs). One click opens the form
                             and reads the selected document into it again. -->
                        <ListBox x:Name="FormsList" BorderThickness="0" SelectionChanged="FormsList_SelectionChanged"
                                 AutomationProperties.Name="Forms">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource Bp.Text.Caption}" Margin="4,8,4,2" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:FormEntry}">
                                    <StackPanel Margin="8,2,4,2" ToolTip="{Binding Path}">
                                        <TextBlock x:Name="FormName" Text="{Binding Name}" />
                                        <StackPanel Orientation="Horizontal">
                                            <ui:BpStatusIcon x:Name="FormError" Kind="Error" AlignToTextBaseline="True" Margin="0,0,4,0"
                                                             Visibility="Collapsed" TextElement.FontSize="{DynamicResource Bp.Font.Size.Caption}" />
                                            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Bp.Text.Caption}" VerticalAlignment="Top" />
                                        </StackPanel>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                            <Setter TargetName="FormName" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanRead}" Value="False">
                                            <Setter TargetName="FormError" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoFormsText" Text="No forms in the Samples folder. File > Open Form..."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                                   TextWrapping="Wrap" TextAlignment="Center" Style="{DynamicResource Bp.Text.Caption}" />
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Bp.Brush.Border.Default}" />

                <DockPanel Grid.Row="2">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                            MinHeight="{DynamicResource Bp.Size.Header.Height}">
                        <TextBlock Text="Documents" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                    </Border>
                    <TextBox x:Name="DocumentSearchBox" DockPanel.Dock="Top" Margin="8,8,8,4"
                             bh:BpInput.Placeholder="Search documents" TextChanged="DocumentSearchBox_TextChanged"
                             ToolTip="Show only the documents whose name contains this text (Ctrl+F)"
                             AutomationProperties.Name="Search documents" />
                    <TextBlock x:Name="DocumentCountText" DockPanel.Dock="Bottom" Margin="8,4,8,8"
                               Style="{DynamicResource Bp.Text.Caption}" />
                    <Grid Margin="8,0,8,0">
                        <!-- One click reads the document into the selected form; Enter or a
                             double click reads it again (MainWindow.Documents.cs).
                             Lines and Total have fixed widths: Auto would size them to the "..." shown
                             before the database is read, and keep them that narrow. -->
                        <DataGrid x:Name="DocumentsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" SelectionMode="Single" CanUserSortColumns="False"
                                  SelectionChanged="DocumentsGrid_SelectionChanged"
                                  MouseDoubleClick="DocumentsGrid_MouseDoubleClick" PreviewKeyDown="DocumentsGrid_PreviewKeyDown"
                                  AutomationProperties.Name="Documents">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource Bp.Text.Caption}" Margin="4,6,4,2" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.RowStyle>
                                <!-- The theme sets RowStyle to Bp.DataGridRow: build on it, or the rows lose the theme -->
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource Bp.DataGridRow}">
                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Document" Width="*" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Lines" Width="56" Binding="{Binding LinesText}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total" Width="80" Binding="{Binding TotalText}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- northwind.db missing or unreadable: the forms still open, without data -->
                        <StackPanel x:Name="NoDatabasePanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="12" Visibility="Collapsed">
                            <ui:BpStatusIcon Kind="Error" AlignToTextBaseline="True" Margin="0,0,6,0"
                                             TextElement.FontSize="{DynamicResource Bp.Font.Size.Caption}" />
                            <TextBlock x:Name="NoDatabaseText" TextWrapping="Wrap" MaxWidth="220" VerticalAlignment="Top"
                                       Style="{DynamicResource Bp.Text.Caption}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" x:Name="LeftSplitter" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Bp.Brush.Border.Default}" />

            <!-- Centre: the 1-bit image the printer gets, dot for dot: BluePrintMonochromeView of
                 BluePrint.Render.WPF. A continuous form is one long page. The strip above it says
                 how much paper the receipt takes - for a receipt that is the number that matters -
                 and shows that a new image is on its way while the old one stays in view. -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Alt}" Padding="8,4"
                        BorderBrush="{DynamicResource Bp.Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel x:Name="BusyPanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock x:Name="BusyText" Style="{DynamicResource Bp.Text.Caption}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ProgressBar Width="96" Height="8" IsIndeterminate="True" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="PaperText" Style="{DynamicResource Bp.Text.Caption}" VerticalAlignment="Center"
                                   ToolTip="Paper the receipt takes, from the top of the first page to the bottom of the last" />
                    </DockPanel>
                </Border>
                <rw:BluePrintMonochromeView x:Name="Monochrome" />
            </DockPanel>

            <GridSplitter Grid.Column="3" x:Name="RightSplitter" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Bp.Brush.Border.Default}" />

            <!-- Right: the printer profile above (saved as soon as a field changes),
                 the print settings and the job pinned below -->
            <DockPanel Grid.Column="4" x:Name="RightPane" Background="{DynamicResource Bp.Brush.Surface.Panel}">
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                            MinHeight="{DynamicResource Bp.Size.Header.Height}">
                        <TextBlock Text="Print" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,8,12,12">
                        <TextBlock x:Name="PrintSummary" TextTrimming="CharacterEllipsis" />
                        <ui:BpStatusLines x:Name="PrintChecks" Margin="0,8,0,0" />

                        <!-- What this job prints. Not saved: the copies start from the profile's. -->
                        <StackPanel x:Name="JobSettings" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AllPagesRadio" Content="All pages" GroupName="Range" IsChecked="True"
                                             VerticalAlignment="Center" Checked="JobSettings_Changed" />
                                <RadioButton x:Name="RangeRadio" Content="Pages" GroupName="Range" Margin="12,0,0,0"
                                             VerticalAlignment="Center" Checked="JobSettings_Changed"
                                             ToolTipService.ShowOnDisabled="True" />
                                <TextBox x:Name="RangeBox" MinWidth="80" Margin="8,0,0,0" TextChanged="JobSettings_Changed"
                                         AutomationProperties.Name="Pages" ToolTip="Use page numbers and ranges, for example 1-3,5." />
                                <ui:BpStatusIcon x:Name="RangeErrorIcon" Kind="Error" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Visibility="Collapsed" ToolTip="Use page numbers and ranges, for example 1-3,5." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Copies" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="PrintCopiesBox" MinWidth="64" Text="1" TextChanged="JobSettings_Changed"
                                         AutomationProperties.Name="Copies" ToolTip="Copies of the receipt, 1 to 99. Not saved in the profile." />
                                <ui:BpStatusIcon x:Name="CopiesErrorIcon" Kind="Error" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Visibility="Collapsed" ToolTip="Enter a number from 1 to 99." />
                            </StackPanel>
                        </StackPanel>

                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Stop" Margin="6,0,0,0" Command="local:AppCommands.Stop"
                                    ToolTip="Stop printing (Esc)" />
                            <Button x:Name="PrintButton" Content="Print" Style="{DynamicResource Bp.Button.Primary}"
                                    Command="local:AppCommands.Print" ToolTip="Print (Ctrl+P)" ToolTipService.ShowOnDisabled="True" />
                        </DockPanel>

                        <!-- While a job runs: bytes, because a continuous receipt is one page of megabytes -->
                        <StackPanel x:Name="JobProgressPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <ProgressBar x:Name="JobProgress" Height="8" Maximum="1" />
                            <TextBlock x:Name="JobProgressText" Margin="0,4,0,0" Style="{DynamicResource Bp.Text.Caption}" />
                        </StackPanel>
                        <ui:BpStatusLines x:Name="LastJobLines" Banner="True" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                        MinHeight="{DynamicResource Bp.Size.Header.Height}">
                    <TextBlock Text="Printer Profile" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                </Border>
                <!-- Views/PrinterProfilePanel: the groups scroll, the buttons above them stay -->
                <views:PrinterProfilePanel x:Name="ProfilePanel" />
            </DockPanel>
        </Grid>
    </DockPanel>

</Window>
