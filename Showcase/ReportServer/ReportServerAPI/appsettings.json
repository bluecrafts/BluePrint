{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://*:5081",
  "ReportServer": {
    "Database": "northwind.db",
    "Reports": "Reports",
    "Fonts": "fonts",
    "CacheSize": 32,
    "CacheMinutes": 20,
    "MaxConcurrentRenders": 4,
    "RenderTimeoutSeconds": 120
  }
}
