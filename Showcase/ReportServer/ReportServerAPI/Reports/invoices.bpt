{
  "version": "1.0",
  "metadata": {
    "name": "Invoices",
    "description": "One invoice per order of the period: who bought what, the totals, a Code 128 barcode of the invoice number and a QR code to pay with.",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID AS InvoiceNo, o.CustomerID AS CustomerCode, c.CompanyName AS CustomerName,\n       c.Address AS BillAddress, c.City AS BillCity, c.PostalCode AS BillPostal, c.Country AS BillCountry,\n       o.ShipName AS ShipToName, o.ShipAddress AS ShipToAddress, o.ShipCity AS ShipToCity,\n       o.ShipPostalCode AS ShipToPostal, o.ShipCountry AS ShipToCountry,\n       {bp:DateText(o.OrderDate)} AS OrderDay, {bp:DateText(o.RequiredDate)} AS DueDay,\n       {bp:Concat(e.FirstName, ' ', e.LastName)} AS SalesPerson, sh.CompanyName AS ShipperName,\n       o.Freight AS FreightCost,\n       od.ProductID AS ItemCode, p.ProductName AS ItemName, p.QuantityPerUnit AS ItemUnit,\n       od.UnitPrice AS Price, od.Quantity AS Qty, od.Discount AS Disc\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN Shippers sh ON sh.ShipperID = o.ShipVia\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nWHERE {bp:DateText(o.OrderDate)} >= {bp:DateText(@FromDate)}\n  AND {bp:DateText(o.OrderDate)} <= {bp:DateText(@ToDate)}\n  AND (@CustomerId = '*' OR o.CustomerID = @CustomerId)\nORDER BY InvoiceNo, ItemName",
    "arguments": [
      {
        "name": "FromDate",
        "argType": "date"
      },
      {
        "name": "ToDate",
        "argType": "date"
      },
      {
        "name": "CustomerId",
        "argType": "string"
      }
    ],
    "columns": [
      {
        "name": "InvoiceNo",
        "dbType": "int64"
      },
      {
        "name": "CustomerCode",
        "dbType": "string"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "BillAddress",
        "dbType": "string"
      },
      {
        "name": "BillCity",
        "dbType": "string"
      },
      {
        "name": "BillPostal",
        "dbType": "string"
      },
      {
        "name": "BillCountry",
        "dbType": "string"
      },
      {
        "name": "ShipToName",
        "dbType": "string"
      },
      {
        "name": "ShipToAddress",
        "dbType": "string"
      },
      {
        "name": "ShipToCity",
        "dbType": "string"
      },
      {
        "name": "ShipToPostal",
        "dbType": "string"
      },
      {
        "name": "ShipToCountry",
        "dbType": "string"
      },
      {
        "name": "OrderDay",
        "dbType": "object"
      },
      {
        "name": "DueDay",
        "dbType": "object"
      },
      {
        "name": "SalesPerson",
        "dbType": "object"
      },
      {
        "name": "ShipperName",
        "dbType": "string"
      },
      {
        "name": "FreightCost",
        "dbType": "decimal",
        "decimals": 4
      },
      {
        "name": "ItemCode",
        "dbType": "int64"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "ItemUnit",
        "dbType": "string"
      },
      {
        "name": "Price",
        "dbType": "decimal",
        "decimals": 4
      },
      {
        "name": "Qty",
        "dbType": "int64"
      },
      {
        "name": "Disc",
        "dbType": "decimal",
        "decimals": 4
      }
    ]
  },
  "sortColumns": [],
