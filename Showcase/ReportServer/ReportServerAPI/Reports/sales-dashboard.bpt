{
  "version": "1.0",
  "metadata": {
    "name": "Sales Dashboard",
    "description": "The period in charts - sales by month, by category and by employee - followed by every product sold, with its share of the period.",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT cat.CategoryName AS CategoryLabel, p.ProductName AS ItemName, e.LastName AS EmpName,\n       o.OrderID AS OrderNo, {bp:DateText(o.OrderDate)} AS OrderDay,\n       od.Quantity AS Qty, od.UnitPrice AS Price, od.Discount AS Disc\nFROM Orders o\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nJOIN Categories cat ON cat.CategoryID = p.CategoryID\nWHERE {bp:DateText(o.OrderDate)} >= {bp:DateText(@FromDate)}\n  AND {bp:DateText(o.OrderDate)} <= {bp:DateText(@ToDate)}\n  AND (@Country = '*' OR c.Country = @Country)\nORDER BY CategoryLabel, ItemName, OrderNo",
    "arguments": [
      {
        "name": "FromDate",
        "argType": "date"
      },
      {
        "name": "ToDate",
        "argType": "date"
      },
      {
        "name": "Country",
        "argType": "string"
      }
    ],
    "columns": [
      {
        "name": "CategoryLabel",
        "dbType": "string"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "EmpName",
        "dbType": "string"
      },
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "OrderDay",
        "dbType": "object"
      },
      {
        "name": "Qty",
        "dbType": "int64"
      },
      {
        "name": "Price",
        "dbType": "decimal"
      },
      {
        "name": "Disc",
        "dbType": "decimal"
      }
    ]
  },
  "sortColumns": [],
  "localization": {
    "sourceLanguage": "en",
    "languages": [
      "en"
    ],
    "cultures": {
      "en": "en-US"
    }
  },
  "sections": [
    {
      "type": "reportHeader",
      "height": 17.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AccentBar",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.12
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 2,
            "foreColor": "#1F5FAD",
            "backColor": "#1F5FAD",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": ""
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Sales Dashboard"
        },
        {
          "name": "Subtitle",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.25,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Sales from \" + String(@FromDate, \"d MMMM yyyy\") + \" to \" + String(@ToDate, \"d MMMM yyyy\") + Iif(@Country = \"*\", \"\", \", customers in \" + @Country)"
        },
        {
          "name": "Kpi",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 2,
            "w": 18,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F5FAD",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(OrderNo for all distinct OrderNo) + \" orders  -  \" + String(Sum(Qty for all), \"#,##0\") + \" units  -  \" + String(Sum(Price * Qty * (1 - Disc) for all), \"#,##0.00\") + \" in sales\""
        },
        {
          "name": "DailyChart",
          "type": "chart",
          "bounds": {
            "x": 0,
            "y": 3,
            "w": 18,
            "h": 6.6
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 8.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "chart": {
            "chartType": "column",
            "title": "Sales by month",
            "dataSet": "",
            "category": [
              {
                "expression": "Left(OrderDay, 7)"
              }
            ],
            "seriesGroup": [],
            "values": [
              {
                "expression": "Price * Qty * (1 - Disc)",
                "aggregate": "sum",
                "name": "Sales",
                "format": "#,##0",
                "axisIndex": 0
              }
            ],
            "reduction": {
              "maxCategories": 40,
              "onExceed": "warn",
              "othersLabel": "Other",
              "sort": "categoryAsc",
              "hardLimit": 5000,
              "downsample": false,
              "downsampleTarget": 0
            },
            "categoryAxis": {
              "title": "Month",
              "scaleType": "auto",
              "visible": true,
              "showGridLines": false,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "valueAxis": {
              "scaleType": "auto",
              "format": "#,##0",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "secondaryValueAxis": {
              "scaleType": "auto",
              "visible": true,
              "showGridLines": true,
              "labelInterval": 0,
              "labelAngle": 0
            },
            "legend": {
              "visible": false,
              "position": "right"
            },
            "style": {
              "palette": "custom",
              "customColors": [
                "#1F5FAD",
                "#4C8BD6",
                "#8FB8E8",
                "#F2A541",
                "#5BAE7A",
                "#C75C5C",
                "#8C6BB1",
                "#7F8C99",
                "#D17FA8",
                "#3B9C9C"
              ],
              "fontFamily": "Inter",
              "titleFontPt": 11,
              "labelFontPt": 8,
              "foreColor": "#1F2937",
              "gridLineColor": "#E3E7EC",
              "axisLineColor": "#B8C2CC",
              "plotBackColor": "Transparent",
              "showDataLabels": false,
              "barGapRatio": 0.2,
              "doughnutHoleRatio": 0.5
            }
          }
        },
        {
