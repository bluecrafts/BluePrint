    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "CategoryLabel"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.9,
      "repeatOnNewPage": false,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CatHead",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.15,
            "w": 12,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 12.5,
            "bold": true,
            "foreColor": "#1F5FAD",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "CategoryLabel"
        },
        {
          "name": "CatProducts",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.3,
            "w": 6,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(ItemName for group 1 distinct ItemName) + \" product(s)\""
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 2,
      "groupByColumns": [
        "ItemName"
      ],
      "height": 0,
      "repeatOnNewPage": false,
      "backColor": "Transparent",
      "elements": []
    },
    {
      "type": "detail",
      "height": 0,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": []
    },
    {
      "type": "groupFooter",
      "groupLevel": 2,
      "groupByColumns": [
        "ItemName"
      ],
      "height": 0.65,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "ProdName",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 8.4,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "ItemName"
        },
        {
          "name": "ProdOrders",
          "type": "computed",
          "bounds": {
            "x": 8.4,
            "y": 0,
            "w": 2,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Count(OrderNo for group 2 distinct OrderNo)",
          "format": "#,##0"
        },
        {
          "name": "ProdQty",
          "type": "computed",
          "bounds": {
            "x": 10.4,
            "y": 0,
            "w": 2,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Sum(Qty for group 2)",
          "format": "#,##0"
        },
        {
          "name": "ProdAmount",
          "type": "computed",
          "bounds": {
            "x": 12.4,
            "y": 0,
            "w": 3.4,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Sum(Price * Qty * (1 - Disc) for group 2)",
          "format": "#,##0.00"
        },
        {
          "name": "ProdShare",
          "type": "computed",
          "bounds": {
            "x": 15.8,
            "y": 0,
            "w": 2.2,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Sum(Price * Qty * (1 - Disc) for group 2) / Sum(Price * Qty * (1 - Disc) for all) * 100",
          "format": "0.0\"%\""
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "groupByColumns": [
        "CategoryLabel"
      ],
      "height": 0.9,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CatText",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.15,
            "w": 8.4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Total \" + CategoryLabel"
        },
        {
          "name": "CatOrders",
          "type": "computed",
          "bounds": {
            "x": 8.4,
            "y": 0.15,
            "w": 2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Inter",
            "fontSize": 9.5,
