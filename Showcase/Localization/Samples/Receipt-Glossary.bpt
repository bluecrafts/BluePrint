      "groupByColumns": [
        "OrderNo"
      ],
      "height": 2.6,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "cItemsCount",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 6,
            "h": 0.5
          },
