          "type": "field",
          "bounds": {
            "x": 8.2,
            "y": 0,
            "w": 2.2,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 8.5,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.1
          },
          "source": "Price",
          "format": "#,##0.00"
        },
        {
          "name": "cAmount",
          "type": "computed",
          "bounds": {
            "x": 10.4,
            "y": 0,
            "w": 2,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 8.5,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.1
          },
          "expression": "[Price] * [Qty] * (1 - [DiscountRate])",
          "format": "#,##0.00"
        },
        {
          "name": "ruleRow",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 0.5,
            "w": 12.4,
