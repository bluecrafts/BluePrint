            "fontSize": 9,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "Tr(\"items_count\", Count(ItemName for group 1))"
        },
        {
          "name": "lblFreight",
          "type": "computed",
          "bounds": {
            "x": 6,
            "y": 0.2,
            "w": 4.4,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle"
          },
          "expression": "Tr(\"invoice.freight\")"
        },
        {
          "name": "fFreight",
          "type": "field",
          "bounds": {
            "x": 10.4,
            "y": 0.2,
            "w": 2,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle"
          },
          "source": "FreightCost",
          "format": "#,##0.00"
        },
        {
          "name": "lblTotal",
          "type": "computed",
          "bounds": {
            "x": 6,
            "y": 0.7,
            "w": 4.4,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle"
          },
          "expression": "Tr(\"common.total_usd\")"
        },
        {
          "name": "cTotal",
          "type": "computed",
          "bounds": {
            "x": 10.4,
            "y": 0.7,
            "w": 2,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle"
          },
          "expression": "Sum([Price] * [Qty] * (1 - [DiscountRate]) for group 1) + [FreightCost]",
          "format": "#,##0.00"
        },
        {
          "name": "lblCurrencyNote",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.7,
            "w": 6,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 8,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "Tr(\"common.currency_note\")"
        },
        {
          "name": "cThankYou",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.8,
            "w": 12.4,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#1F5FAD",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "Tr(\"thank_you\", [Customer])"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 0,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": []
    },
    {
      "type": "pageFooter",
      "height": 0.55,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "cLanguage",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 6,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 7.5,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "Tr(\"rendered_in\", Language())"
        },
        {
          "name": "cPage",
          "type": "computed",
          "bounds": {
            "x": 6,
            "y": 0.1,
            "w": 6.4,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 7.5,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle"
          },
          "expression": "Tr(\"page_of\", Page(), GroupTotalPages())"
        }
      ]
    }
  ],
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}