{
  "version": "1.0",
  "metadata": {
    "name": "Receipt-Glossary",
    "description": "A short A5 receipt that uses the shared glossary of Invoice-Glossary. Arguments: FromOrder, ToOrder.",
    "author": ""
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A5",
        "widthMm": 148,
        "heightMm": 210
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.2,
        "bottom": 1,
        "left": 1.2,
        "right": 1.2
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID AS OrderNo, {bp:DateText(o.OrderDate)} AS OrderedOn, o.Freight AS FreightCost,\n       c.CompanyName AS Customer, c.Address AS CustAddress, c.City AS CustCity,\n       c.PostalCode AS CustPostalCode, c.Country AS CustCountry,\n       s.CompanyName AS ShipperName, {bp:Concat(e.FirstName, ' ', e.LastName)} AS Salesperson,\n       p.ProductName AS ItemName, od.Quantity AS Qty, od.UnitPrice AS Price, od.Discount AS DiscountRate\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN Shippers  s ON s.ShipperID  = o.ShipVia\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nWHERE o.OrderID >= @FromOrder AND o.OrderID <= @ToOrder\nORDER BY OrderNo, ItemName",
    "arguments": [
      {
        "name": "FromOrder",
        "argType": "number"
      },
      {
        "name": "ToOrder",
        "argType": "number"
      }
    ],
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "OrderedOn",
        "dbType": "object"
      },
      {
        "name": "FreightCost",
        "dbType": "decimal",
        "decimals": 4
      },
      {
        "name": "Customer",
        "dbType": "string"
      },
      {
        "name": "CustAddress",
        "dbType": "string"
      },
      {
        "name": "CustCity",
        "dbType": "string"
      },
      {
        "name": "CustPostalCode",
        "dbType": "string"
      },
      {
        "name": "CustCountry",
        "dbType": "string"
      },
      {
        "name": "ShipperName",
        "dbType": "string"
      },
      {
        "name": "Salesperson",
        "dbType": "object"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "Qty",
        "dbType": "int64"
      },
      {
        "name": "Price",
        "dbType": "decimal",
        "decimals": 4
      },
      {
        "name": "DiscountRate",
        "dbType": "decimal",
        "decimals": 4
      }
    ]
  },
  "sortColumns": [],
  "culture": "en-US",
  "localization": {
    "sourceLanguage": "en",
    "languages": [
      "en",
      "de",
      "ja",
      "ko",
      "th",
      "lo",
      "zh"
    ],
    "cultures": {
      "en": "en-US",
      "de": "de-DE",
      "ja": "ja-JP",
      "ko": "ko-KR",
      "th": "th-TH",
      "lo": "lo-LA",
      "zh": "zh-CN"
    },
    "strings": {
      "invoice.title": {
        "en": "INVOICE / RECEIPT"
      },
      "invoice.paid": {
        "en": "PAID"
      },
      "common.date": {
        "en": "Date"
      },
      "common.no": {
        "en": "No."
      },
      "common.product": {
        "en": "Product"
      },
      "common.qty": {
        "en": "Qty"
      },
      "common.unit_price": {
        "en": "Unit price"
      },
      "common.amount": {
        "en": "Amount"
      },
      "invoice.freight": {
        "en": "Freight"
      },
      "common.total_usd": {
        "en": "Total (USD)"
      },
      "common.currency_note": {
        "en": "All amounts in US dollars."
      },
      "items_count": {
        "en": "{0} items"
      },
      "thank_you": {
        "en": "Thank you for your order, {0}."
      },
      "page_of": {
        "en": "Page {0} of {1}"
      },
      "rendered_in": {
        "en": "Language: {0}"
      }
    },
    "fonts": {
      "ja": [
        {
          "from": "Leelawadee UI",
          "to": "Yu Gothic UI"
        }
      ],
      "ko": [
        {
          "from": "Leelawadee UI",
          "to": "Malgun Gothic"
        }
      ],
      "zh": [
        {
          "from": "Leelawadee UI",
          "to": "Microsoft YaHei UI"
        }
      ]
    }
  },
  "sections": [
