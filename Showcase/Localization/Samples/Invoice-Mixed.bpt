{
  "version": "1.0",
  "metadata": {
    "name": "Invoice-Mixed",
    "description": "German and Thai are inside the report. Japanese, Korean, Lao and Chinese come from files, and a Thai file replaces three terms. Arguments: FromOrder, ToOrder.",
    "author": ""
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.2,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT o.OrderID AS OrderNo, {bp:DateText(o.OrderDate)} AS OrderedOn, o.Freight AS FreightCost,\n       c.CompanyName AS Customer, c.Address AS CustAddress, c.City AS CustCity,\n       c.PostalCode AS CustPostalCode, c.Country AS CustCountry,\n       s.CompanyName AS ShipperName, {bp:Concat(e.FirstName, ' ', e.LastName)} AS Salesperson,\n       p.ProductName AS ItemName, od.Quantity AS Qty, od.UnitPrice AS Price, od.Discount AS DiscountRate\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Employees e ON e.EmployeeID = o.EmployeeID\nJOIN Shippers  s ON s.ShipperID  = o.ShipVia\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nWHERE o.OrderID >= @FromOrder AND o.OrderID <= @ToOrder\nORDER BY OrderNo, ItemName",
    "arguments": [
      {
        "name": "FromOrder",
        "argType": "number"
      },
      {
        "name": "ToOrder",
        "argType": "number"
      }
    ],
    "columns": [
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "OrderedOn",
        "dbType": "object"
      },
      {
        "name": "FreightCost",
        "dbType": "decimal",
        "decimals": 4
      },
      {
        "name": "Customer",
        "dbType": "string"
      },
      {
        "name": "CustAddress",
        "dbType": "string"
      },
      {
        "name": "CustCity",
        "dbType": "string"
      },
      {
        "name": "CustPostalCode",
        "dbType": "string"
      },
      {
        "name": "CustCountry",
        "dbType": "string"
      },
      {
        "name": "ShipperName",
        "dbType": "string"
      },
      {
        "name": "Salesperson",
        "dbType": "object"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "Qty",
        "dbType": "int64"
      },
      {
        "name": "Price",
        "dbType": "decimal",
        "decimals": 4
      },
      {
        "name": "DiscountRate",
        "dbType": "decimal",
        "decimals": 4
      }
    ]
  },
  "sortColumns": [],
  "culture": "en-US",
