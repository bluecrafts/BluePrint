  "sections": [
    {
      "type": "reportHeader",
      "height": 0,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": []
    },
    {
      "type": "pageHeader",
      "height": 2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "lblCompany",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 9,
            "h": 0.8
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#1F5FAD",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "text": "NORTHWIND TRADERS",
          "keepFont": true,
          "translate": false
        },
        {
          "name": "lblShopAddress",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.85,
            "w": 9,
            "h": 0.45
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 8.5,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "text": "1 Harbor Way, Seattle, WA 98101, USA",
          "translate": false
        },
        {
          "name": "lblTitle",
          "type": "computed",
          "bounds": {
            "x": 8,
            "y": 0,
            "w": 10,
            "h": 0.8
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 16,
            "bold": true,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle"
          },
          "expression": "TrIn(\"invoice.title\", [CustLang])"
        },
        {
          "name": "cPaidStamp",
          "type": "computed",
          "bounds": {
            "x": 13,
            "y": 0.85,
            "w": 5,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#1E7B34",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle"
          },
          "expression": "TrIn(\"invoice.paid\", [CustLang])"
        },
        {
          "name": "ruleHeader",
          "type": "line",
          "bounds": {
            "x": 0,
            "y": 1.6,
            "w": 18,
            "h": 0
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "x1": 0,
          "y1": 1.6,
          "x2": 18,
          "y2": 1.6,
          "penWidth": 2,
          "penColor": "#1F5FAD",
          "penStyle": "solid"
        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "OrderNo"
      ],
      "resetPageNumberOnNewGroup": true,
      "height": 3.3,
      "newPageBefore": true,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "lblInvoiceNo",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.2,
            "w": 3,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "TrIn(\"invoice.number\", [CustLang])"
        },
        {
          "name": "fOrderNo",
          "type": "field",
          "bounds": {
            "x": 3,
            "y": 0.2,
            "w": 5,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "source": "OrderNo",
          "format": "0"
        },
        {
          "name": "lblDate",
          "type": "computed",
          "bounds": {
            "x": 9,
            "y": 0.2,
            "w": 3,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "TrIn(\"common.date\", [CustLang])"
        },
        {
          "name": "cDate",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.2,
            "w": 6,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "Date([OrderedOn])",
          "format": "[longdate]"
        },
        {
          "name": "lblBillTo",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.75,
            "w": 3,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "TrIn(\"invoice.bill_to\", [CustLang])"
        },
        {
          "name": "fCustomer",
          "type": "field",
          "bounds": {
            "x": 3,
            "y": 0.75,
            "w": 15,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "source": "Customer"
        },
        {
          "name": "cCustAddress",
          "type": "computed",
          "bounds": {
            "x": 3,
            "y": 1.25,
            "w": 15,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "[CustAddress] + \", \" + Trim(Coalesce([CustPostalCode], \"\") + \" \" + [CustCity]) + \", \" + [CustCountry]"
        },
        {
          "name": "lblShipVia",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.8,
            "w": 3,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "TrIn(\"invoice.ship_via\", [CustLang])"
        },
        {
          "name": "fShipper",
          "type": "field",
          "bounds": {
            "x": 3,
            "y": 1.8,
            "w": 6,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "source": "ShipperName"
        },
        {
          "name": "lblSalesperson",
          "type": "computed",
          "bounds": {
            "x": 9,
            "y": 1.8,
            "w": 3,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#5A6470",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "expression": "TrIn(\"invoice.salesperson\", [CustLang])"
        },
        {
          "name": "fSalesperson",
          "type": "field",
          "bounds": {
            "x": 12,
            "y": 1.8,
            "w": 6,
            "h": 0.5
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9.5,
            "foreColor": "#1F2933",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle"
          },
          "source": "Salesperson"
        },
        {
          "name": "hdrNo",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 2.6,
            "w": 1.2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#1F2933",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.1
          },
          "expression": "TrIn(\"common.no\", [CustLang])"
        },
        {
          "name": "hdrProduct",
          "type": "computed",
          "bounds": {
            "x": 1.2,
            "y": 2.6,
            "w": 7.6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#1F2933",
            "backColor": "#F1F4F8",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.1
          },
          "expression": "TrIn(\"common.product\", [CustLang])"
        },
        {
          "name": "hdrQty",
          "type": "computed",
          "bounds": {
            "x": 8.8,
            "y": 2.6,
            "w": 1.8,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Leelawadee UI",
            "fontSize": 9,
            "bold": true,
            "foreColor": "#1F2933",
            "backColor": "#F1F4F8",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.1
          },
          "expression": "TrIn(\"common.qty\", [CustLang])"
        },
        {
          "name": "hdrPrice",
          "type": "computed",
