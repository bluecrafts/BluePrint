<ui:BpDialogWindow x:Class="LabelPrinting.Views.PrinterProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BluePrint.UI.Controls;assembly=BluePrint.UI"
        Title="Printer Profiles"
        Width="860" Height="600" MinWidth="760" MinHeight="520">

    <!-- Every change here is made to copies of the profiles. Save writes them all
         to LabelPrinting.cfg; Cancel drops them. -->

    <Grid Margin="{DynamicResource Bp.Thickness.Dialog.Margin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: the profiles and what can be done with them -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="NewButton" Content="New from Preset" HorizontalAlignment="Stretch"
                        Click="NewButton_Click" ToolTip="Create a printer profile from a preset" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="DuplicateButton" Content="Duplicate" Click="DuplicateButton_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Margin="6,0,0,0" Click="DeleteButton_Click" />
                </StackPanel>
            </StackPanel>
            <ListBox x:Name="ProfileList" DisplayMemberPath="Name" SelectionChanged="ProfileList_SelectionChanged" />
        </DockPanel>

        <!-- Right: the selected profile -->
        <DockPanel Grid.Row="0" Grid.Column="1">
            <ui:BpStatusLines x:Name="Problems" DockPanel.Dock="Bottom" Margin="0,8,0,0" />

            <TabControl x:Name="Form"
                        TextBoxBase.TextChanged="Field_Changed"
                        Selector.SelectionChanged="Field_Changed"
                        ToggleButton.Checked="Field_Changed"
                        ToggleButton.Unchecked="Field_Changed"
                        RangeBase.ValueChanged="Field_Changed">

                <!-- General -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Text="Printer command" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CommandBox" DisplayMemberPath="DisplayName"
                                      ToolTip="The command language the printer understands" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Print head" Style="{DynamicResource Bp.Text.Label}" Margin="0,16,0,6" />

                            <TextBlock Grid.Row="3" Text="Resolution" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <ComboBox x:Name="DpiBox" IsEditable="True" MinWidth="96"
                                          ToolTip="Dots per inch of the print head" />
                                <TextBlock Text="dpi" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="Print width" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="WidthCmBox" MinWidth="96"
                                         PreviewKeyDown="WidthCmBox_PreviewKeyDown" LostKeyboardFocus="WidthCmBox_LostKeyboardFocus"
                                         ToolTip="Width of the print head. It is rounded to a whole number of bytes (8 dots) when you press Enter or leave the box." />
                                <TextBlock Text="cm" VerticalAlignment="Center" Margin="6,0,12,0" />
                                <TextBlock x:Name="WidthDotsText" VerticalAlignment="Center" Style="{DynamicResource Bp.Text.Caption}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" x:Name="LabelHeading" Text="Label row"
                                       Style="{DynamicResource Bp.Text.Label}" Margin="0,16,0,6" />

                            <TextBlock Grid.Row="6" x:Name="RowWidthLabel" Text="Row width" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <StackPanel Grid.Row="6" Grid.Column="1" x:Name="RowWidthPanel" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="RowWidthBox" MinWidth="96"
                                         ToolTip="Size of a row of labels on the roll, as it goes through the printer: all the labels across the roll together." />
                                <TextBlock Text="cm - all the labels across the roll" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Style="{DynamicResource Bp.Text.Caption}" />
                            </StackPanel>

                            <TextBlock Grid.Row="7" x:Name="RowHeightLabel" Text="Row height" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <StackPanel Grid.Row="7" Grid.Column="1" x:Name="RowHeightPanel" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="RowHeightBox" MinWidth="96"
                                         ToolTip="Size of a row of labels on the roll, as it goes through the printer. A long label printed in landscape is as tall as it is long." />
                                <TextBlock Text="cm" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Connection -->
                <TabItem Header="Connection">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connection" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1" x:Name="ConnectionBox" DisplayMemberPath="DisplayName" />
                            </Grid>

                            <!-- TCP -->
                            <Grid x:Name="TcpPanel" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <TextBox Grid.Column="1" x:Name="HostBox" Margin="0,0,0,6"
                                         ToolTip="The printer's IP address or host name" />
                                <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6"
                                         ToolTip="Most label printers listen on 9100" />
                                <TextBlock Grid.Row="2" Text="Timeout (ms)" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TimeoutBox" MinWidth="96" HorizontalAlignment="Left" />
                            </Grid>

                            <!-- USB -->
                            <StackPanel x:Name="UsbPanel" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Device" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <DockPanel Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="Refresh" Margin="6,0,0,0" Click="RefreshDevices_Click"
                                                ToolTip="Look for USB printers again" />
                                        <ComboBox x:Name="UsbDeviceBox" />
                                    </DockPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}"
                                           Text="Only devices that Windows installed as USB printers are listed. No printer driver is needed." />
                            </StackPanel>

                            <!-- Windows spooler, RAW -->
                            <StackPanel x:Name="SpoolerPanel" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Queue" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <DockPanel Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="Refresh" Margin="6,0,0,0" Click="RefreshDevices_Click"
                                                ToolTip="Read the list of print queues again" />
                                        <ComboBox x:Name="QueueBox" IsEditable="True" TextSearch.TextPath="Id"
                                                  ToolTip="The name of the print queue in Windows" />
                                    </DockPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}"
                                           Text="Sends the commands through the Windows print queue as RAW data. The driver does not change them." />
                            </StackPanel>

                            <!-- Serial / Bluetooth -->
                            <StackPanel x:Name="SerialPanel" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <DockPanel Grid.Column="1" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Refresh" Margin="6,0,0,0" Click="RefreshDevices_Click"
                                                ToolTip="Look for COM ports again" />
                                        <ComboBox x:Name="SerialPortBox" IsEditable="True" TextSearch.TextPath="Id"
                                                  ToolTip="For example COM5" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="Baud rate" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BaudBox" IsEditable="True" MinWidth="96"
                                              HorizontalAlignment="Left" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Text="Data bits" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DataBitsBox" MinWidth="96"
                                              HorizontalAlignment="Left" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="3" Text="Parity" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ParityBox" DisplayMemberPath="Name" MinWidth="96"
                                              HorizontalAlignment="Left" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="4" Text="Stop bits" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="StopBitsBox" DisplayMemberPath="Name" MinWidth="96"
                                              HorizontalAlignment="Left" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="5" Text="Flow control" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="HandshakeBox" DisplayMemberPath="Name" MinWidth="96"
                                              HorizontalAlignment="Left"
                                              ToolTip="Thermal printers on a serial port usually need flow control" />
                                </Grid>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}"
                                           Text="Pair a Bluetooth printer in Windows Settings first. Windows then creates a COM port for it." />
                            </StackPanel>

                            <!-- Opens the connection and closes it again; nothing is sent. -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="TestButton" Content="Test Connection" Click="TestConnection_Click"
                                        ToolTip="Open the connection and close it again. Nothing is printed." />
                                <StackPanel x:Name="TestResult" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <ui:BpStatusIcon x:Name="TestIcon" Kind="Success" AlignToTextBaseline="True" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TestText" VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="420" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pacing -->
                <TabItem Header="Pacing">
                    <StackPanel Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Chunk size (bytes)" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <TextBox Grid.Column="1" x:Name="ChunkBox" MinWidth="96" Margin="0,0,0,6" />
                            <TextBlock Grid.Column="2" Text="0 = send each row in one piece" VerticalAlignment="Center"
                                       Margin="8,0,0,6" Style="{DynamicResource Bp.Text.Caption}" />
                            <TextBlock Grid.Row="1" Text="Delay between chunks (ms)" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ChunkDelayBox" MinWidth="96" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="Delay between rows (ms)" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="RowDelayBox" MinWidth="96" />
                        </Grid>
                        <Button Content="Use Recommended Values" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="RecommendedPacing_Click"
                                ToolTip="The values that suit the connection chosen on the Connection tab" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}"
                                   Text="Leave these at 0 unless labels come out cut, shifted or stop half way. Then lower the chunk size and raise the delay step by step, for example 512 bytes and 20 ms." />
                    </StackPanel>
                </TabItem>

                <!-- Commands -->
                <TabItem Header="Commands">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Column="1" x:Name="InitializeBox" Content="Initialize printer" Margin="0,0,0,6"
                                          ToolTip="Reset the printer's settings at the start of each job" />
                                <TextBlock Grid.Row="1" Text="Copies" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CopiesBox" MinWidth="96" HorizontalAlignment="Left" />
                            </Grid>

                            <!-- TSPL -->
                            <Grid x:Name="TsplPanel" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="TSPL" Style="{DynamicResource Bp.Text.Label}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="Gap (mm)" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TsplGapBox" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Text="Direction" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DirectionBox" DisplayMemberPath="Name" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Text="Density (0-15)" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TsplDensityBox" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="4" Text="Speed (in/s)" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TsplSpeedBox" MinWidth="96" HorizontalAlignment="Left" />
                            </Grid>

                            <!-- ZPL -->
                            <Grid x:Name="ZplPanel" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="ZPL II" Style="{DynamicResource Bp.Text.Label}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="Compression" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CompressionBox" DisplayMemberPath="Name" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6"
                                          ToolTip="Choose Hex if the printer does not print Z64 images" />
                                <TextBlock Grid.Row="2" Text="Label home X / Y" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBox x:Name="HomeXBox" MinWidth="64" />
                                    <TextBox x:Name="HomeYBox" MinWidth="64" Margin="6,0,0,0" />
                                    <TextBlock Text="dots" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="Print mode" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="PrintModeBox" DisplayMemberPath="Name" MinWidth="96" HorizontalAlignment="Left" />
                            </Grid>

                            <!-- EPL2 -->
                            <Grid x:Name="EplPanel" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="EPL2" Style="{DynamicResource Bp.Text.Label}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="Gap (dots)" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="EplGapBox" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6"
                                         ToolTip="0 = continuous paper" />
                                <TextBlock Grid.Row="2" Text="Darkness (0-15)" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="EplDarknessBox" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Text="Speed (0-6)" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="EplSpeedBox" MinWidth="96" HorizontalAlignment="Left"
                                         ToolTip="The printer model's speed code" />
                            </Grid>

                            <!-- EZPL -->
                            <Grid x:Name="EzplPanel" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="EZPL" Style="{DynamicResource Bp.Text.Label}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="Gap (mm)" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="EzplGapBox" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6"
                                         ToolTip="0 = continuous paper" />
                                <TextBlock Grid.Row="2" Text="Darkness (0-19)" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="EzplDarknessBox" MinWidth="96" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Text="Speed (1-10 in/s)" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="EzplSpeedBox" MinWidth="96" HorizontalAlignment="Left" />
                            </Grid>

                            <TextBlock x:Name="GapNote" Margin="0,12,0,0" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}"
                                       Text="Gap is the space between label rows on the roll. It is not part of the report. Empty fields use the printer's own setting." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Image -->
                <TabItem Header="Image">
                    <StackPanel Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Threshold" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <Slider Grid.Column="1" x:Name="ThresholdSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="8"
                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,0,6"
                                    ToolTip="A grey darker than this prints black" />
                            <TextBlock Grid.Column="2" x:Name="ThresholdText" MinWidth="32" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="8,0,0,6" />
                            <TextBlock Grid.Row="1" Text="Dither" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DitherScopeBox" DisplayMemberPath="Name" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Text="Algorithm" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DitherAlgorithmBox" DisplayMemberPath="Name" />
                        </Grid>
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}"
                                   Text="Text and barcodes always use the threshold. Dithering only affects pictures." />

                        <!-- Done to the 1-bit image before it is sent: turned, mirrored, made negative -->
                        <TextBlock Text="Printing" Style="{DynamicResource Bp.Text.Label}" Margin="0,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Orientation" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <ComboBox Grid.Column="1" x:Name="OrientationBox" DisplayMemberPath="Name" Margin="0,0,0,6"
                                      ToolTip="How the label, as designed, is turned to go through the printer. Landscape prints a long label across a narrow print head." />
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="MirrorBox" Content="Mirror" Margin="0,0,0,6"
                                      ToolTip="Print left and right swapped, to read the label through the back of clear film." />
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="NegativeBox" Content="Negative"
                                      ToolTip="Print white on black: every dot of the label is swapped. Uses much more ribbon and wears the print head faster." />
                        </Grid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Bottom: where the profiles are kept, then Save | Cancel - Cancel last -->
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,12,0,0"
                   Style="{DynamicResource Bp.Text.Caption}"
                   Text="Saved in LabelPrinting.cfg next to the application." />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="SaveButton_Click"
                    Style="{DynamicResource Bp.Button.Primary}"
                    Margin="{DynamicResource Bp.Thickness.Button.Gap}" />
            <Button Content="Cancel" IsCancel="True" Style="{DynamicResource Bp.Button.Dialog}" />
        </StackPanel>
    </Grid>
</ui:BpDialogWindow>
