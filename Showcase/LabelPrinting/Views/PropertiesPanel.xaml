<UserControl x:Class="LabelPrinting.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BluePrint.UI.Controls;assembly=BluePrint.UI">

    <!--
        The properties a label needs, for the label itself (nothing selected) or for
        the elements selected on the design surface. Each group is a Grid named
        Group<name> after PropertyGroup; PropertyMatrix decides which are shown.
        Every change goes through the designer (ApplyElementChange /
        ApplyReportChange), so it can be undone with Ctrl+Z.
    -->

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Group" TargetType="Grid">
            <Setter Property="Margin" Value="{DynamicResource Bp.Thickness.Row.Gap}" />
        </Style>
        <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <!-- A colour in a list: a small swatch and its name -->
        <DataTemplate x:Key="ColorItem">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="12" Height="12" Margin="0,0,6,0" Fill="{Binding Brush}"
                           Stroke="{DynamicResource Bp.Brush.Border.Default}" StrokeThickness="1" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- What went wrong with the last value typed; it is put back as it was -->
        <ui:BpStatusLines x:Name="ErrorLines" Banner="True" Margin="0,0,0,8" />

        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}"
                   Visibility="Collapsed" />

        <!-- ==== The label: nothing selected ==================================== -->
        <StackPanel x:Name="LabelSection" Visibility="Collapsed">
            <TextBlock Text="Label size" Style="{DynamicResource Bp.Text.Label}" Margin="0,0,0,4" />
            <Grid Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Width" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LabelWidthBox" Grid.Column="1" ToolTip="Width of one label" />
                <TextBlock x:Name="LabelUnit1" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="Height" Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,4,8,0" />
                <TextBox x:Name="LabelHeightBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                         ToolTip="Height of one label: one row of labels on the roll" />
                <TextBlock x:Name="LabelUnit2" Grid.Row="1" Grid.Column="2" Margin="6,4,0,0" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Across the roll" Style="{DynamicResource Bp.Text.Label}" Margin="0,4,0,4" />
            <Grid Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Labels per row" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LabelsPerRowBox" Grid.Column="1" ToolTip="How many labels sit side by side on the roll, 1 to 20" />
                <TextBlock Text="Column gap" Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,4,8,0" />
                <TextBox x:Name="LabelGapBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                         ToolTip="Space between two labels side by side. The space between rows is set on the printer (Gap)." />
                <TextBlock x:Name="LabelUnit3" Grid.Row="1" Grid.Column="2" Margin="6,4,0,0" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="RowWidthText" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}" />

            <!-- Margins of the page. On a roll the page is one row of labels, so the
                 margins and the labels make the page size shown below. -->
            <TextBlock Text="Margins" Style="{DynamicResource Bp.Text.Label}" Margin="0,12,0,4" />
            <Grid Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Left" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="MarginLeftBox" Grid.Column="1" ToolTip="Space from the left edge of the print head to the first label" />
                <TextBlock x:Name="LabelUnit4" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="Right" Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,4,8,0" />
                <TextBox x:Name="MarginRightBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                         ToolTip="Space after the last label in the row" />
                <TextBlock x:Name="LabelUnit5" Grid.Row="1" Grid.Column="2" Margin="6,4,0,0" VerticalAlignment="Center" />
                <TextBlock Text="Top" Grid.Row="2" Style="{StaticResource FieldLabel}" Margin="0,4,8,0" />
                <TextBox x:Name="MarginTopBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                         ToolTip="Space above the labels. Usually 0 on a roll." />
                <TextBlock x:Name="LabelUnit6" Grid.Row="2" Grid.Column="2" Margin="6,4,0,0" VerticalAlignment="Center" />
                <TextBlock Text="Bottom" Grid.Row="3" Style="{StaticResource FieldLabel}" Margin="0,4,8,0" />
                <TextBox x:Name="MarginBottomBox" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                         ToolTip="Space below the labels. Usually 0 on a roll." />
                <TextBlock x:Name="LabelUnit7" Grid.Row="3" Grid.Column="2" Margin="6,4,0,0" VerticalAlignment="Center" />
            </Grid>

            <Grid Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Page size" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="PageSizeText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{DynamicResource Bp.Text.Caption}" />
            </Grid>

            <ui:BpStatusLines x:Name="SheetLines" Banner="True" Margin="0,12,0,0" />
            <Button x:Name="UseRollButton" Content="Use Roll Layout" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Click="UseRoll_Click" ToolTip="Lay the label out as a roll: one row of labels per page" />
        </StackPanel>

        <!-- ==== The selected elements ========================================= -->
        <StackPanel x:Name="ElementSection" Visibility="Collapsed">

            <!-- Text: the fixed text of a Text element -->
            <Grid x:Name="GroupText" Style="{StaticResource Group}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Text" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="TextValueBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3"
                         VerticalScrollBarVisibility="Auto" ToolTip="The text of the element. Enter starts a new line; Tab or a click elsewhere applies it." />
            </Grid>

            <Grid x:Name="GroupColumn" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Column" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ColumnBox" Grid.Column="1" IsEditable="True"
                          ToolTip="The column of the label data this field shows" />
            </Grid>

            <Grid x:Name="GroupExpression" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Expression" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ExpressionBox" Grid.Column="1" />
                <Button x:Name="ExpressionButton" Grid.Column="2" Content="..." MinWidth="0" Padding="8,0" Margin="4,0,0,0"
                        Click="ExpressionButton_Click" ToolTip="Edit the expression, with the columns and functions at hand" />
            </Grid>

            <Grid x:Name="GroupPicture" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Image file" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ImageFileBox" Grid.Column="1" IsReadOnly="True" />
                <Button Grid.Column="2" Content="Browse..." Margin="4,0,0,0" Click="BrowseImage_Click"
                        ToolTip="Choose a picture file. A file in the label's folder is kept relative to it." />
                <TextBlock Text="Size" Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,4,8,0" />
                <ComboBox x:Name="SizeModeBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                          ToolTip="How the picture fits its box" />
            </Grid>

            <Grid x:Name="GroupBarcode" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="BarcodeTypeBox" Grid.Column="1" ToolTip="The kind of barcode" />
                <CheckBox x:Name="ShowTextCheck" Grid.Row="1" Grid.Column="1" Content="Show text" Margin="0,6,0,0"
                          ToolTip="Print the encoded text under the bars. Two-dimensional codes have no text." />
            </Grid>

            <Grid x:Name="GroupShape" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shape" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ShapeBox" Grid.Column="1" />
            </Grid>

            <Grid x:Name="GroupFont" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Font" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FontBox" Grid.Column="1" IsEditable="True" ToolTip="Font" />
                <ComboBox x:Name="FontSizeBox" Grid.Column="2" IsEditable="True" MinWidth="56" Margin="4,0,0,0"
                          ToolTip="Font size in points, 1 to 400" />
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <ToggleButton x:Name="BoldToggle" Content="B" FontWeight="Bold" Style="{StaticResource IconToggle}"
                                  MinWidth="26" ToolTip="Bold" />
                    <ToggleButton x:Name="ItalicToggle" Content="I" FontStyle="Italic" Style="{StaticResource IconToggle}"
                                  MinWidth="26" ToolTip="Italic" />
                </StackPanel>
            </Grid>

            <Grid x:Name="GroupColor" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Color" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ForeColorBox" Grid.Column="1" IsEditable="True" ItemTemplate="{StaticResource ColorItem}"
                          TextSearch.TextPath="Name" ToolTip="Text color: a name from the list or #RRGGBB" />
                <TextBlock Text="Back" Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,4,8,0" />
                <ComboBox x:Name="BackColorBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" IsEditable="True"
                          ItemTemplate="{StaticResource ColorItem}" TextSearch.TextPath="Name"
                          ToolTip="Background color: a name from the list or #RRGGBB" />
            </Grid>

            <Grid x:Name="GroupLine" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Line" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LineWidthBox" Grid.Column="1" ToolTip="Line width in pixels, 0.5 to 20" />
                <ComboBox x:Name="LineColorBox" Grid.Column="2" Margin="4,0,0,0" IsEditable="True"
                          ItemTemplate="{StaticResource ColorItem}" TextSearch.TextPath="Name"
                          ToolTip="Line color: a name from the list or #RRGGBB" />
            </Grid>

            <Grid x:Name="GroupFill" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Fill" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FillBox" Grid.Column="1" IsEditable="True" ItemTemplate="{StaticResource ColorItem}"
                          TextSearch.TextPath="Name" ToolTip="Fill color: a name from the list or #RRGGBB" />
            </Grid>

            <Grid x:Name="GroupAlign" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Align" Style="{StaticResource FieldLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton x:Name="AlignLeft" Style="{StaticResource IconToggle}" ToolTip="Align left">
                        <Path Data="{DynamicResource Icon.AlignLeft}" Style="{DynamicResource Bp.SmallIcon}" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignCenter" Style="{StaticResource IconToggle}" ToolTip="Center">
                        <Path Data="{DynamicResource Icon.AlignCenter}" Style="{DynamicResource Bp.SmallIcon}" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignRight" Style="{StaticResource IconToggle}" Margin="0,0,8,0" ToolTip="Align right">
                        <Path Data="{DynamicResource Icon.AlignRight}" Style="{DynamicResource Bp.SmallIcon}" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignTop" Style="{StaticResource IconToggle}" ToolTip="Top">
                        <Path Data="{DynamicResource Icon.AlignTop}" Style="{DynamicResource Bp.SmallIcon}" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignMiddle" Style="{StaticResource IconToggle}" ToolTip="Middle">
                        <Path Data="{DynamicResource Icon.AlignMiddle}" Style="{DynamicResource Bp.SmallIcon}" />
                    </ToggleButton>
                    <ToggleButton x:Name="AlignBottom" Style="{StaticResource IconToggle}" ToolTip="Bottom">
                        <Path Data="{DynamicResource Icon.AlignBottom}" Style="{DynamicResource Bp.SmallIcon}" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <Grid x:Name="GroupFormat" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Format" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FormatBox" Grid.Column="1" IsEditable="True"
                          ToolTip="How numbers and dates are written, for example #,##0.00 or dd/MM/yyyy" />
            </Grid>

            <Grid x:Name="GroupWrapText" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="WrapCheck" Grid.Column="1" Content="Wrap text"
                          ToolTip="Break long text into lines inside the box" />
            </Grid>

            <Grid x:Name="GroupBorder" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Border" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="BorderBox" Grid.Column="1" ToolTip="A black line on all four sides" />
            </Grid>

            <Grid x:Name="GroupPosition" Style="{StaticResource Group}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Position" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="X" Grid.Column="1" VerticalAlignment="Center" />
                <TextBox x:Name="XBox" Grid.Column="2" ToolTip="Distance from the left edge of the label" />
                <TextBlock Text="Y" Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBox x:Name="YBox" Grid.Column="4" ToolTip="Distance from the top edge of the label" />
                <TextBlock Text="W" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,0" />
                <TextBox x:Name="WBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" ToolTip="Width" />
                <TextBlock Text="H" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="8,4,0,0" />
                <TextBox x:Name="HBox" Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" ToolTip="Height" />
                <TextBlock x:Name="PositionUnit" Grid.Row="1" Grid.Column="5" VerticalAlignment="Center" Margin="6,4,0,0" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
