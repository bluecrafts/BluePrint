<Window x:Class="LabelPrinting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bp="clr-namespace:BluePrint.Designer.Controls;assembly=BluePrint.Designer"
        xmlns:ui="clr-namespace:BluePrint.UI.Controls;assembly=BluePrint.UI"
        xmlns:local="clr-namespace:LabelPrinting"
        xmlns:views="clr-namespace:LabelPrinting.Views"
        xmlns:rw="clr-namespace:BluePrint.Render.WPF.Controls;assembly=BluePrint.Render.WPF"
        Title="LabelPrinting" Width="1400" Height="900" MinWidth="1000" MinHeight="640">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The theme's toolbar buttons are sized for 16 px icons (a fixed button
                 height). These carry 24 px icons: let the height follow the icon, with
                 the same padding on every side, for square 34 x 34 buttons. A toolbar
                 looks these keys up itself, so both toolbar trays of the window get them. -->
            <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button"
                   BasedOn="{StaticResource Bp.Button.Toolbar}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton"
                   BasedOn="{StaticResource Bp.ToggleButton.Toolbar}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Padding" Value="4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="local:AppCommands.New"      Executed="New_Executed"    CanExecute="NotBusy_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Open"   Executed="Open_Executed"   CanExecute="NotBusy_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Save"   Executed="Save_Executed"   CanExecute="HasReport_CanExecute" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" CanExecute="HasReport_CanExecute" />
        <CommandBinding Command="local:AppCommands.Retrieve" Executed="Retrieve_Executed" CanExecute="HasReport_CanExecute" />
        <CommandBinding Command="local:AppCommands.Print" Executed="Print_Executed" CanExecute="CanPrint_CanExecute" />
        <CommandBinding Command="local:AppCommands.PrintNextRow" Executed="PrintNextRow_Executed" CanExecute="CanPrintNextRow_CanExecute" />
        <CommandBinding Command="local:AppCommands.SaveCommands" Executed="SaveCommands_Executed" CanExecute="CanPrint_CanExecute" />
        <CommandBinding Command="local:AppCommands.Stop" Executed="Stop_Executed" CanExecute="CanStop_CanExecute" />
        <CommandBinding Command="local:AppCommands.ShowDesign" Executed="ShowDesign_Executed" />
        <CommandBinding Command="local:AppCommands.ShowPreview" Executed="ShowPreview_Executed" />
        <CommandBinding Command="local:AppCommands.ZoomIn" Executed="ZoomIn_Executed" CanExecute="HasReport_CanExecute" />
        <CommandBinding Command="local:AppCommands.ZoomOut" Executed="ZoomOut_Executed" CanExecute="HasReport_CanExecute" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <!-- Ctrl+O and Ctrl+S come with the commands; Save As has no gesture of its own. -->
        <KeyBinding Command="ApplicationCommands.SaveAs" Gesture="Ctrl+Shift+A" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="local:AppCommands.New"
                          ToolTip="Start a new label: 5 x 5 cm, two across a roll, with the same six data columns as the sample" />
                <MenuItem Header="_Open..." Command="ApplicationCommands.Open" />
                <MenuItem Header="_Save" Command="ApplicationCommands.Save" />
                <MenuItem Header="Save _As..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+A" />
                <Separator />
                <MenuItem Header="Open Samples _Folder" Click="OpenSamplesFolder_Click"
                          ToolTip="Show the sample label and its data file in File Explorer" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem Header="_Retrieve" Command="local:AppCommands.Retrieve"
                          ToolTip="Read the label data from a CSV or Excel file" />
            </MenuItem>
            <MenuItem Header="_Print">
                <MenuItem Header="_Print" Command="local:AppCommands.Print" />
                <MenuItem Header="Print _Next Row" Command="local:AppCommands.PrintNextRow" />
                <MenuItem Header="_Stop" Command="local:AppCommands.Stop" />
                <MenuItem Header="Save _Commands..." Command="local:AppCommands.SaveCommands"
                          ToolTip="Save the bytes that would be sent to the printer in a file" />
                <Separator />
                <MenuItem Header="Printer _Profiles..." Click="PrinterProfiles_Click"
                          ToolTip="Create and edit the printers this application prints to" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Design" Command="local:AppCommands.ShowDesign"
                          ToolTip="Draw the label" />
                <MenuItem Header="_Preview" Command="local:AppCommands.ShowPreview"
                          ToolTip="See the 1-bit image the printer will get, and print it" />
                <Separator />
                <MenuItem Header="Zoom _In" Command="local:AppCommands.ZoomIn" />
                <MenuItem Header="Zoom _Out" Command="local:AppCommands.ZoomOut" />
                <Separator />
                <MenuItem x:Name="RightPanelMenuItem" Header="_Right Panel" IsCheckable="True" IsChecked="True"
                          Click="RightPanelMenuItem_Click" ToolTip="Show or hide the panel on the right of each tab: Properties and Print" />
                <!-- Theme > Light / Dark / System is added here by MainWindow.View.cs -->
                <Separator x:Name="ThemeSeparator" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About LabelPrinting" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Icon buttons, 24 x 24 (Views/Icons.xaml). The name of each button is in its
             tooltip and its automation name, shown on a disabled button too. -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="DocumentToolBar" Band="0" BandIndex="0">
                <Button Command="local:AppCommands.New" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="New"
                        ToolTip="New: an empty label with the sample's size and six data columns">
                    <Path Data="{StaticResource Icon.New}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Button Command="ApplicationCommands.Open" ToolTipService.ShowOnDisabled="True" ToolTip="Open (Ctrl+O)" AutomationProperties.Name="Open">
                    <Path Data="{StaticResource Icon.Open}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Button Command="ApplicationCommands.Save" ToolTipService.ShowOnDisabled="True" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                    <Path Data="{StaticResource Icon.Save}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Button Command="local:AppCommands.Retrieve" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Retrieve"
                        ToolTip="Retrieve: read the label data from a CSV or Excel file (Ctrl+R)">
                    <Path Data="{StaticResource Icon.Retrieve}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
            </ToolBar>

            <ToolBar x:Name="PrinterToolBar" Band="0" BandIndex="1">
                <TextBlock Text="Profile" VerticalAlignment="Center" Margin="4,0,6,0" />
                <ComboBox x:Name="ProfileBox" MinWidth="200" DisplayMemberPath="Name"
                          SelectionChanged="ProfileBox_SelectionChanged" />
                <Button Click="PrinterProfiles_Click" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Printer Profiles"
                        ToolTip="Printer Profiles: create and edit the printers this application prints to">
                    <Path Data="{StaticResource Icon.Profiles}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Separator />
                <Button Command="local:AppCommands.Print" ToolTipService.ShowOnDisabled="True" ToolTip="Print (Ctrl+P)" AutomationProperties.Name="Print">
                    <Path Data="{StaticResource Icon.Print}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Button Command="local:AppCommands.Stop" ToolTipService.ShowOnDisabled="True" ToolTip="Stop printing (Esc)" AutomationProperties.Name="Stop">
                    <Path Data="{StaticResource Icon.Stop}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Margin="0,0,8,0">
                <TextBlock x:Name="StatusProfileText" Foreground="{DynamicResource Bp.Brush.Text.Secondary}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" x:Name="JobProgressItem" Visibility="Collapsed" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="JobProgressText" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ProgressBar x:Name="JobProgress" Width="120" Height="12" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <!-- The last thing that happened. There is no log panel: each message
                     replaces the one before, and the full text is in the tooltip. -->
                <StackPanel x:Name="StatusPanel" Orientation="Horizontal">
                    <ui:BpStatusIcon x:Name="StatusIcon" Kind="Information" AlignToTextBaseline="True"
                                     Margin="0,0,6,0" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Top"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Kept off the window's left and right edges, so the tools and the panels
             do not touch the frame. -->
        <Grid Margin="8,0,8,0">
            <!-- Design: draw the label, with its properties beside it.
                 Preview: the 1-bit image the printer will get, with the print settings beside it.
                 There is no colour preview: the image that counts is the 1-bit one. -->
            <TabControl x:Name="ViewTabs" SelectionChanged="ViewTabs_SelectionChanged">
                <TabItem x:Name="DesignTab" Header="Design">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="400" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="PropertiesColumn" Width="300" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <!-- The element tools, beside the surface they draw on. Filled in by
                                 MainWindow.Tools.cs: one button per element tool of the designer. -->
                            <ToolBarTray DockPanel.Dock="Left" Orientation="Vertical">
                                <ToolBar x:Name="ElementsToolBar" />
                            </ToolBarTray>
                            <Grid>
                                <!-- Only the design surface: the element tools are on its left and
                                     the properties on its right. -->
                                <bp:BluePrintDesignerControl x:Name="Designer"
                                                             ShowElementToolBar="False"
                                                             ShowPropertyPanel="False"
                                                             ShowElementList="False"
                                                             ShowPreviewOnLoad="False"
                                                             Layout="Designer"
                                                             Zoom="2" />
                                <TextBlock x:Name="NoLabelText" Text="Open a label to start. File > Open, or Ctrl+O."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Style="{DynamicResource Bp.Text.Caption}" />
                            </Grid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" x:Name="PropertiesSplitter" Width="4" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource Bp.Brush.Border.Default}" />

                        <!-- Properties: filled in by this application, not by the designer -->
                        <DockPanel Grid.Column="2" x:Name="PropertiesPane" Background="{DynamicResource Bp.Brush.Surface.Panel}">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                                    MinHeight="{DynamicResource Bp.Size.Header.Height}">
                                <DockPanel>
                                    <TextBlock x:Name="PropertiesSubject" DockPanel.Dock="Right" Style="{DynamicResource Bp.Text.Caption}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Properties" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <views:PropertiesPanel x:Name="Properties" Margin="12,8,12,8" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PreviewTab" Header="Preview">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="400" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="PrintColumn" Width="300" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!-- The 1-bit image the printer gets, dot for dot: BluePrintMonochromeView of
                             BluePrint.Render.WPF. A page of a roll label report is one row of labels. -->
                        <rw:BluePrintMonochromeView x:Name="Monochrome" ItemCaption="Row" />

                        <GridSplitter Grid.Column="1" x:Name="PrintSplitter" Width="4" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource Bp.Brush.Border.Default}" />

                        <!-- Print: the printer, the rows, and the job -->
                        <DockPanel Grid.Column="2" x:Name="PrintPane" Background="{DynamicResource Bp.Brush.Surface.Panel}">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                                    MinHeight="{DynamicResource Bp.Size.Header.Height}">
                                <TextBlock Text="Print" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12,8,12,12">
                                    <!-- Orientation, Mirror and Negative are kept in the profile: the link opens it at the Image tab -->
                                    <DockPanel>
                                        <Button x:Name="ChangeProfileLink" DockPanel.Dock="Right" Content="Change..." Margin="8,0,0,0"
                                                Style="{DynamicResource Bp.Button.Link}" VerticalAlignment="Center"
                                                Click="ChangeProfile_Click"
                                                ToolTip="Open the printer profile at the Image tab: orientation, mirror and negative." />
                                        <TextBlock x:Name="ProfileSummary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ui:BpStatusLines x:Name="PrintHints" Banner="True" Margin="0,6,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <RadioButton x:Name="AllRowsRadio" Content="All rows" GroupName="Range" IsChecked="True"
                                                     Checked="Range_Changed" />
                                        <RadioButton x:Name="RangeRadio" Content="Rows" GroupName="Range" Margin="16,0,0,0"
                                                     VerticalAlignment="Center" Checked="Range_Changed" />
                                        <TextBox x:Name="RangeBox" MinWidth="96" Margin="8,0,0,0" TextChanged="Range_Changed"
                                                 ToolTip="Use row numbers and ranges, for example 1-3,5." />
                                        <ui:BpStatusIcon x:Name="RangeErrorIcon" Kind="Error" Margin="6,0,0,0" VerticalAlignment="Center"
                                                         Visibility="Collapsed" ToolTip="Use row numbers and ranges, for example 1-3,5." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Copies" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="CopiesBox" MinWidth="64" Text="1" TextChanged="Range_Changed"
                                                 ToolTip="Copies of each label, 1 to 999" />
                                    </StackPanel>

                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock x:Name="RowByRowLabel" Text="Row by row" Style="{DynamicResource Bp.Text.Label}" />
                                        <TextBlock x:Name="NextRowText" HorizontalAlignment="Right" Style="{DynamicResource Bp.Text.Caption}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="NextRowButton" Content="Print next row" Command="local:AppCommands.PrintNextRow"
                                                ToolTip="Send the next row of labels (Ctrl+N)" />
                                        <Button x:Name="ReprintButton" Content="Reprint" Margin="6,0,0,0" Click="Reprint_Click"
                                                ToolTip="Send the last row again, for example after a paper jam" />
                                        <Button x:Name="ResetRowsButton" Content="Reset" Margin="6,0,0,0" Click="ResetRows_Click"
                                                ToolTip="Start again from the first row" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="PrintButton" Content="Print" MinWidth="120" Style="{DynamicResource Bp.Button.Primary}"
                                                Command="local:AppCommands.Print" ToolTip="Print (Ctrl+P)" />
                                        <Button x:Name="StopButton" Content="Stop" Margin="6,0,0,0" Command="local:AppCommands.Stop"
                                                ToolTip="Stop printing (Esc)" />
                                    </StackPanel>

                                    <ui:BpStatusLines x:Name="LastJobLines" Banner="True" Margin="0,8,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- The zoom of the design surface, at the right end of the tab strip -->
            <StackPanel x:Name="DesignZoomPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,2,4,0">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="DesignZoomBox" MinWidth="80" IsEditable="True"
                          SelectionChanged="DesignZoomBox_SelectionChanged" LostFocus="DesignZoomBox_Commit"
                          KeyDown="DesignZoomBox_KeyDown"
                          ToolTip="Zoom of the design surface, 25% to 800%" />
            </StackPanel>
        </Grid>
    </DockPanel>

</Window>
