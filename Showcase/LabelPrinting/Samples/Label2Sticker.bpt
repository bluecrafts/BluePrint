{
  "version": "1.0",
  "metadata": {
    "name": "Label2Sticker",
    "description": "Product sticker, 50 x 50 mm, two across a 100 mm roll with no gap. Data: Label2Sticker.csv.",
    "author": ""
  },
  "report": {
    "type": "label",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 0,
        "bottom": 0,
        "left": 0,
        "right": 0
      },
      "backgroundColor": "#FFFFFF"
    },
    "labelLayout": {
      "labelWidth": 5,
      "labelHeight": 5,
      "labelsPerRow": 2,
      "rowGap": 0,
      "columnGap": 0,
      "fillDirection": "rowMajor",
      "pageMode": "rowPerPage",
      "showCellBorder": false,
      "cellBorderColor": "#000000",
      "cellBorderWidth": 1
    }
  },
  "dataSource": {
    "dataSourceType": "external",
    "columns": [
      {
        "name": "ProductName",
        "dbType": "string",
        "length": 60
      },
      {
        "name": "ProductCode",
        "dbType": "string",
        "length": 20
      },
      {
        "name": "Price",
        "dbType": "decimal",
        "decimals": 2
      },
      {
        "name": "LotNo",
        "dbType": "string",
        "length": 20
      },
      {
        "name": "ManufactureDate",
        "dbType": "date"
      },
      {
        "name": "ExpireDate",
        "dbType": "date"
      }
    ]
  },
  "sortColumns": [],
  "culture": "en-US",
  "sections": [
    {
      "type": "detail",
      "height": 5,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "ProductName",
          "type": "field",
          "bounds": {
            "x": 0.25,
            "y": 0.2,
            "w": 4.5,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 10,
            "bold": true,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top"
          },
          "source": "ProductName",
          "wrapText": true
        },
        {
          "name": "ProductCodeBarcode",
          "type": "barcode",
          "bounds": {
            "x": 0.25,
            "y": 1.15,
            "w": 4.5,
            "h": 1.3
          },
          "style": {
            "fontFamily": "Arial",
            "fontSize": 7,
            "foreColor": "#000000",
            "backColor": "Transparent",
            "hAlign": "center",
            "vAlign": "top"
          },
          "expression": "ProductCode",
          "barcode": {
            "symbology": "code128",
            "showText": true,
            "rotation": "none",
            "dpi": 203,
            "encoding": "auto",
            "narrowToWideRatio": 2,
            "qrEcLevel": "m",
            "includeChecksum": false,
            "aztecEcPercent": 23,
            "dataMatrixRectangular": false
          }
        },
        {
          "name": "LotLabel",
          "type": "label",
