{
  "version": "1.0",
  "metadata": {
    "name": "Monthly Sales by Country",
    "description": "A crosstab of the month: countries and their customers down the side, product categories across the top, with a total for every country.",
    "author": "BluePrint"
  },
  "report": {
    "type": "crosstab",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "landscape",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1,
        "right": 1
      },
      "backgroundColor": "#FFFFFF"
    },
    "crosstabDefinition": {
      "rows": [
        {
          "field": "CustCountry",
          "sort": "asc",
          "subtotal": true
        },
        {
          "field": "CustomerName",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "columns": [
        {
          "field": "CategoryLabel",
          "sort": "asc",
          "subtotal": false
        }
      ],
      "values": [
        {
          "source": "Sales",
          "aggregate": "sum",
          "format": "#,##0"
        }
      ],
      "totals": {
        "rowGrand": true,
        "colGrand": true,
        "grand": true
      },
      "emptyCell": "",
      "columnGuard": {
        "maxColumns": 256,
        "maxPages": 10,
        "onExceed": "warn"
      }
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.Country AS CustCountry, c.CompanyName AS CustomerName, cat.CategoryName AS CategoryLabel,\n       od.UnitPrice * od.Quantity * (1 - od.Discount) AS Sales\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nJOIN Categories cat ON cat.CategoryID = p.CategoryID\nWHERE {bp:DateText(o.OrderDate)} >= {bp:DateText(@FromDate)}\n  AND {bp:DateText(o.OrderDate)} <= {bp:DateText(@ToDate)}\nORDER BY CustCountry, CustomerName, CategoryLabel",
    "arguments": [
      {
        "name": "FromDate",
        "argType": "date"
      },
      {
        "name": "ToDate",
        "argType": "date"
      }
    ],
    "columns": [
      {
        "name": "CustCountry",
        "dbType": "string"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "CategoryLabel",
        "dbType": "string"
      },
      {
        "name": "Sales",
        "dbType": "object"
      }
    ]
  },
  "sortColumns": [],
  "localization": {
    "sourceLanguage": "en",
    "languages": [
      "en"
    ],
    "cultures": {
      "en": "en-US"
    }
  },
  "sections": [
