{
  "version": "1.0",
  "metadata": {
    "name": "Monthly Sales by Customer",
    "description": "What each customer bought in the month, line by line, with a total for every customer.",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT c.CompanyName AS CustomerName, c.City AS CustCity, c.Country AS CustCountry,\n       o.OrderID AS OrderNo, {bp:DateText(o.OrderDate)} AS OrderDay, p.ProductName AS ItemName,\n       od.Quantity AS Qty, od.UnitPrice AS Price, od.Discount AS Disc\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN {bp:Name(Order Details)} od ON od.OrderID = o.OrderID\nJOIN Products p ON p.ProductID = od.ProductID\nWHERE {bp:DateText(o.OrderDate)} >= {bp:DateText(@FromDate)}\n  AND {bp:DateText(o.OrderDate)} <= {bp:DateText(@ToDate)}\nORDER BY CustomerName, OrderNo, ItemName",
    "arguments": [
      {
        "name": "FromDate",
        "argType": "date"
      },
      {
        "name": "ToDate",
        "argType": "date"
      }
    ],
    "columns": [
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "CustCity",
        "dbType": "string"
      },
      {
        "name": "CustCountry",
        "dbType": "string"
      },
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "OrderDay",
        "dbType": "object"
      },
      {
        "name": "ItemName",
        "dbType": "string"
      },
      {
        "name": "Qty",
        "dbType": "int64"
      },
      {
        "name": "Price",
        "dbType": "decimal"
      },
      {
        "name": "Disc",
        "dbType": "decimal"
      }
    ]
  },
  "sortColumns": [],
  "localization": {
    "sourceLanguage": "en",
    "languages": [
      "en"
    ],
    "cultures": {
      "en": "en-US"
    }
  },
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AccentBar",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.12
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 2,
            "foreColor": "#1F5FAD",
            "backColor": "#1F5FAD",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": ""
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Monthly Sales by Customer"
        },
        {
          "name": "Subtitle",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.25,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Orders from \" + String(@FromDate, \"d MMMM yyyy\") + \" to \" + String(@ToDate, \"d MMMM yyyy\")"
        }
      ]
    },
    {
