            "bold": true,
            "foreColor": "#1F5FAD",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "CustomerName"
        },
        {
          "name": "CustPlace",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.3,
            "w": 6,
            "h": 0.55
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "CustCity + \", \" + CustCountry"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.65,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "alternateBackColor": "#F7F9FC",
      "elements": [
        {
          "name": "OrderNo",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 1.6,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "OrderNo"
        },
        {
          "name": "OrderDate",
          "type": "computed",
          "bounds": {
            "x": 1.6,
            "y": 0,
            "w": 2.2,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Date(OrderDay)",
          "format": "d MMM yyyy"
        },
        {
          "name": "Product",
          "type": "field",
          "bounds": {
            "x": 3.8,
            "y": 0,
            "w": 6.6,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "ItemName"
        },
        {
          "name": "Qty",
          "type": "field",
          "bounds": {
            "x": 10.4,
            "y": 0,
            "w": 1.4,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "Qty",
          "format": "#,##0"
        },
        {
          "name": "Price",
          "type": "field",
          "bounds": {
            "x": 11.8,
            "y": 0,
            "w": 2,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "Price",
          "format": "#,##0.00"
        },
        {
          "name": "Disc",
          "type": "computed",
          "bounds": {
            "x": 13.8,
            "y": 0,
            "w": 1.4,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Iif(Disc = 0, \"\", String(Disc * 100, \"0\") + \"%\")"
        },
        {
          "name": "Amount",
          "type": "computed",
          "bounds": {
            "x": 15.2,
            "y": 0,
            "w": 2.8,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Price * Qty * (1 - Disc)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "groupByColumns": [
        "CustomerName"
      ],
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "CustText",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 10.4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Customer total - \" + Count(OrderNo for group 1 distinct OrderNo) + \" order(s)\""
        },
        {
          "name": "CustQty",
          "type": "computed",
          "bounds": {
            "x": 10.4,
            "y": 0.1,
            "w": 1.4,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(Qty for group 1)",
          "format": "#,##0"
        },
        {
          "name": "CustAmount",
          "type": "computed",
          "bounds": {
            "x": 15.2,
            "y": 0.1,
            "w": 2.8,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(Price * Qty * (1 - Disc) for group 1)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "MonthText",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.25,
            "w": 10.4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Month total - \" + Count(CustomerName for all distinct CustomerName) + \" customers, \" + Count(OrderNo for all distinct OrderNo) + \" orders\""
        },
        {
          "name": "MonthQty",
          "type": "computed",
          "bounds": {
            "x": 10.4,
            "y": 0.25,
            "w": 1.4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(Qty for all)",
          "format": "#,##0"
        },
        {
          "name": "MonthAmount",
          "type": "computed",
          "bounds": {
            "x": 13.7,
            "y": 0.25,
            "w": 4.3,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(Price * Qty * (1 - Disc) for all)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Footer",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 12,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Northwind Traders - Monthly Sales by Customer"
        },
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataMessage": "No orders in this month.",
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}