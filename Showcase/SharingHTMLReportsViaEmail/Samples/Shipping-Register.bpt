{
  "version": "1.0",
  "metadata": {
    "name": "Monthly Shipping Register",
    "description": "The orders of the month by shipper: where they went, when they were due and shipped, and the freight. Late and unshipped orders are in red.",
    "author": "BluePrint"
  },
  "report": {
    "type": "canvas",
    "layoutUnit": "cm",
    "page": {
      "paperSize": {
        "name": "A4",
        "widthMm": 210,
        "heightMm": 297
      },
      "orientation": "portrait",
      "margins": {
        "top": 1.5,
        "bottom": 1.5,
        "left": 1.5,
        "right": 1.5
      },
      "backgroundColor": "#FFFFFF"
    }
  },
  "dataSource": {
    "dataSourceType": "dbsql",
    "sql": "SELECT sh.CompanyName AS ShipperName, o.OrderID AS OrderNo, c.CompanyName AS CustomerName,\n       o.ShipCity AS ShipToCity, o.ShipCountry AS ShipToCountry,\n       {bp:DateText(o.OrderDate)} AS OrderDay, {bp:DateText(o.RequiredDate)} AS DueDay,\n       {bp:DateText(o.ShippedDate)} AS ShipDay, {bp:DiffDays(o.RequiredDate, o.ShippedDate)} AS DaysLate,\n       o.Freight AS FreightCost\nFROM Orders o\nJOIN Customers c ON c.CustomerID = o.CustomerID\nJOIN Shippers sh ON sh.ShipperID = o.ShipVia\nWHERE {bp:DateText(o.OrderDate)} >= {bp:DateText(@FromDate)}\n  AND {bp:DateText(o.OrderDate)} <= {bp:DateText(@ToDate)}\nORDER BY ShipperName, OrderNo",
    "arguments": [
      {
        "name": "FromDate",
        "argType": "date"
      },
      {
        "name": "ToDate",
        "argType": "date"
      }
    ],
    "columns": [
      {
        "name": "ShipperName",
        "dbType": "string"
      },
      {
        "name": "OrderNo",
        "dbType": "int64"
      },
      {
        "name": "CustomerName",
        "dbType": "string"
      },
      {
        "name": "ShipToCity",
        "dbType": "string"
      },
      {
        "name": "ShipToCountry",
        "dbType": "string"
      },
      {
        "name": "OrderDay",
        "dbType": "object"
      },
      {
        "name": "DueDay",
        "dbType": "object"
      },
      {
        "name": "ShipDay",
        "dbType": "object"
      },
      {
        "name": "DaysLate",
        "dbType": "object"
      },
      {
        "name": "FreightCost",
        "dbType": "decimal"
      }
    ]
  },
  "sortColumns": [],
  "localization": {
    "sourceLanguage": "en",
    "languages": [
      "en"
    ],
    "cultures": {
      "en": "en-US"
    }
  },
  "sections": [
    {
      "type": "reportHeader",
      "height": 2.1,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "AccentBar",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 18,
            "h": 0.12
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 2,
            "foreColor": "#1F5FAD",
            "backColor": "#1F5FAD",
            "hAlign": "left",
            "vAlign": "top"
          },
          "text": ""
        },
        {
          "name": "Title",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.3,
            "w": 18,
            "h": 0.9
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 18,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Monthly Shipping Register"
        },
        {
          "name": "Subtitle",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 1.25,
            "w": 18,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Orders from \" + String(@FromDate, \"d MMMM yyyy\") + \" to \" + String(@ToDate, \"d MMMM yyyy\")"
        }
      ]
    },
    {
      "type": "pageHeader",
      "height": 0.7,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "H1",
