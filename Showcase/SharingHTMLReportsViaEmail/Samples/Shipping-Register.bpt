        }
      ]
    },
    {
      "type": "groupHeader",
      "groupLevel": 1,
      "groupByColumns": [
        "ShipperName"
      ],
      "keepHeaderWithFirstDetailRow": true,
      "height": 0.9,
      "repeatOnNewPage": false,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "ShipperHead",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0.15,
            "w": 12,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 12.5,
            "bold": true,
            "foreColor": "#1F5FAD",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "source": "ShipperName"
        }
      ]
    },
    {
      "type": "detail",
      "height": 0.65,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "alternateBackColor": "#F7F9FC",
      "elements": [
        {
          "name": "OrderNo",
          "type": "field",
          "bounds": {
            "x": 0,
            "y": 0,
            "w": 1.2,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "OrderNo"
        },
        {
          "name": "Customer",
          "type": "field",
          "bounds": {
            "x": 1.2,
            "y": 0,
            "w": 4.5,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "CustomerName"
        },
        {
          "name": "ShipTo",
          "type": "computed",
          "bounds": {
            "x": 5.7,
            "y": 0,
            "w": 4.4,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "ShipToCity + \", \" + ShipToCountry"
        },
        {
          "name": "Ordered",
          "type": "computed",
          "bounds": {
            "x": 10.1,
            "y": 0,
            "w": 1.4,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Date(OrderDay)",
          "format": "d MMM"
        },
        {
          "name": "Required",
          "type": "computed",
          "bounds": {
            "x": 11.5,
            "y": 0,
            "w": 1.7,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Date(DueDay)",
          "format": "d MMM"
        },
        {
          "name": "Shipped",
          "type": "computed",
          "bounds": {
            "x": 13.2,
            "y": 0,
            "w": 2,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "foreColorExpression": "Iif(IsNull(ShipDay), \"#B00000\", Iif(DaysLate > 0, \"#B00000\", \"#1F2937\"))",
            "hAlign": "left",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Iif(IsNull(ShipDay), \"Not shipped\", String(Date(ShipDay), \"d MMM\"))"
        },
        {
          "name": "DaysLate",
          "type": "computed",
          "bounds": {
            "x": 15.2,
            "y": 0,
            "w": 1,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "foreColorExpression": "Iif(IsNull(ShipDay), \"#B00000\", Iif(DaysLate > 0, \"#B00000\", \"#1F2937\"))",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "expression": "Iif(DaysLate > 0, String(DaysLate, \"0\"), \"\")"
        },
        {
          "name": "Freight",
          "type": "field",
          "bounds": {
            "x": 16.2,
            "y": 0,
            "w": 1.8,
            "h": 0.65
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "middle",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "bottom": {
                "style": "solid",
                "color": "#E3E7EC",
                "width": 0.5
              }
            }
          },
          "source": "FreightCost",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "groupFooter",
      "groupLevel": 1,
      "groupByColumns": [
        "ShipperName"
      ],
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "ShipperText",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 16.2,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "Count(OrderNo for group 1) + \" order(s), \" + Sum(Iif(IsNull(ShipDay), 1, 0) for group 1) + \" not shipped, \" + Sum(Iif(DaysLate > 0, 1, 0) for group 1) + \" shipped late\""
        },
        {
          "name": "ShipperFreight",
          "type": "computed",
          "bounds": {
            "x": 16.2,
            "y": 0.1,
            "w": 1.8,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(FreightCost for group 1)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "reportFooter",
      "height": 1.2,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "MonthText",
          "type": "computed",
          "bounds": {
            "x": 0,
            "y": 0.25,
            "w": 14.4,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Month total - \" + Count(OrderNo for all) + \" orders, \" + Sum(Iif(IsNull(ShipDay), 1, 0) for all) + \" not shipped, \" + Sum(Iif(DaysLate > 0, 1, 0) for all) + \" shipped late\""
        },
        {
          "name": "MonthFreight",
          "type": "computed",
          "bounds": {
            "x": 14.4,
            "y": 0.25,
            "w": 3.6,
            "h": 0.7
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "bold": true,
            "foreColor": "#1F2937",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05,
            "border": {
              "uniform": false,
              "top": {
                "style": "solid",
                "color": "#6B7280",
                "width": 0.75
              }
            }
          },
          "expression": "Sum(FreightCost for all)",
          "format": "#,##0.00"
        }
      ]
    },
    {
      "type": "pageFooter",
      "height": 0.8,
      "repeatOnNewPage": true,
      "backColor": "Transparent",
      "elements": [
        {
          "name": "Footer",
          "type": "label",
          "bounds": {
            "x": 0,
            "y": 0.1,
            "w": 12,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "left",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "text": "Northwind Traders - Monthly Shipping Register"
        },
        {
          "name": "PageInfo",
          "type": "computed",
          "bounds": {
            "x": 12,
            "y": 0.1,
            "w": 6,
            "h": 0.6
          },
          "style": {
            "fontFamily": "Segoe UI",
            "fontSize": 8.5,
            "foreColor": "#6B7280",
            "backColor": "Transparent",
            "hAlign": "right",
            "vAlign": "top",
            "paddingLeft": 0.1,
            "paddingRight": 0.05
          },
          "expression": "\"Page \" + Page() + \" of \" + TotalPages()"
        }
      ]
    }
  ],
  "noDataMessage": "No orders in this month.",
  "noDataShowStructure": true,
  "paddingFullPage": false,
  "slotData": []
}