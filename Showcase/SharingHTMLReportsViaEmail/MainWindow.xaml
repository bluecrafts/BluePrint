<Window x:Class="SharingHtmlReports.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BluePrint.UI.Controls;assembly=BluePrint.UI"
        xmlns:bh="clr-namespace:BluePrint.UI.Behaviors;assembly=BluePrint.UI"
        xmlns:local="clr-namespace:SharingHtmlReports"
        xmlns:reports="clr-namespace:SharingHtmlReports.Reports"
        xmlns:rw="clr-namespace:BluePrint.Render.WPF.Controls;assembly=BluePrint.Render.WPF"
        Title="Sharing HTML Reports via Email" Width="1440" Height="900" MinWidth="1040" MinHeight="640">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The theme's toolbar buttons are sized for 16 px icons (a fixed button
                 height). These carry 24 px icons: let the height follow the icon, with
                 the same padding on every side, for square 34 x 34 buttons. -->
            <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button"
                   BasedOn="{StaticResource Bp.Button.Toolbar}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Padding" Value="4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="local:AppCommands.Retrieve"      Executed="Retrieve_Executed"      CanExecute="CanRetrieve_CanExecute" />
        <CommandBinding Command="local:AppCommands.Send"          Executed="Send_Executed"          CanExecute="CanSend_CanExecute" />
        <CommandBinding Command="local:AppCommands.SaveEml"       Executed="SaveEml_Executed"       CanExecute="CanSaveEml_CanExecute" />
        <CommandBinding Command="local:AppCommands.OpenInMailApp" Executed="OpenInMailApp_Executed" CanExecute="CanSaveEml_CanExecute" />
        <CommandBinding Command="local:AppCommands.OpenInBrowser" Executed="OpenInBrowser_Executed" CanExecute="HasEmail_CanExecute" />
        <CommandBinding Command="local:AppCommands.ShowReportTab" Executed="ShowReportTab_Executed" />
        <CommandBinding Command="local:AppCommands.ShowEmailTab"  Executed="ShowEmailTab_Executed" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open Samples _Folder" Click="OpenSamplesFolder_Click"
                          ToolTip="Show the Samples folder in File Explorer: the reports this application can send" />
                <MenuItem Header="Refresh _Reports" Click="RefreshReports_Click"
                          ToolTip="Read the Samples folder again, after you added or changed a report" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem Header="_Retrieve" Command="local:AppCommands.Retrieve"
                          ToolTip="Read the selected month from the Northwind database again" />
            </MenuItem>
            <MenuItem Header="_Mail">
                <MenuItem Header="_Send" Command="local:AppCommands.Send" ToolTipService.ShowOnDisabled="True"
                          ToolTip="Send the message through the SMTP server" />
                <MenuItem Header="Save ._eml..." Command="local:AppCommands.SaveEml" ToolTipService.ShowOnDisabled="True"
                          ToolTip="Save the message as a file that any mail program opens" />
                <MenuItem Header="Open in Mail _App" Command="local:AppCommands.OpenInMailApp" ToolTipService.ShowOnDisabled="True"
                          ToolTip="Open the message in the mail program of this computer, ready to send" />
                <Separator />
                <MenuItem Header="Open in _Browser" Command="local:AppCommands.OpenInBrowser"
                          ToolTip="Show the body of the message in your web browser" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Report" Command="local:AppCommands.ShowReportTab" />
                <MenuItem Header="_Email" Command="local:AppCommands.ShowEmailTab" />
                <Separator />
                <MenuItem x:Name="LeftPanelMenuItem" Header="_Left Panel" IsCheckable="True" IsChecked="True"
                          Click="LeftPanelMenuItem_Click" ToolTip="Show or hide the panel on the left: Reports and Month" />
                <MenuItem x:Name="RightPanelMenuItem" Header="R_ight Panel" IsCheckable="True" IsChecked="True"
                          Click="RightPanelMenuItem_Click" ToolTip="Show or hide the panel on the right: the email and how to send it" />
                <!-- Theme > Light / Dark / System is added here by MainWindow.xaml.cs -->
                <Separator x:Name="ThemeSeparator" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Which _layout works in which mail program" Click="LayoutHelp_Click" />
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <Button Command="local:AppCommands.Retrieve" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Retrieve"
                        ToolTip="Retrieve: read the selected month from the Northwind database again (Ctrl+R)">
                    <Path Data="{StaticResource Icon.Retrieve}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Separator />
                <Button Command="local:AppCommands.Send" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Send"
                        ToolTip="Send the message through the SMTP server (Ctrl+Enter)">
                    <Path Data="{StaticResource Icon.Send}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Button Command="local:AppCommands.SaveEml" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Save .eml"
                        ToolTip="Save the message as an .eml file (Ctrl+S)">
                    <Path Data="{StaticResource Icon.SaveEml}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Button Command="local:AppCommands.OpenInMailApp" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Open in Mail App"
                        ToolTip="Open the message in the mail program of this computer, ready to send (Ctrl+Shift+O)">
                    <Path Data="{StaticResource Icon.OpenMail}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
                <Separator />
                <Button Command="local:AppCommands.OpenInBrowser" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Open in Browser"
                        ToolTip="Show the body of the message in your web browser (Ctrl+B)">
                    <Path Data="{StaticResource Icon.Browser}" Style="{StaticResource Bp.ToolIcon}" />
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right" Margin="0,0,8,0">
                <TextBlock x:Name="StatusReportText" Foreground="{DynamicResource Bp.Brush.Text.Secondary}" />
            </StatusBarItem>
            <StatusBarItem>
                <!-- The last thing that happened. Each message replaces the one before; the full text is in the tooltip. -->
                <StackPanel x:Name="StatusPanel" Orientation="Horizontal">
                    <ui:BpStatusIcon x:Name="StatusIcon" Kind="Information" AlignToTextBaseline="True"
                                     Margin="0,0,6,0" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Left: what to send (a report, a month). Centre: what the recipient gets.
             Right: who gets it and how it is sent. -->
        <Grid Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="280" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftPane" Background="{DynamicResource Bp.Brush.Surface.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- Reports: every .bpt file in the Samples folder (MainWindow.Reports.cs) -->
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                            MinHeight="{DynamicResource Bp.Size.Header.Height}">
                        <TextBlock Text="Reports" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Bp.Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                            Padding="8,6,8,8" x:Name="ReportDescriptionPanel" Visibility="Collapsed">
                        <TextBlock x:Name="ReportDescriptionText" TextWrapping="Wrap" Style="{DynamicResource Bp.Text.Caption}" />
                    </Border>
                    <Grid>
                        <ListBox x:Name="ReportsList" BorderThickness="0" SelectionChanged="ReportsList_SelectionChanged"
                                 AutomationProperties.Name="Reports">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type reports:ReportEntry}">
                                    <StackPanel Orientation="Horizontal" Margin="8,2,4,2" ToolTip="{Binding ToolTipText}">
                                        <TextBlock x:Name="ReportName" Text="{Binding Name}" VerticalAlignment="Top" />
                                        <ui:BpStatusIcon x:Name="ReportWarning" Kind="Warning" AlignToTextBaseline="True" Margin="6,0,0,0"
                                                         Visibility="Collapsed" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CanRetrieve}" Value="False">
                                            <Setter TargetName="ReportName" Property="Foreground" Value="{DynamicResource Bp.Brush.Text.Secondary}" />
                                            <Setter TargetName="ReportWarning" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoReportsText" Text="No reports in the Samples folder."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" Visibility="Collapsed"
                                   TextWrapping="Wrap" TextAlignment="Center" Style="{DynamicResource Bp.Text.Caption}" />
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource Bp.Brush.Border.Default}" />

                <!-- Month: the months with orders, newest first, by year (MainWindow.Months.cs) -->
                <DockPanel Grid.Row="2">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                            MinHeight="{DynamicResource Bp.Size.Header.Height}">
                        <TextBlock Text="Month" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="MonthCountText" DockPanel.Dock="Bottom" Margin="8,4,8,8"
                               Style="{DynamicResource Bp.Text.Caption}" />
                    <Grid>
                        <ListBox x:Name="MonthsList" BorderThickness="0" SelectionChanged="MonthsList_SelectionChanged" IsSynchronizedWithCurrentItem="False"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" AutomationProperties.Name="Month">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource Bp.Text.Caption}" Margin="4,8,4,2" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type reports:MonthEntry}">
                                    <DockPanel Margin="8,2,4,2" ToolTip="{Binding ToolTipText}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OrdersText}" Style="{DynamicResource Bp.Text.Caption}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- northwind.db missing or unreadable -->
                        <StackPanel x:Name="NoDatabasePanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="12" Visibility="Collapsed">
                            <ui:BpStatusIcon Kind="Error" AlignToTextBaseline="True" Margin="0,0,6,0"
                                             TextElement.FontSize="{DynamicResource Bp.Font.Size.Caption}" />
                            <TextBlock x:Name="NoDatabaseText" TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Top"
                                       Style="{DynamicResource Bp.Text.Caption}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" x:Name="LeftSplitter" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Bp.Brush.Border.Default}" />

            <!-- Centre: the report as it prints, and the message as it is sent -->
            <DockPanel Grid.Column="2">
                <ProgressBar x:Name="RetrieveProgress" DockPanel.Dock="Top" Height="2" IsIndeterminate="True"
                             Visibility="Hidden" AutomationProperties.Name="Retrieving" />
                <TabControl x:Name="PreviewTabs" SelectionChanged="PreviewTabs_SelectionChanged">
                    <TabItem x:Name="ReportTab" Header="Report">
                        <Grid>
                            <!-- The control has its own toolbar: zoom, pages, print and export -->
                            <rw:BluePrintPreviewControl x:Name="Preview" />
                            <Border x:Name="PreviewMessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                    Visibility="Collapsed" IsHitTestVisible="False"
                                    Background="{DynamicResource Bp.Brush.Surface.Window}" BorderBrush="{DynamicResource Bp.Brush.Border.Default}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Bp.CornerRadius.Card}"
                                    Padding="{DynamicResource Bp.Thickness.Card.Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:BpStatusIcon x:Name="PreviewMessageIcon" Kind="Error" AlignToTextBaseline="True" Margin="0,0,6,0" />
                                    <TextBlock x:Name="PreviewMessageText" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Top" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="EmailTab" Header="Email">
                        <DockPanel>
                            <!-- Who it goes to, and how big it is -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Bp.Brush.Surface.Alt}" Padding="8,4"
                                    BorderBrush="{DynamicResource Bp.Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:BpStatusIcon x:Name="EmailSizeIcon" Kind="Warning" AlignToTextBaseline="True" Margin="0,0,6,0"
                                                         Visibility="Collapsed" />
                                        <TextBlock x:Name="EmailSizeText" VerticalAlignment="Top" Style="{DynamicResource Bp.Text.Caption}" />
                                    </StackPanel>
                                    <TextBlock x:Name="EmailHeaderText" TextTrimming="CharacterEllipsis" Style="{DynamicResource Bp.Text.Caption}"
                                               VerticalAlignment="Top" />
                                </DockPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Bottom" Margin="8,4,8,4" Style="{DynamicResource Bp.Text.Caption}" TextWrapping="Wrap"
                                       Text="Shown with the Windows web control, which is close to Outlook for Windows. Open in Browser shows it as a modern web browser does." />
                            <Grid>
                                <!-- The body of the message, from a temporary file (MainWindow.Email.cs) -->
                                <WebBrowser x:Name="EmailView" AutomationProperties.Name="Email body" />
                                <TextBlock x:Name="EmailEmptyText" Text="Select a report and a month."
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource Bp.Text.Caption}" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <GridSplitter Grid.Column="3" x:Name="RightSplitter" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Bp.Brush.Border.Default}" />

            <!-- Right: the email above (saved as soon as a field changes), the buttons pinned below -->
            <DockPanel Grid.Column="4" x:Name="RightPane" Background="{DynamicResource Bp.Brush.Surface.Panel}">
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Bp.Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                        Padding="12,8,12,12">
                    <StackPanel>
                        <ProgressBar x:Name="SendProgress" Height="2" IsIndeterminate="True" Margin="0,0,0,8" Visibility="Collapsed"
                                     AutomationProperties.Name="Sending" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SaveEmlButton" Content="Save .eml..." Command="local:AppCommands.SaveEml" Margin="0,0,8,0"
                                    ToolTipService.ShowOnDisabled="True" ToolTip="Save the message as an .eml file (Ctrl+S)" />
                            <Button x:Name="SendButton" Content="Send" Style="{DynamicResource Bp.Button.Primary}"
                                    Command="local:AppCommands.Send" ToolTipService.ShowOnDisabled="True" />
                            <Button x:Name="CancelSendButton" Content="Cancel" Click="CancelSend_Click" Visibility="Collapsed"
                                    ToolTip="Stop sending (Esc)" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2"
                                MinHeight="{DynamicResource Bp.Size.Header.Height}">
                            <TextBlock Text="Email" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                        </Border>
                        <Grid Margin="12,8,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox x:Name="FromBox" Grid.Column="1" Margin="0,0,0,8" bh:BpInput.Placeholder="reports@example.com"
                                     LostFocus="MailField_LostFocus" TextChanged="MailField_TextChanged" AutomationProperties.Name="From"
                                     ToolTip="The sender. Your SMTP server may require it to be your own address." />

                            <TextBlock Grid.Row="1" Text="To" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                     bh:BpInput.Placeholder="someone@example.com; another@example.com"
                                     LostFocus="MailField_LostFocus" TextChanged="MailField_TextChanged" AutomationProperties.Name="To"
                                     ToolTip="One or more recipients, separated by commas or semicolons." />

                            <TextBlock Grid.Row="2" Text="Cc" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox x:Name="CcBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                     LostFocus="MailField_LostFocus" TextChanged="MailField_TextChanged" AutomationProperties.Name="Cc"
                                     ToolTip="Optional: more recipients, separated by commas or semicolons." />

                            <TextBlock Grid.Row="3" Text="Subject" VerticalAlignment="Top" Margin="0,4,8,8" />
                            <TextBox x:Name="SubjectBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                                     LostFocus="MailField_LostFocus" TextChanged="MailField_TextChanged"
                                     AutomationProperties.Name="Subject"
                                     ToolTip="Follows the report and the month you choose. Where you keep the name of the report or the month in your own subject, the next one takes its place." />

                            <TextBlock Grid.Row="4" Text="Message" VerticalAlignment="Top" Margin="0,4,8,0" />
                            <TextBox x:Name="MessageTextBox" Grid.Row="4" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     LostFocus="MailField_LostFocus" TextChanged="MailField_TextChanged" AutomationProperties.Name="Message"
                                     ToolTip="Shown above the report. Plain text." />
                        </Grid>
                        <ui:BpStatusLines x:Name="MailProblemLines" Margin="12,0,12,8" />

                        <Border Background="{DynamicResource Bp.Brush.Surface.Header}" Padding="8,2" Margin="0,4,0,0"
                                MinHeight="{DynamicResource Bp.Size.Header.Height}">
                            <TextBlock Text="HTML" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,8,12,8">
                            <TextBlock Text="Layout" Style="{DynamicResource Bp.Text.Label}" Margin="0,0,0,4" />
                            <RadioButton x:Name="StyledTableRadio" Content="Styled table" GroupName="Layout" Checked="HtmlOption_Changed"
                                         AutomationProperties.Name="Styled table" />
                            <TextBlock Text="A table with the colours, fonts and lines of the report on every cell. Shows the same in every mail program."
                                       Style="{DynamicResource Bp.Text.Caption}" TextWrapping="Wrap" Margin="24,2,0,6" />
                            <RadioButton x:Name="PlainTableRadio" Content="Plain table" GroupName="Layout" Checked="HtmlOption_Changed"
                                         AutomationProperties.Name="Plain table" />
                            <TextBlock Text="A table with no styles at all: the smallest message, without colours or lines."
                                       Style="{DynamicResource Bp.Text.Caption}" TextWrapping="Wrap" Margin="24,2,0,6" />
                            <RadioButton x:Name="AbsoluteRadio" Content="Absolute" GroupName="Layout" Checked="HtmlOption_Changed"
                                         AutomationProperties.Name="Absolute" />
                            <TextBlock Text="Every text where it is on paper, like the PDF. Gmail and Outlook for Windows cannot show it."
                                       Style="{DynamicResource Bp.Text.Caption}" TextWrapping="Wrap" Margin="24,2,0,8" />

                            <TextBlock x:Name="TablePagesLabel" Text="Table pages" Style="{DynamicResource Bp.Text.Label}" Margin="0,4,0,4" />
                            <StackPanel x:Name="TablePagesPanel" Orientation="Horizontal" ToolTipService.ShowOnDisabled="True">
                                <RadioButton x:Name="OnePageRadio" Content="One page" GroupName="TablePages" Checked="HtmlOption_Changed"
                                             ToolTip="One table for the whole month: column headings and page numbers once." />
                                <RadioButton x:Name="PerPageRadio" Content="Per page" GroupName="TablePages" Checked="HtmlOption_Changed"
                                             Margin="16,0,0,0" ToolTip="One table per printed page, like the paper report." />
                            </StackPanel>

                            <TextBlock x:Name="PageFlowLabel" Text="Export mode" Style="{DynamicResource Bp.Text.Label}" Margin="0,12,0,4" />
                            <ComboBox x:Name="PageFlowCombo" SelectionChanged="HtmlOption_Changed" AutomationProperties.Name="Export mode"
                                      ToolTipService.ShowOnDisabled="True">
                                <ComboBoxItem Content="Single file" Tag="SingleFile"
                                              ToolTip="One long page: page headers and footers only at the top and at the end." />
                                <ComboBoxItem Content="Single file, paged" Tag="SingleFilePaged"
                                              ToolTip="The printed pages one under the other, each with its page header and footer." />
                            </ComboBox>

                            <CheckBox x:Name="AttachHtmlCheck" Content="Attach as .html file" Margin="0,12,0,0"
                                      Checked="HtmlOption_Changed" Unchecked="HtmlOption_Changed"
                                      ToolTip="Also attach the full report, laid out like the PDF, for opening in a web browser." />

                            <TextBlock x:Name="EmailSummaryText" Margin="0,12,0,0" />
                            <ui:BpStatusLines x:Name="EmailNotesLines" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- SMTP server: closed until it is needed. Save .eml and Open in Mail App work without it. -->
                        <Expander x:Name="SmtpExpander" Margin="0,4,0,8" Expanded="SmtpExpander_Changed" Collapsed="SmtpExpander_Changed"
                                  AutomationProperties.Name="SMTP server">
                            <Expander.Header>
                                <TextBlock Text="SMTP server" Style="{DynamicResource Bp.Text.Label}" VerticalAlignment="Center" />
                            </Expander.Header>
                            <Grid Margin="12,8,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <TextBox x:Name="HostBox" Grid.Column="1" Margin="0,0,0,8" bh:BpInput.Placeholder="smtp.example.com"
                                         LostFocus="SmtpField_LostFocus" TextChanged="SmtpField_TextChanged" AutomationProperties.Name="Host" />

                                <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" HorizontalAlignment="Left" MinWidth="80"
                                         LostFocus="SmtpField_LostFocus" TextChanged="SmtpField_TextChanged" AutomationProperties.Name="Port"
                                         ToolTip="587 for STARTTLS, 25 for a relay without encryption." />

                                <TextBlock Grid.Row="2" Text="Security" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <ComboBox x:Name="SecurityCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                          SelectionChanged="SmtpField_Changed" AutomationProperties.Name="Security">
                                    <ComboBoxItem Content="STARTTLS" Tag="StartTls" />
                                    <ComboBoxItem Content="None" Tag="None" />
                                </ComboBox>

                                <TextBlock Grid.Row="3" Text="User" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <TextBox x:Name="UserBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                                         LostFocus="SmtpField_LostFocus" TextChanged="SmtpField_TextChanged" AutomationProperties.Name="User"
                                         ToolTip="Leave empty for a server that does not ask for a sign-in." />

                                <TextBlock Grid.Row="4" Text="Password" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4"
                                             PasswordChanged="PasswordBox_PasswordChanged" AutomationProperties.Name="Password" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{DynamicResource Bp.Text.Caption}" TextWrapping="Wrap"
                                           Text="Saved in plain text in the settings file next to the program." Margin="0,0,0,8" />
                            </Grid>
                        </Expander>
                        <ui:BpStatusLines x:Name="SmtpProblemLines" Margin="12,0,12,8" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
