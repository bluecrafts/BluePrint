<Window x:Class="Demo.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bp="clr-namespace:BluePrint.Designer.Controls;assembly=BluePrint.Designer"
        Title="BluePrint designer" Height="800" Width="1200">

    <DockPanel>
        <!-- The menus belong to the host. The designer has no Retrieve button of
             its own, because only the host knows where the rows come from. -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Load" Click="Load_Click"
                    ToolTip="Open another .bpt file. Press Retrieve to fill it with rows" />
            <Button Content="Retrieve" Click="Retrieve_Click"
                    ToolTip="Ask for the report's arguments, if it has any, then run its query against northwind.db" />
            <Button Content="Refresh" Click="Refresh_Click"
                    ToolTip="Render the preview again from the design as it is now, with the rows already retrieved (F5)" />
        </ToolBar>

        <!-- The design surface, the element toolbar on the left, the property panel
             and the built-in dialogs come with the control. A host only supplies the
             dialogs that reach outside the report, such as a live connection or an
             application preference. A host with a toolbar of its own hides the built-in
             one with ShowElementToolBar="False". -->
        <bp:BluePrintDesignerControl x:Name="Designer" />
    </DockPanel>

</Window>
