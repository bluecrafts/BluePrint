<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlueCrafts.BluePrint.Designer" Version="1.0.56" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same report the other two samples render. Editing a definition needs
      no database, so this sample references no driver: the query is text on the
      data source page until a host wires up a connection.
    -->
    <None Include="..\..\NorthwindBpt\nw-05-invoice.bpt" Link="nw-05-invoice.bpt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
