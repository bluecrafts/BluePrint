<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlueCrafts.BluePrint.Designer" Version="1.3.111" />
  </ItemGroup>

  <ItemGroup>
    <!-- The driver for the Northwind file, used only by Retrieve. See the note in Demo.Render.csproj. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same report the other two samples render, a second one to open with
      Load, and the database they read. Editing a definition needs no database -
      the query is text on the data source page. Only Retrieve, which the host
      wires up in MainWindow.xaml.cs, opens the file.
    -->
    <None Include="..\..\NorthwindBpt\nw-05-invoice.bpt" Link="nw-05-invoice.bpt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NorthwindBpt\nw-06-products-by-category.bpt" Link="nw-06-products-by-category.bpt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NorthwindDB\SQLite\northwind.db" Link="northwind.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
