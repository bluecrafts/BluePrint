<Window x:Class="Demo.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bp="clr-namespace:BluePrint.Render.WPF.Controls;assembly=BluePrint.Render.WPF"
        Title="BluePrint preview" Height="800" Width="700">

    <DockPanel>

        <!-- The same report, filled three different ways. Each button retrieves
             again and hands the result to the control; the page that comes out
             is the same whichever one is pressed. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button x:Name="RetrieveButton"
                    Content="Retrieve"
                    Click="Retrieve_Click"
                    Margin="0,0,8,0" Padding="12,4"
                    ToolTip="Run the query the .bpt carries. Its {bp:...} calls are rendered for whichever database the connection points at." />
            <Button x:Name="SetSqlButton"
                    Content="Set SQL query before retrieve"
                    Click="SetSql_Click"
                    Margin="0,0,8,0" Padding="12,4"
                    ToolTip="Replace the query with SQLite SQL of our own, then let BluePrint retrieve it." />
            <Button x:Name="SetDataTableButton"
                    Content="Set DataTable before retrieve"
                    Click="SetDataTable_Click"
                    Padding="12,4"
                    ToolTip="Query with Microsoft.Data.Sqlite directly and hand the rows over as a DataTable." />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status" />
        </StatusBar>

        <!-- The control renders, paginates, zooms and prints on its own. Hand it
             a report definition and a data provider and it does the rest. -->
        <bp:BluePrintPreviewControl x:Name="Preview" />

    </DockPanel>

</Window>
