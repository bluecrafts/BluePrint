<Window x:Class="Demo.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bp="clr-namespace:BluePrint.Render.WPF.Controls;assembly=BluePrint.Render.WPF"
        Title="BluePrint preview" Height="800" Width="700">

    <DockPanel>

        <!-- The same report, filled through four ways of reaching the database.
             Each button does the whole job on its own - load the report, put the
             rows in it, show it - and the page that comes out is the same
             whichever one is pressed. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button x:Name="OwnConnectionButton"
                    Content="Own DbConnection"
                    Click="OwnConnection_Click"
                    Margin="0,0,8,0" Padding="12,4"
                    ToolTip="We give the report a connection. It runs the query in the .bpt on it: report.RetrieveAsync(connection)." />
            <Button x:Name="ProfileButton"
                    Content="Connection Profile"
                    Click="Profile_Click"
                    Margin="0,0,8,0" Padding="12,4"
                    ToolTip="We describe the database. The report connects, runs the query in the .bpt, and disconnects: report.RetrieveAsync(profile)." />
            <Button x:Name="OwnConnectionSetSqlButton"
                    Content="Own DbConnection + SetSql"
                    Click="OwnConnectionSetSql_Click"
                    Margin="0,0,8,0" Padding="12,4"
                    ToolTip="As Own DbConnection, but the query is our own SQLite SQL, set on the report first: report.SetSql(...)." />
            <Button x:Name="OwnQueryButton"
                    Content="Own Query + List"
                    Click="OwnQuery_Click"
                    Padding="12,4"
                    ToolTip="We query with the driver ourselves and give the report a List of objects: report.SetData(list)." />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status" />
        </StatusBar>

        <!-- The control renders, paginates, zooms and prints on its own. Hand it
             the report - Preview.ReportDocument = report - and it does the rest. -->
        <bp:BluePrintPreviewControl x:Name="Preview" />

    </DockPanel>

</Window>
