<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlueCrafts.BluePrint.Render.WPF" Version="1.3.111" />
  </ItemGroup>

  <ItemGroup>
    <!-- The driver for the Northwind file. See the note in Demo.Render.csproj. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The report, and the database it reads. Both shared with Demo.Render.
         The code that reads them lives in MainWindow.xaml.cs, one button at a time.
         nw-06 is a second report to open with Load. -->
    <None Include="..\..\NorthwindBpt\nw-05-invoice.bpt" Link="nw-05-invoice.bpt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NorthwindBpt\nw-06-products-by-category.bpt" Link="nw-06-products-by-category.bpt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NorthwindDB\SQLite\northwind.db" Link="northwind.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
