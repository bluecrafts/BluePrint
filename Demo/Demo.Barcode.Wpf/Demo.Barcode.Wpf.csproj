<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Demo.Barcode.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      One package, targeting net10.0. A net10.0-windows application takes it
      unchanged: the encoder knows nothing about WPF, which is exactly what
      makes it drawable by WPF.
    -->
    <PackageReference Include="BlueCrafts.BluePrint.Barcode" Version="1.0.56" />
  </ItemGroup>

  <ItemGroup>
    <!-- One sample list shared with Demo.Barcode. -->
    <Compile Include="..\BarcodeSamples.cs" Link="BarcodeSamples.cs" />
  </ItemGroup>

</Project>
