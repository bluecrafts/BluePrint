<Window x:Class="Demo.Barcode.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Demo.Barcode.Wpf"
        Title="BluePrint.Barcode" Height="800" Width="1240"
        MinHeight="640" MinWidth="1020"
        FontFamily="{StaticResource Ui}"
        Background="{StaticResource Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== header ==================================================== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="24,16,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource Title}" Text="BluePrint.Barcode" />
                    <TextBlock Style="{StaticResource Lede}" Margin="0,3,0,0" MaxWidth="820"
                               HorizontalAlignment="Left"
                               Text="Every symbology the library encodes, drawn by WPF straight from the module grid. Change the value and the symbol is re-encoded as you type; when a value cannot be carried, the reason appears along the bottom instead of a symbol nobody could scan." />
                </StackPanel>

                <TabControl Grid.Row="1" x:Name="Views" Margin="0,12,0,0" SelectionChanged="Views_SelectionChanged">
                    <TabItem Header="Explore" />
                    <TabItem Header="All symbologies" />
                </TabControl>
            </Grid>
        </Border>

        <!-- ===== explore =================================================== -->
        <Grid Grid.Row="1" x:Name="ExplorePage" Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- the list of symbologies -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}"
                               Margin="10,0,0,8" Text="SYMBOLOGY" />
                    <ListBox x:Name="SymbologyList" SelectionChanged="SymbologyList_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}"
                                                   Margin="10,12,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Data}" Style="{StaticResource Code}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- the symbol itself -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0" Padding="24">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                        <TextBlock x:Name="SampleNote" Style="{StaticResource Lede}" />
                        <TextBlock x:Name="SampleHri" Style="{StaticResource Code}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!--
                        The white card behind the symbol is not decoration. A
                        barcode needs a light quiet zone around it, so the
                        drawing surface owns the paper colour and the symbol is
                        never left sitting on whatever happens to be behind it.
                    -->
                    <Border x:Name="PaperSurface" Background="White" CornerRadius="6"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20">
                        <Grid>
                            <local:BarcodeView x:Name="Preview"
                                               HriFontSize="15"
                                               MessageBrush="{StaticResource Danger}">
                                <local:BarcodeView.LayoutTransform>
                                    <RotateTransform x:Name="PreviewRotation" Angle="0" />
                                </local:BarcodeView.LayoutTransform>
                            </local:BarcodeView>

                            <!-- Shown in place of the symbol when the value cannot be encoded. -->
                            <TextBlock x:Name="PreviewMessage" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                                       Foreground="{StaticResource Muted}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- what can be changed -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="VALUE" />
                        <TextBox x:Name="DataBox" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="110"
                                 MaxLength="2000" TextChanged="Input_Changed" />
                        <Button Content="Back to the sample value" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Click="ResetValue_Click" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="ERROR CORRECTION (QR CODE)" />
                        <ComboBox x:Name="EcBox" SelectionChanged="Input_Changed">
                            <ComboBoxItem Content="L - about 7 percent" />
                            <ComboBoxItem Content="M - about 15 percent" />
                            <ComboBoxItem Content="Q - about 25 percent" />
                            <ComboBoxItem Content="H - about 30 percent" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="MODULE SIZE" />
                        <CheckBox x:Name="FitCheck" Content="Fill the space available" IsChecked="True"
                                  Margin="0,0,0,4" Checked="Input_Changed" Unchecked="Input_Changed" />
                        <DockPanel>
                            <TextBlock x:Name="ModuleValue" DockPanel.Dock="Right" Width="34"
                                       TextAlignment="Right" Foreground="{StaticResource Muted}" />
                            <Slider x:Name="ModuleSlider" Minimum="1" Maximum="14" Value="4"
                                    TickFrequency="1" ValueChanged="Input_Changed" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="READABLE LINE" />
                        <CheckBox x:Name="HriCheck" Content="Print the text under the bars"
                                  Margin="0,0,0,0" Checked="Input_Changed" Unchecked="Input_Changed" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="ROTATION" />
                        <ComboBox x:Name="RotationBox" SelectedIndex="0" SelectionChanged="Input_Changed">
                            <ComboBoxItem Content="Upright" Tag="0" />
                            <ComboBoxItem Content="Quarter turn right" Tag="90" />
                            <ComboBoxItem Content="Upside down" Tag="180" />
                            <ComboBoxItem Content="Quarter turn left" Tag="270" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="INK" />
                        <ComboBox x:Name="InkBox" SelectedIndex="0" SelectionChanged="Input_Changed">
                            <ComboBoxItem Content="Black on white" />
                            <ComboBoxItem Content="Dark blue on white" />
                            <ComboBoxItem Content="White on black" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource Lede}" Margin="0,6,0,0"
                                   Text="A scanner reads contrast, not colour, and it expects the dark part to be the bars. Light bars on a dark ground are the one combination to avoid." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="SAVE" />
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button x:Name="SavePngButton" Content="PNG..." Margin="0,0,4,0" Click="SavePng_Click" />
                            <Button x:Name="SaveSvgButton" Content="SVG..." Margin="4,0,0,0" Click="SaveSvg_Click" />
                        </UniformGrid>
                        <Button x:Name="CopyButton" Content="Copy the image" Click="Copy_Click" />
                        <TextBlock Style="{StaticResource Lede}" Margin="0,8,0,0"
                                   Text="PNG goes through BluePrint.Barcode.Render and SkiaSharp. SVG comes from the encoder alone, with no graphics library involved at all." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== all symbologies =========================================== -->
        <ScrollViewer Grid.Row="1" x:Name="GalleryPage" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" Padding="24,20">
            <ItemsControl x:Name="GalleryList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="286" Margin="0,0,16,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Shape}" Style="{StaticResource Lede}"
                                           FontSize="11.5" Margin="0,1,0,10" />
                                <Border Background="White" CornerRadius="6" Padding="12"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <local:BarcodeView Height="120" HriFontSize="13"
                                                       Symbol="{Binding Symbol}"
                                                       ShowHri="{Binding ShowHri}"
                                                       MessageBrush="{StaticResource Danger}" />
                                </Border>
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Lede}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== status ==================================================== -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,8">
            <DockPanel>
                <TextBlock x:Name="StatusDetail" DockPanel.Dock="Right"
                           Style="{StaticResource Code}" TextWrapping="NoWrap" />
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" Margin="0,0,24,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
